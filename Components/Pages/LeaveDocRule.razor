@code {
    private string viewMode = "auto";
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isDeleting = false;
    private string? statusMessage;
    private bool isSuccess = true;

    private List<LeaveDocRuleRow> rulesList = new();
    private HashSet<int> selectedRuleIds = new();

    // Filters matching legacy Image 3
    private string filterRuleId = string.Empty;
    private string filterCondition = string.Empty;

    // Add / Edit Modal state
    private bool showEditModal = false;
    private bool isAddMode = false;
    private LeaveDocRuleRow? currentEditRule;
    private int? originalRuleId;
    private string? modalErrorMessage;

    // Delete confirmation
    private bool showDeleteConfirmModal = false;

    // Test Evaluator state
    private bool showTestModal = false;
    private string testLeaveCode = "ML";
    private int testNoChild = 6;
    private int testApplyDate = 1;
    private decimal testTotalLeaveApply = 1;
    private string testWeekday = "Sunday";
    private string testJobId = "SUPERVISOR";
    private string testStatus = "P";
    private decimal testBalance = 0;
    private List<LeaveDocRuleRow> testResults = new();

    private IEnumerable<LeaveDocRuleRow> FilteredRules
    {
        get
        {
            var query = rulesList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filterRuleId))
            {
                var q = filterRuleId.Trim();
                query = query.Where(r => r.RuleID.ToString().Contains(q));
            }

            if (!string.IsNullOrWhiteSpace(filterCondition))
            {
                var q = filterCondition.Trim().ToLower();
                query = query.Where(r => 
                    (r.Condition?.ToLower().Contains(q) ?? false) ||
                    (r.Explain?.ToLower().Contains(q) ?? false) ||
                    (r.RouteID?.ToLower().Contains(q) ?? false)
                );
            }

            return query;
        }
    }

    private bool IsAllSelected
    {
        get
        {
            var visible = FilteredRules.Select(r => r.RuleID).ToList();
            return visible.Any() && visible.All(id => selectedRuleIds.Contains(id));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            rulesList = await ApiClient.GetLeaveDocRulesAsync("LEAVE");
            selectedRuleIds.Clear();
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to load rules: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool select = (bool)e.Value!;
        var visibleIds = FilteredRules.Select(r => r.RuleID).ToList();
        if (select)
        {
            foreach (var id in visibleIds)
            {
                selectedRuleIds.Add(id);
            }
        }
        else
        {
            foreach (var id in visibleIds)
            {
                selectedRuleIds.Remove(id);
            }
        }
    }

    private void ToggleRuleSelection(int ruleId, bool isSelected)
    {
        if (isSelected)
        {
            selectedRuleIds.Add(ruleId);
        }
        else
        {
            selectedRuleIds.Remove(ruleId);
        }
    }

    private void OpenAddModal()
    {
        isAddMode = true;
        modalErrorMessage = null;
        int nextId = (rulesList.Any() ? rulesList.Max(r => r.RuleID) : 0) + 1;

        currentEditRule = new LeaveDocRuleRow
        {
            RuleID = nextId,
            Condition = "",
            Action = "N",
            RouteID = "",
            GroupID = "LEAVE",
            Explain = "",
            ApprovalAllow = null
        };
        originalRuleId = null;
        showEditModal = true;
    }

    private void OpenEditModal(LeaveDocRuleRow row)
    {
        isAddMode = false;
        modalErrorMessage = null;
        originalRuleId = row.RuleID;

        currentEditRule = new LeaveDocRuleRow
        {
            RuleID = row.RuleID,
            Condition = row.Condition,
            Action = row.Action,
            RouteID = row.RouteID,
            GroupID = row.GroupID,
            Explain = row.Explain,
            ApprovalAllow = row.ApprovalAllow
        };
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        currentEditRule = null;
        modalErrorMessage = null;
    }

    private void AppendVariable(string varName)
    {
        if (currentEditRule == null) return;
        if (string.IsNullOrWhiteSpace(currentEditRule.Condition))
        {
            currentEditRule.Condition = varName;
        }
        else
        {
            currentEditRule.Condition += $" and {varName}";
        }
    }

    private void AddRouteToken(string token)
    {
        if (currentEditRule == null) return;
        var cur = currentEditRule.RouteID?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(cur))
        {
            currentEditRule.RouteID = $"{token},";
        }
        else if (!cur.Contains(token, StringComparison.OrdinalIgnoreCase))
        {
            if (!cur.EndsWith(",")) cur += ", ";
            else cur += " ";
            currentEditRule.RouteID = $"{cur}{token},";
        }
    }

    private async Task SaveRuleAsync()
    {
        if (currentEditRule == null) return;

        if (currentEditRule.RuleID <= 0)
        {
            modalErrorMessage = "Rule ID must be a positive integer.";
            return;
        }

        if (string.IsNullOrWhiteSpace(currentEditRule.Condition))
        {
            modalErrorMessage = "Condition expression cannot be empty.";
            return;
        }

        isSaving = true;
        modalErrorMessage = null;

        try
        {
            var req = new SaveLeaveDocRuleRequest
            {
                RuleID = currentEditRule.RuleID,
                Condition = currentEditRule.Condition,
                Action = currentEditRule.Action,
                RouteID = currentEditRule.RouteID,
                GroupID = "LEAVE",
                Explain = currentEditRule.Explain,
                ApprovalAllow = currentEditRule.ApprovalAllow,
                IsNew = isAddMode,
                OriginalRuleID = originalRuleId
            };

            var res = await ApiClient.SaveLeaveDocRuleAsync(req);
            if (res.Success)
            {
                statusMessage = res.Message;
                isSuccess = true;
                CloseEditModal();
                await LoadDataAsync();
            }
            else
            {
                modalErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            modalErrorMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDeleteSelected()
    {
        if (!selectedRuleIds.Any()) return;
        showDeleteConfirmModal = true;
    }

    private async Task ExecuteDeleteSelectedAsync()
    {
        if (!selectedRuleIds.Any()) return;
        isDeleting = true;

        try
        {
            var req = new DeleteLeaveDocRulesRequest
            {
                RuleIDs = selectedRuleIds.ToList(),
                GroupID = "LEAVE"
            };

            var res = await ApiClient.DeleteLeaveDocRulesAsync(req);
            if (res.Success)
            {
                statusMessage = res.Message;
                isSuccess = true;
                showDeleteConfirmModal = false;
                await LoadDataAsync();
            }
            else
            {
                statusMessage = res.Message;
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Delete failed: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void OpenTestModal()
    {
        testResults.Clear();
        RunRuleTest();
        showTestModal = true;
    }

    private void RunRuleTest()
    {
        testResults.Clear();

        foreach (var rule in rulesList)
        {
            var cond = rule.Condition?.ToLower() ?? "";
            bool match = false;

            // Simplified evaluator for common rules
            if (cond.Contains("no_child>'5'") && testNoChild > 5 && cond.Contains($"leavecode ='{testLeaveCode.ToLower()}'"))
                match = true;
            else if (cond.Contains("job_id ='supervisor'") && testJobId.Equals("SUPERVISOR", StringComparison.OrdinalIgnoreCase) && cond.Contains($"leavecode='{testLeaveCode.ToLower()}'"))
                match = true;
            else if (cond.Contains("status='p'") && testStatus.Equals("P", StringComparison.OrdinalIgnoreCase) && cond.Contains($"leavecode='{testLeaveCode.ToLower()}'"))
                match = true;
            else if (cond.Contains("applydate < 3") && testApplyDate < 3 && cond.Contains($"leavecode= '{testLeaveCode.ToLower()}'"))
                match = true;
            else if (cond.Contains($"weekday ='{testWeekday.ToLower()}'") && cond.Contains($"leavecode = '{testLeaveCode.ToLower()}'"))
                match = true;
            else if (cond.Contains("balancetotalleavecode <= 0") && testBalance <= 0 && cond.Contains($"leavecode = '{testLeaveCode.ToLower()}'"))
                match = true;
            else if (cond.Contains("totalleaveapply >=") && cond.Contains($"leavecode = '{testLeaveCode.ToLower()}'"))
                match = true;

            if (match)
            {
                testResults.Add(rule);
            }
        }
    }
}
