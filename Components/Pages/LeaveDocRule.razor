@page "/leaves/doc-rule"
@page "/leaves/rule-doc"
@page "/eLeave/eLeaveRuleDoc.aspx"
@page "/eleaveruledoc"
@rendermode InteractiveServer
@inject HrApiClient ApiClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Leave Document Rule - HRsuite</PageTitle>

<div class="ruledoc-container pb-5">
    <!-- Top Header Bar with Standardized Action Buttons -->
    <div class="page-top-bar d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-link text-dark p-0 text-decoration-none fs-5 d-inline-flex align-items-center back-arrow-btn" 
                    @onclick='() => NavManager.NavigateTo("leaves")' title="Back to Leave Portal">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h5 class="mb-0 fw-bold d-flex align-items-center gap-2 text-dark">
                <span class="rule-icon-badge" style="width: 32px; height: 32px; font-size: 1.1rem;">
                    <i class="bi bi-shield-check"></i>
                </span>
                <span>Leave Document Rule</span>
            </h5>
            <span class="badge bg-secondary-subtle text-secondary border px-2 py-0.5 rounded-pill extra-small ms-1">
                Total: @FilteredRules.Count() rules
            </span>
        </div>

        <!-- Standardized Page Action Buttons -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-success btn-sm extra-small px-3 fw-semibold shadow-sm d-inline-flex align-items-center gap-1"
                    @onclick="OpenAddModal" title="Add New Rule">
                <i class="bi bi-plus-lg"></i>
                <span>Add</span>
            </button>
            <button type="button" class="btn btn-danger btn-sm extra-small px-3 fw-semibold shadow-sm d-inline-flex align-items-center gap-1"
                    @onclick="ConfirmDeleteSelected" disabled="@(!selectedRuleIds.Any() || isDeleting)" title="Delete Selected Rule(s)">
                <i class="bi bi-trash"></i>
                <span>Delete @(selectedRuleIds.Any() ? $"({selectedRuleIds.Count})" : "")</span>
            </button>
            <button type="button" class="btn btn-primary btn-sm extra-small px-3 fw-semibold shadow-sm d-inline-flex align-items-center gap-1"
                    @onclick="OpenTestModal" title="Test Rule Evaluator">
                <i class="bi bi-lightning-charge"></i>
                <span>Test</span>
            </button>
            <!-- 3-Mode View Switcher -->
            <div class="btn-group btn-group-sm shadow-sm" role="group">
                <button type="button" class="btn btn-sm @(viewMode == "auto" ? "btn-primary text-white" : "btn-outline-primary") py-1 px-2" style="height: 28px;" @onclick='() => viewMode = "auto"' title="Adaptive Auto (Phone = Cards, Desktop = Table)">
                    <i class="bi bi-phone"></i>
                </button>
                <button type="button" class="btn btn-sm @(viewMode == "table" ? "btn-primary text-white" : "btn-outline-primary") py-1 px-2" style="height: 28px;" @onclick='() => viewMode = "table"' title="Grid Table View">
                    <i class="bi bi-table"></i>
                </button>
                <button type="button" class="btn btn-sm @(viewMode == "cards" ? "btn-primary text-white" : "btn-outline-primary") py-1 px-2" style="height: 28px;" @onclick='() => viewMode = "cards"' title="Cards View">
                    <i class="bi bi-grid-fill"></i>
                </button>
            </div>

            <button type="button" class="btn btn-outline-secondary btn-sm extra-small px-3 d-inline-flex align-items-center gap-1 shadow-sm" 
                    @onclick="LoadDataAsync" disabled="@isLoading" title="Refresh List" style="height: 28px;">
                <i class="bi bi-arrow-clockwise @(isLoading ? "spin" : "")"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 px-3 extra-small mb-3 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi @(isSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-6"></i>
                <div>@statusMessage</div>
            </div>
            <button type="button" class="btn-close py-2 extra-small" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Main Card Box -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
        <!-- Table Container -->
        @if (viewMode == "table" || viewMode == "auto")
        {
            <div class="@(viewMode == "auto" ? "d-none d-md-block" : "")">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 custom-rules-table">
                        <thead>
                            <tr class="table-light-header">
                                <th style="width: 45px;" class="text-center">#</th>
                                <th style="width: 105px;" class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <span>Action</span>
                                        <input type="checkbox" class="form-check-input mt-0 cursor-pointer" 
                                               title="Select / Deselect All"
                                               checked="@IsAllSelected" 
                                               @onchange="ToggleSelectAll" />
                                    </div>
                                </th>
                                <th style="width: 90px;">
                                    <div class="d-flex flex-column gap-1">
                                        <span>Rule ID</span>
                                        <input type="text" class="form-control form-control-sm table-filter-input" 
                                               placeholder="Filter..." 
                                               @bind="filterRuleId" 
                                               @bind:event="oninput" />
                                    </div>
                                </th>
                                <th style="min-width: 280px;">
                                    <div class="d-flex flex-column gap-1">
                                        <span>Condition</span>
                                        <input type="text" class="form-control form-control-sm table-filter-input" 
                                               placeholder="Filter condition..." 
                                               @bind="filterCondition" 
                                               @bind:event="oninput" />
                                    </div>
                                </th>
                                <th style="width: 75px;" class="text-center">Action</th>
                                <th style="min-width: 250px;">explain</th>
                                <th style="min-width: 220px;">Route ID</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                        <span class="text-muted extra-small">Loading leave document rules...</span>
                                    </td>
                                </tr>
                            }
                            else if (!FilteredRules.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted extra-small">
                                        <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                                        No leave document rules found matching your criteria.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int seq = 1;
                                foreach (var rule in FilteredRules)
                                {
                                    var isSelected = selectedRuleIds.Contains(rule.RuleID);
                                    <tr class="@(isSelected ? "row-selected" : "")">
                                        <!-- # Sequence -->
                                        <td class="text-center text-muted extra-small fw-semibold">
                                            @seq
                                        </td>

                                        <!-- Edit & Checkbox -->
                                        <td class="text-center">
                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                <button type="button" class="btn btn-outline-primary btn-sm py-0.5 px-2 extra-small fw-semibold d-inline-flex align-items-center gap-1"
                                                        @onclick="() => OpenEditModal(rule)">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Edit</span>
                                                </button>
                                                <input type="checkbox" class="form-check-input mt-0 cursor-pointer"
                                                       checked="@isSelected"
                                                       @onchange="(e) => ToggleRuleSelection(rule.RuleID, (bool)e.Value!)" />
                                            </div>
                                        </td>

                                        <!-- Rule ID -->
                                        <td class="fw-bold extra-small text-dark">
                                            <span class="badge bg-light text-dark border">@rule.RuleID</span>
                                        </td>

                                        <!-- Condition -->
                                        <td>
                                            <code class="condition-code">@rule.Condition</code>
                                        </td>

                                        <!-- Action (Y / N) -->
                                        <td class="text-center">
                                            @if (rule.Action == "Y")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success extra-small px-2 py-0.5">Y</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger extra-small px-2 py-0.5">N</span>
                                            }
                                        </td>

                                        <!-- explain -->
                                        <td class="extra-small text-dark">
                                            @if (!string.IsNullOrWhiteSpace(rule.Explain))
                                            {
                                                <span>@rule.Explain</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">-- none --</span>
                                            }
                                        </td>

                                        <!-- Route ID -->
                                        <td class="extra-small">
                                            @if (!string.IsNullOrWhiteSpace(rule.RouteID))
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var r in rule.RouteID.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                    {
                                                        <span class="badge bg-light text-secondary border extra-small font-monospace">@r</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">-- All / None --</span>
                                            }
                                        </td>
                                    </tr>
                                    seq++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Mobile Cards Container -->
        @if (viewMode == "cards" || viewMode == "auto")
        {
            <div class="@(viewMode == "auto" ? "d-block d-md-none" : "") p-2">
                @if (isLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        <span class="text-muted extra-small">Loading leave document rules...</span>
                    </div>
                }
                else if (!FilteredRules.Any())
                {
                    <div class="text-center py-4 text-muted extra-small">
                        <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                        No leave document rules found matching your criteria.
                    </div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var rule in FilteredRules)
                        {
                            var isSelected = selectedRuleIds.Contains(rule.RuleID);
                            <div class="col-12 col-sm-6">
                                <div class="card border rounded-3 p-3 shadow-sm item-card-item bg-white @(isSelected ? "border-primary" : "")">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="checkbox" class="form-check-input mt-0 cursor-pointer"
                                                   checked="@isSelected"
                                                   @onchange="(e) => ToggleRuleSelection(rule.RuleID, (bool)e.Value!)" />
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">
                                                Rule @rule.RuleID
                                            </span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (rule.Action == "Y")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success extra-small">Action: Y (Allow)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger extra-small">Action: N (Block)</span>
                                            }
                                            <button type="button" class="btn btn-outline-primary btn-sm py-0.5 px-2 extra-small fw-semibold"
                                                    @onclick="() => OpenEditModal(rule)">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </button>
                                        </div>
                                    </div>
                                    <div class="extra-small mb-1">
                                        <strong class="text-muted d-block">Condition:</strong>
                                        <code class="condition-code d-block mt-0.5 text-wrap">@rule.Condition</code>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(rule.Explain))
                                    {
                                        <div class="extra-small text-muted mb-1">
                                            <i class="bi bi-chat-left-text me-1"></i>@rule.Explain
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(rule.RouteID))
                                    {
                                        <div class="extra-small mt-1 d-flex align-items-center gap-1 flex-wrap">
                                            <span class="text-muted">Route:</span>
                                            @foreach (var r in rule.RouteID.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            {
                                                <span class="badge bg-light text-secondary border extra-small font-monospace">@r</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- Card Footer -->
        <div class="card-footer bg-light border-top py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span class="extra-small text-muted">
                Showing @FilteredRules.Count() of @rulesList.Count rules.
            </span>
            <div class="d-flex align-items-center gap-2 extra-small text-muted">
                <i class="bi bi-info-circle text-primary"></i>
                <span>Action: <strong>N</strong> = Disallow / Block application; <strong>Y</strong> = Allow under configured Route.</span>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- ADD / EDIT MODAL                                               -->
<!-- ============================================================== -->
@if (showEditModal && currentEditRule != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.55); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
                <!-- Modal Header -->
                <div class="modal-header py-2.5 px-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @(isAddMode ? "bi-plus-circle-fill text-success" : "bi-pencil-square text-primary") fs-5"></i>
                        <h6 class="mb-0 fw-bold text-dark">
                            @(isAddMode ? "Add Leave Document Rule" : $"Edit Leave Document Rule (Rule ID: #{currentEditRule.RuleID})")
                        </h6>
                    </div>
                    <button type="button" class="btn-close extra-small" @onclick="CloseEditModal" disabled="@isSaving"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-3">
                    @if (!string.IsNullOrEmpty(modalErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 extra-small mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>@modalErrorMessage</div>
                        </div>
                    }

                    <div class="row g-3">
                        <!-- Rule ID -->
                        <div class="col-12 col-md-4">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">
                                Rule ID <span class="text-danger">*</span>:
                            </label>
                            <input type="number" class="form-control form-control-sm" 
                                   @bind="currentEditRule.RuleID" 
                                   min="1" />
                            <div class="form-text extra-small text-muted">Unique integer ID for this rule.</div>
                        </div>

                        <!-- Action (Y / N) -->
                        <div class="col-12 col-md-4">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">
                                Action <span class="text-danger">*</span>:
                            </label>
                            <select class="form-select form-select-sm" @bind="currentEditRule.Action">
                                <option value="N">N - Disallow / Block Leave</option>
                                <option value="Y">Y - Allow / Special Route</option>
                            </select>
                            <div class="form-text extra-small text-muted">Rule enforcement outcome.</div>
                        </div>

                        <!-- Approval Allow -->
                        <div class="col-12 col-md-4">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">
                                Approval Allow:
                            </label>
                            <select class="form-select form-select-sm" @bind="currentEditRule.ApprovalAllow">
                                <option value="">-- None / Standard --</option>
                                <option value="Y">Y - Allow In Approval</option>
                                <option value="N">N - Disallow In Approval</option>
                            </select>
                            <div class="form-text extra-small text-muted">Allow supervisor bypass.</div>
                        </div>

                        <!-- Condition -->
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="form-label extra-small fw-semibold text-dark mb-0">
                                    Condition Expression <span class="text-danger">*</span>:
                                </label>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Insert Variable
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm extra-small">
                                        <li><a class="dropdown-item cursor-pointer" @onclick='() => AppendVariable("LeaveCode")'>LeaveCode (e.g. 'AL')</a></li>
                                        <li><a class="dropdown-item cursor-pointer" @onclick='() => AppendVariable("ApplyDate")'>ApplyDate (&lt; 3)</a></li>
                                        <li><a class="dropdown-item cursor-pointer" @onclick='() => AppendVariable("TotalLeaveApply")'>TotalLeaveApply (&gt; 5)</a></li>
                                        <li><a class="dropdown-item cursor-pointer" @onclick='() => AppendVariable("No_Child")'>No_Child (&gt; 5)</a></li>
                                        <li><a class="dropdown-item cursor-pointer" @onclick='() => AppendVariable("weekday")'>weekday (= 'Sunday')</a></li>
                                        <li><a class="dropdown-item cursor-pointer" @onclick='() => AppendVariable("Status")'>Status (= 'P')</a></li>
                                        <li><a class="dropdown-item cursor-pointer" @onclick='() => AppendVariable("JOB_ID")'>JOB_ID (= 'SUPERVISOR')</a></li>
                                        <li><a class="dropdown-item cursor-pointer" @onclick='() => AppendVariable("BalanceTotalLeaveCode")'>BalanceTotalLeaveCode</a></li>
                                        <li><a class="dropdown-item cursor-pointer" @onclick='() => AppendVariable("SameDayLeaveCount")'>SameDayLeaveCount</a></li>
                                    </ul>
                                </div>
                            </div>
                            <textarea class="form-control form-control-sm font-monospace" rows="3"
                                      @bind="currentEditRule.Condition"
                                      placeholder="e.g. LeaveCode = 'ML' and No_Child > '5'"></textarea>
                            <div class="form-text extra-small text-muted">
                                Logical condition that will trigger this rule during leave submission.
                            </div>
                        </div>

                        <!-- explain -->
                        <div class="col-12">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">
                                Explanation (explain) Message:
                            </label>
                            <textarea class="form-control form-control-sm" rows="2"
                                      @bind="currentEditRule.Explain"
                                      placeholder="e.g. Leave Code 'ML' not allow more than 5 child"></textarea>
                            <div class="form-text extra-small text-muted">
                                Text prompt shown to applicant when the rule condition is matched.
                            </div>
                        </div>

                        <!-- Route ID -->
                        <div class="col-12">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">
                                Route ID:
                            </label>
                            <input type="text" class="form-control form-control-sm font-monospace"
                                   @bind="currentEditRule.RouteID"
                                   placeholder="e.g. LV ADMIN, LV APPROVAL, LV GRP APPLY, LV IDV APPLY," />
                            <div class="d-flex flex-wrap gap-1 mt-1.5 align-items-center">
                                <span class="extra-small text-muted me-1">Quick Add Route:</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1.5 extra-small" @onclick='() => AddRouteToken("Admin")'>+ Admin</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1.5 extra-small" @onclick='() => AddRouteToken("LV ADMIN")'>+ LV ADMIN</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1.5 extra-small" @onclick='() => AddRouteToken("LV APPROVAL")'>+ LV APPROVAL</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1.5 extra-small" @onclick='() => AddRouteToken("LV GRP APPLY")'>+ LV GRP APPLY</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1.5 extra-small" @onclick='() => AddRouteToken("LV IDV APPLY")'>+ LV IDV APPLY</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1.5 extra-small" @onclick='() => AddRouteToken("Supervisor")'>+ Supervisor</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1.5 extra-small" @onclick='() => AddRouteToken("super admin")'>+ super admin</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer py-2 px-3 bg-light border-top d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm extra-small px-3"
                            @onclick="CloseEditModal" disabled="@isSaving">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary btn-sm extra-small px-4 fw-semibold d-inline-flex align-items-center gap-1"
                            @onclick="SaveRuleAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span>@(isAddMode ? "Create Rule" : "Update Rule")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================== -->
<!-- DELETE CONFIRMATION MODAL                                      -->
<!-- ============================================================== -->
@if (showDeleteConfirmModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.55); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="modal-header py-2 px-3 bg-danger text-white d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <h6 class="mb-0 fw-bold">Confirm Delete</h6>
                    </div>
                    <button type="button" class="btn-close btn-close-white extra-small" @onclick="() => showDeleteConfirmModal = false"></button>
                </div>
                <div class="modal-body p-3 text-center">
                    <p class="mb-2 extra-small text-dark">
                        Are you sure you want to permanently delete the <strong>@selectedRuleIds.Count</strong> selected rule(s)?
                    </p>
                    <div class="p-2 bg-light rounded border text-muted extra-small font-monospace">
                        Rule IDs: @string.Join(", ", selectedRuleIds)
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light border-top d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm extra-small px-3"
                            @onclick="() => showDeleteConfirmModal = false" disabled="@isDeleting">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger btn-sm extra-small px-3 fw-semibold"
                            @onclick="ExecuteDeleteSelectedAsync" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span>Yes, Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================== -->
<!-- TEST RULE MODAL                                                -->
<!-- ============================================================== -->
@if (showTestModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.55); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="modal-header py-2.5 px-3 bg-primary text-white d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <h6 class="mb-0 fw-bold">Test Leave Document Rules Evaluator</h6>
                    </div>
                    <button type="button" class="btn-close btn-close-white extra-small" @onclick="() => showTestModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="extra-small text-muted mb-3">
                        Enter sample parameters below to simulate leave rule validation and inspect matching rule conditions.
                    </p>

                    <div class="row g-2 mb-3">
                        <div class="col-6 col-md-3">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">LeaveCode:</label>
                            <input type="text" class="form-control form-control-sm" @bind="testLeaveCode" placeholder="e.g. ML, AL, EL" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">No_Child:</label>
                            <input type="number" class="form-control form-control-sm" @bind="testNoChild" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">ApplyDate (days):</label>
                            <input type="number" class="form-control form-control-sm" @bind="testApplyDate" placeholder="e.g. 0, 2, -2" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">TotalLeaveApply:</label>
                            <input type="number" class="form-control form-control-sm" @bind="testTotalLeaveApply" step="0.5" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">Weekday:</label>
                            <select class="form-select form-select-sm" @bind="testWeekday">
                                <option value="Monday">Monday</option>
                                <option value="Tuesday">Tuesday</option>
                                <option value="Wednesday">Wednesday</option>
                                <option value="Thursday">Thursday</option>
                                <option value="Friday">Friday</option>
                                <option value="Saturday">Saturday</option>
                                <option value="Sunday">Sunday</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">JOB_ID:</label>
                            <input type="text" class="form-control form-control-sm" @bind="testJobId" placeholder="e.g. SUPERVISOR" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">Status:</label>
                            <input type="text" class="form-control form-control-sm" @bind="testStatus" placeholder="e.g. P (Probation)" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label extra-small fw-semibold text-dark mb-1">Balance AL:</label>
                            <input type="number" class="form-control form-control-sm" @bind="testBalance" step="0.5" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-primary btn-sm extra-small px-3 fw-semibold d-inline-flex align-items-center gap-1"
                                @onclick="RunRuleTest">
                            <i class="bi bi-play-fill"></i>
                            <span>Evaluate Active Rules</span>
                        </button>
                    </div>

                    <!-- Test Output -->
                    <div class="border rounded-2 p-2.5 bg-light">
                        <h6 class="extra-small fw-bold text-dark mb-2 d-flex align-items-center gap-1.5">
                            <i class="bi bi-check2-circle text-success"></i>
                            <span>Evaluation Results (@testResults.Count matched):</span>
                        </h6>
                        @if (!testResults.Any())
                        {
                            <div class="text-muted extra-small fst-italic">
                                No rules matched or triggered with the provided parameters. (Leave submission allowed)
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var r in testResults)
                                {
                                    <div class="p-2 rounded border bg-white d-flex align-items-start gap-2">
                                        <span class="badge @(r.Action == "N" ? "bg-danger" : "bg-warning text-dark") extra-small">
                                            Rule #@r.RuleID [@r.Action]
                                        </span>
                                        <div class="extra-small">
                                            <div class="fw-semibold text-dark">@r.Explain</div>
                                            <code class="text-muted" style="font-size: 0.72rem;">@r.Condition</code>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm extra-small px-3" @onclick="() => showTestModal = false">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

