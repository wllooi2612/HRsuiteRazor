@code {
    private List<LeaveApprovalLevelRow> rowsList = new();
    private List<EmployeeLookupModel> usersList = new();
    private string searchText = string.Empty;
    private bool isLoading = false;
    private bool isSaving = false;
    private string? statusMessage;
    private bool isSuccess = true;

    // Modal Edit State
    private bool isEditModalOpen = false;
    private UpdateLeaveApprovalLevelRequest? editModel;
    private string editingUserName = string.Empty;
    private string? modalErrorMessage;

    private IEnumerable<LeaveApprovalLevelRow> FilteredRows
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
            {
                return rowsList;
            }

            var q = searchText.Trim();
            return rowsList.Where(x =>
                (x.ID?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.App1?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.AppName1?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.App2?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.AppName2?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.App1_Individual?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.AppName1_Individual?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.App2_Individual?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.AppName2_Individual?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
        await LoadDataAsync();
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            usersList = await ApiClient.GetLeaveAccessUsersAsync();
        }
        catch (Exception ex)
        {
            statusMessage = "Failed to load user list: " + ex.Message;
            isSuccess = false;
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            rowsList = await ApiClient.GetLeaveApprovalLevelsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = "Error loading leave approval level records: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEditModal(LeaveApprovalLevelRow row)
    {
        editingUserName = row.Name;
        modalErrorMessage = null;
        editModel = new UpdateLeaveApprovalLevelRequest
        {
            ID = row.ID,
            App1 = row.App1,
            App2 = row.App2,
            App3 = row.App3,
            App4 = row.App4,
            AppLevel = row.AppLevel,

            SuperAdminLeave = row.SuperAdminLeave,
            LeaveRemindFollowGeneral = row.LeaveRemindFollowGeneral,
            LeaveEmailRemind = row.LeaveEmailRemind,
            LeaveRemindTimeIndividual = string.IsNullOrWhiteSpace(row.LeaveRemindTimeIndividual) ? "00:00:00" : row.LeaveRemindTimeIndividual,

            UseIndividual = row.UseIndividual,
            App1_Individual = row.App1_Individual,
            App2_Individual = row.App2_Individual,
            App3_Individual = row.App3_Individual,
            App4_Individual = row.App4_Individual,
            AppLevel_Individual = row.AppLevel_Individual
        };
        isEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        isEditModalOpen = false;
        editModel = null;
        modalErrorMessage = null;
    }

    private void OnRemindGeneralToggled(ChangeEventArgs e)
    {
        bool isChecked = (bool)e.Value!;
        if (editModel != null)
        {
            editModel.LeaveRemindFollowGeneral = isChecked ? "Y" : "N";
            if (isChecked)
            {
                editModel.LeaveEmailRemind = "N";
            }
        }
    }

    private void OnRemindUserToggled(ChangeEventArgs e)
    {
        bool isChecked = (bool)e.Value!;
        if (editModel != null)
        {
            editModel.LeaveEmailRemind = isChecked ? "Y" : "N";
            if (isChecked)
            {
                editModel.LeaveRemindFollowGeneral = "N";
            }
        }
    }

    private async Task SaveEditModalAsync()
    {
        if (editModel == null) return;

        // Validation matching eLeaveApprovalLevel.aspx.vb
        modalErrorMessage = null;

        // 1. Group level duplicate checks
        var groupApps = new[] { editModel.App1, editModel.App2, editModel.App3, editModel.App4 }
            .Where(x => !string.IsNullOrEmpty(x)).ToList();
        if (groupApps.Count != groupApps.Distinct().Count())
        {
            modalErrorMessage = "Validation Error: Group Approvers must not contain the same person multiple times.";
            return;
        }

        // 2. Individual level duplicate checks
        if (editModel.UseIndividual == "Y")
        {
            var indApps = new[] { editModel.App1_Individual, editModel.App2_Individual, editModel.App3_Individual, editModel.App4_Individual }
                .Where(x => !string.IsNullOrEmpty(x)).ToList();
            if (indApps.Count != indApps.Distinct().Count())
            {
                modalErrorMessage = "Validation Error: Individual Approvers must not contain the same person multiple times.";
                return;
            }
        }

        // 3. Email Remind conflict check
        if (editModel.LeaveRemindFollowGeneral == "Y" && editModel.LeaveEmailRemind == "Y")
        {
            modalErrorMessage = "Validation Error: Only choose either 'Follow General Setting' or 'Follow Individual Setting'.";
            return;
        }

        isSaving = true;
        try
        {
            var (ok, msg) = await ApiClient.SaveLeaveApprovalLevelAsync(editModel);
            if (ok)
            {
                isSuccess = true;
                statusMessage = $"Approval level configuration for user '{editModel.ID}' saved successfully.";
                CloseEditModal();
                await LoadDataAsync();
            }
            else
            {
                modalErrorMessage = msg;
            }
        }
        catch (Exception ex)
        {
            modalErrorMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
