@page "/leaves/create-user-access"
@page "/leaves/user-access"
@page "/eleavecreateuseraccess"
@page "/eLeave/eLeaveCreateUserAccess.aspx"
@rendermode InteractiveServer
@inject HrApiClient ApiClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Create User Access - HRsuite</PageTitle>

<div class="user-access-container pb-5">
    <!-- Top Header Bar -->
    <div class="page-top-bar d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-link text-dark p-0 text-decoration-none fs-5 d-inline-flex align-items-center back-arrow-btn" 
                    @onclick='() => NavManager.NavigateTo("leaves")' title="Back to Leave Portal">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h5 class="mb-0 fw-bold d-flex align-items-center gap-2 text-dark">
                <span class="access-icon-badge" style="width: 32px; height: 32px; font-size: 1.1rem;">
                    <i class="bi bi-person-gear"></i>
                </span>
                <span>User Access Control for Leave</span>
            </h5>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary py-1 px-3 extra-small d-flex align-items-center gap-1" 
                    @onclick="RefreshUserAccessAsync" disabled="@isLoading" title="Refresh Access Data">
                <i class="bi bi-arrow-clockwise @(isLoading ? "spin" : "")"></i>
                <span>Refresh</span>
            </button>
            <button class="btn btn-sm btn-primary py-1 px-3 extra-small d-flex align-items-center gap-1 shadow-sm" 
                    @onclick="SaveUserAccessAsync" disabled="@(isLoading || isSaving || string.IsNullOrEmpty(selectedUserId))" title="Save Permissions">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-floppy-fill me-1"></i>
                    <span>Save Changes</span>
                }
            </button>
        </div>
    </div>

    <!-- Status Alert Notification -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center gap-2 mb-3 shadow-sm py-2 px-3 rounded-3" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5"></i>
            <div class="flex-grow-1 extra-small">@statusMessage</div>
            <button type="button" class="btn-close" @onclick='() => statusMessage = null'></button>
        </div>
    }

    <!-- Fieldset 1: Select User for LEAVE -->
    <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
        <div class="card-header bg-light py-2 px-3 border-0 rounded-top-3 d-flex align-items-center justify-content-between">
            <span class="fw-bold extra-small text-secondary text-uppercase tracking-wider">
                <i class="bi bi-person-bounding-box me-1 text-primary"></i> Select User for LEAVE
            </span>
            @if (!string.IsNullOrEmpty(selectedUserId))
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle extra-small">
                    User: @selectedUserId
                </span>
            }
        </div>
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <label class="form-label extra-small fw-semibold text-muted mb-1">Select User ID / Name</label>
                    <select class="form-select form-select-sm" value="@selectedUserId" @onchange="OnUserChangedAsync" disabled="@isLoading">
                        <option value="">-- Choose User --</option>
                        @foreach (var u in usersList)
                        {
                            <option value="@u.EmpId">@u.EmpId - @u.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label extra-small fw-semibold text-muted mb-1">Current User ID</label>
                    <input class="form-control form-control-sm bg-light" readonly value="@selectedUserId" placeholder="No user selected" />
                </div>
                <div class="col-12 col-md-3 d-flex align-items-end">
                    <div class="summary-pill w-100 p-2 bg-light rounded-2 border d-flex align-items-center justify-content-between">
                        <span class="extra-small text-muted">Total Granted:</span>
                        <span class="badge bg-success rounded-pill">@TotalSelectedCount</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fieldset 2: User Access Group for LEAVE (Tabs & Grid) -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-header bg-white border-bottom p-0 rounded-top-3">
            <!-- Scrollable Tab Bar -->
            <ul class="nav nav-tabs border-0 flex-nowrap overflow-x-auto px-2 pt-2 custom-nav-tabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "dept" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("dept")'>
                        Department <span class="badge @(GetSelectedCount(accessData.Departments) > 0 ? "bg-primary" : "bg-light text-muted border") ms-1">@GetSelectedCount(accessData.Departments)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "sec" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("sec")'>
                        Section <span class="badge @(GetSelectedCount(accessData.Sections) > 0 ? "bg-primary" : "bg-light text-muted border") ms-1">@GetSelectedCount(accessData.Sections)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "cat" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("cat")'>
                        Category <span class="badge @(GetSelectedCount(accessData.Categories) > 0 ? "bg-primary" : "bg-light text-muted border") ms-1">@GetSelectedCount(accessData.Categories)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "grade" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("grade")'>
                        Grade <span class="badge @(GetSelectedCount(accessData.Grades) > 0 ? "bg-primary" : "bg-light text-muted border") ms-1">@GetSelectedCount(accessData.Grades)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "sup" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("sup")'>
                        Supervisor <span class="badge @(GetSelectedCount(accessData.Supervisors) > 0 ? "bg-primary" : "bg-light text-muted border") ms-1">@GetSelectedCount(accessData.Supervisors)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "job" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("job")'>
                        Job Title <span class="badge @(GetSelectedCount(accessData.JobTitles) > 0 ? "bg-primary" : "bg-light text-muted border") ms-1">@GetSelectedCount(accessData.JobTitles)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "factory" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("factory")'>
                        Factory <span class="badge @(GetSelectedCount(accessData.Factories) > 0 ? "bg-primary" : "bg-light text-muted border") ms-1">@GetSelectedCount(accessData.Factories)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "grp" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("grp")'>
                        Group <span class="badge @(GetSelectedCount(accessData.Groups) > 0 ? "bg-primary" : "bg-light text-muted border") ms-1">@GetSelectedCount(accessData.Groups)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "email" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("email")'>
                        Email <span class="badge @(GetSelectedCount(accessData.Emails) > 0 ? "bg-primary" : "bg-light text-muted border") ms-1">@GetSelectedCount(accessData.Emails)</span>
                    </button>
                </li>
            </ul>
        </div>

        <!-- Controls Toolbar inside Tab -->
        <div class="p-2 px-3 bg-light border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-xs btn-outline-primary extra-small py-1 px-2" @onclick="SelectAllInActiveTab">
                    <i class="bi bi-check-all me-1"></i>Select All
                </button>
                <button class="btn btn-xs btn-outline-secondary extra-small py-1 px-2" @onclick="UnselectAllInActiveTab">
                    <i class="bi bi-dash-square me-1"></i>Clear All
                </button>
                <span class="extra-small text-muted ms-2">
                    Showing @FilteredItems.Count() item(s) &bull; @GetSelectedCount(FilteredItems.ToList()) selected
                </span>
            </div>

            <!-- In-tab Search -->
            <div class="input-group input-group-sm" style="max-width: 250px;">
                <span class="input-group-text bg-white border-end-0 py-0"><i class="bi bi-search text-muted extra-small"></i></span>
                <input type="text" class="form-control form-control-sm border-start-0 py-1 extra-small" 
                       placeholder="Filter by ID or Name..." @bind="searchText" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchText))
                {
                    <button class="btn btn-sm btn-outline-secondary border-start-0 bg-white py-0" @onclick='() => searchText = ""'>✕</button>
                }
            </div>
        </div>

        <!-- Tab Table Body -->
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="extra-small text-muted mt-2">Loading user access data...</div>
                </div>
            }
            else if (!FilteredItems.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-1 opacity-50"></i>
                    <span class="extra-small">No records found matching current criteria.</span>
                </div>
            }
            else
            {
                <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0 custom-access-table">
                        <thead class="table-light sticky-top shadow-xs">
                            <tr>
                                <th style="width: 46px;" class="text-center">
                                    <input type="checkbox" class="form-check-input" 
                                           checked="@IsAllActiveSelected" 
                                           @onchange="ToggleSelectAllOnPage" 
                                           title="Select / Unselect all on this list" />
                                </th>
                                <th style="width: 25%;">@IdColumnHeader</th>
                                <th style="width: 35%;">@NameColumnHeader</th>
                                <th style="width: 35%;">@RemarkColumnHeader</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredItems)
                            {
                                var isRowSelected = item.IsSelected;
                                <tr class="@(isRowSelected ? "table-primary-subtle" : "") cursor-pointer" @onclick="() => ToggleItem(item)">
                                    <td class="text-center" @onclick:stopPropagation>
                                        <input type="checkbox" class="form-check-input" @bind="item.IsSelected" />
                                    </td>
                                    <td><span class="fw-semibold font-monospace extra-small">@item.Id</span></td>
                                    <td><span class="extra-small text-dark">@item.Name</span></td>
                                    <td>
                                        <span class="extra-small text-muted">
                                            @(activeTab == "email" ? (!string.IsNullOrEmpty(item.Extra) ? item.Extra : "-") : (!string.IsNullOrEmpty(item.Remark) ? item.Remark : "-"))
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Card Footer -->
        <div class="card-footer bg-light py-2 px-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span class="extra-small text-muted">
                Tip: Click any row or checkbox to grant or revoke leave access for the selected user.
            </span>
            <button class="btn btn-sm btn-primary py-1 px-4 extra-small d-flex align-items-center gap-1 shadow-sm" 
                    @onclick="SaveUserAccessAsync" disabled="@(isLoading || isSaving || string.IsNullOrEmpty(selectedUserId))">
                <i class="bi bi-floppy-fill me-1"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>

<style>
    .user-access-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0.5rem 0.75rem;
    }

    .access-icon-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
        border-radius: 8px;
        box-shadow: 0 2px 4px rgba(217, 119, 6, 0.25);
    }

    .extra-small {
        font-size: 0.8125rem;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .tracking-wider {
        letter-spacing: 0.05em;
    }

    .custom-nav-tabs .nav-link {
        font-size: 0.825rem;
        padding: 0.45rem 0.85rem;
        color: #4b5563;
        white-space: nowrap;
        border: none;
        border-bottom: 2px solid transparent;
        transition: all 0.15s ease-in-out;
    }

    .custom-nav-tabs .nav-link:hover {
        color: #1d4ed8;
        border-bottom-color: #93c5fd;
    }

    .custom-nav-tabs .nav-link.active {
        color: #1d4ed8;
        font-weight: 600;
        background: transparent;
        border-bottom: 2px solid #2563eb;
    }

    .custom-access-table thead th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #4b5563;
        font-weight: 700;
        padding: 0.5rem 0.75rem;
        border-top: none;
    }

    .custom-access-table tbody td {
        padding: 0.42rem 0.75rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .table-primary-subtle {
        background-color: rgba(37, 99, 235, 0.06) !important;
    }

    .spin {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private List<EmployeeLookupModel> usersList = new();
    private string selectedUserId = string.Empty;
    private LeaveUserAccessData accessData = new();
    private string activeTab = "dept";
    private string searchText = string.Empty;
    private bool isLoading = false;
    private bool isSaving = false;
    private string? statusMessage;
    private bool isSuccess = true;

    private int TotalSelectedCount =>
        GetSelectedCount(accessData.Departments) +
        GetSelectedCount(accessData.Sections) +
        GetSelectedCount(accessData.Categories) +
        GetSelectedCount(accessData.Grades) +
        GetSelectedCount(accessData.Supervisors) +
        GetSelectedCount(accessData.JobTitles) +
        GetSelectedCount(accessData.Factories) +
        GetSelectedCount(accessData.Groups) +
        GetSelectedCount(accessData.Emails);

    private string IdColumnHeader => activeTab switch
    {
        "dept" => "DEPT_ID",
        "sec" => "SECTION_ID",
        "cat" => "CATEGORY_ID",
        "grade" => "GRADE_ID",
        "sup" => "SUPER_ID",
        "job" => "JOB_ID",
        "factory" => "FACTORY_ID",
        "grp" => "GROUP ID",
        "email" => "ID",
        _ => "ID"
    };

    private string NameColumnHeader => activeTab switch
    {
        "grp" => "DSC / DESCRIPTION",
        "email" => "NAME",
        _ => "NAME"
    };

    private string RemarkColumnHeader => activeTab switch
    {
        "email" => "EMAIL ADDRESS",
        _ => "REMARK"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
        // Load default master lists
        await LoadAccessDataAsync(selectedUserId);
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            usersList = await ApiClient.GetLeaveAccessUsersAsync();
            if (usersList.Any() && string.IsNullOrEmpty(selectedUserId))
            {
                selectedUserId = usersList.First().EmpId;
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Failed to load user list: " + ex.Message;
            isSuccess = false;
        }
    }

    private async Task OnUserChangedAsync(ChangeEventArgs e)
    {
        selectedUserId = e.Value?.ToString() ?? "";
        await LoadAccessDataAsync(selectedUserId);
    }

    private async Task RefreshUserAccessAsync()
    {
        await LoadAccessDataAsync(selectedUserId);
        statusMessage = "Access permissions refreshed successfully.";
        isSuccess = true;
    }

    private async Task LoadAccessDataAsync(string userId)
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            var res = await ApiClient.GetLeaveUserAccessAsync(userId);
            if (res != null)
            {
                accessData = res;
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Error loading user access data: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        searchText = string.Empty;
    }

    private List<LeaveUserAccessItem> GetCurrentTabList() => activeTab switch
    {
        "dept" => accessData.Departments,
        "sec" => accessData.Sections,
        "cat" => accessData.Categories,
        "grade" => accessData.Grades,
        "sup" => accessData.Supervisors,
        "job" => accessData.JobTitles,
        "factory" => accessData.Factories,
        "grp" => accessData.Groups,
        "email" => accessData.Emails,
        _ => accessData.Departments
    };

    private IEnumerable<LeaveUserAccessItem> FilteredItems
    {
        get
        {
            var list = GetCurrentTabList();
            if (string.IsNullOrWhiteSpace(searchText))
            {
                return list;
            }

            var q = searchText.Trim();
            return list.Where(x => 
                (x.Id?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Remark?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Extra?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private int GetSelectedCount(List<LeaveUserAccessItem> list) => list.Count(x => x.IsSelected);

    private bool IsAllActiveSelected
    {
        get
        {
            var items = FilteredItems.ToList();
            return items.Any() && items.All(x => x.IsSelected);
        }
    }

    private void ToggleItem(LeaveUserAccessItem item)
    {
        item.IsSelected = !item.IsSelected;
    }

    private void SelectAllInActiveTab()
    {
        foreach (var item in FilteredItems)
        {
            item.IsSelected = true;
        }
    }

    private void UnselectAllInActiveTab()
    {
        foreach (var item in FilteredItems)
        {
            item.IsSelected = false;
        }
    }

    private void ToggleSelectAllOnPage(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        foreach (var item in FilteredItems)
        {
            item.IsSelected = isChecked;
        }
    }

    private async Task SaveUserAccessAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedUserId))
        {
            statusMessage = "Please select a user before saving.";
            isSuccess = false;
            return;
        }

        isSaving = true;
        statusMessage = null;

        try
        {
            var req = new SaveLeaveUserAccessRequest
            {
                UserId = selectedUserId,
                SelectedItems = new List<SelectedAccessItem>()
            };

            void AppendSelected(List<LeaveUserAccessItem> list)
            {
                foreach (var item in list.Where(x => x.IsSelected))
                {
                    req.SelectedItems.Add(new SelectedAccessItem
                    {
                        FormId = item.FormId,
                        Id = item.Id,
                        Remarks = item.Remark
                    });
                }
            }

            AppendSelected(accessData.Departments);
            AppendSelected(accessData.Sections);
            AppendSelected(accessData.Categories);
            AppendSelected(accessData.Grades);
            AppendSelected(accessData.Supervisors);
            AppendSelected(accessData.JobTitles);
            AppendSelected(accessData.Factories);
            AppendSelected(accessData.Groups);
            AppendSelected(accessData.Emails);

            var (ok, msg) = await ApiClient.SaveLeaveUserAccessAsync(req);
            isSuccess = ok;
            statusMessage = ok ? $"Successfully updated Leave access for user '{selectedUserId}' ({req.SelectedItems.Count} items assigned)." : msg;
        }
        catch (Exception ex)
        {
            statusMessage = "Save operation failed: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }
}
