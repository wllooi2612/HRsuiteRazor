@page "/leaves/approval"
@page "/leaves/supervisor"
@page "/eleaveapproval"
@page "/eleaveapprove"
@page "/eLeave/eLeaveApproval.aspx"
@page "/eLeave/eLeaveApprove.aspx"
@page "/eLeave/eLeavePostApprove.aspx"
@rendermode InteractiveServer
@inject HrApiClient ApiClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Leave Supervisor Approval - HRsuite</PageTitle>

<div class="leave-approval-legacy-container pb-5">
    <!-- Top Header Bar with Standardized Action Buttons -->
    <div class="page-top-bar d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-link text-dark p-0 text-decoration-none fs-5 d-inline-flex align-items-center back-arrow-btn" 
                    @onclick='() => NavManager.NavigateTo("leaves")' title="Back to Leave Portal">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h6 class="mb-0 fw-bold d-flex align-items-center gap-2 text-dark">
                <span class="approval-icon-badge" style="width: 28px; height: 28px; font-size: 0.95rem; background: linear-gradient(135deg, #941818 0%, #681111 100%); color: white; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="bi bi-person-check-fill"></i>
                </span>
                <span>Leave Supervisor (@(activeTab == "approve" ? "Approve Leave" : "Cancel Approved Leave"))</span>
            </h6>
            @if (PendingCount > 0)
            {
                <span class="badge bg-danger text-white rounded-pill extra-small ms-1">
                    @PendingCount Pending
                </span>
            }
            @if (isSuperAdmin)
            {
                <span class="badge bg-danger text-white extra-small fw-bold px-2 py-1 shadow-sm ms-2" title="Full Super Admin Access">
                    <i class="bi bi-shield-lock-fill me-1"></i>SUPER ADMIN
                </span>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="extra-small text-muted d-none d-sm-inline">
                Selected: <strong>@selectedLeaveNos.Count</strong> | Total: <strong>@FilteredLeaves.Count</strong>
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small d-inline-flex align-items-center gap-1 shadow-sm" style="height: 28px;"
                    @onclick="LoadDataAsync" disabled="@isLoading" title="Refresh Approval Queue">
                <i class="bi bi-arrow-clockwise @(isLoading ? "spin" : "")"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    <!-- Status Alert Notification -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center gap-2 mb-2 shadow-sm py-1 px-3 rounded-2" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-6"></i>
            <div class="flex-grow-1 extra-small">@statusMessage</div>
            <button type="button" class="btn-close py-2" @onclick='() => statusMessage = null'></button>
        </div>
    }

    <!-- 1. Two Main Legacy Tabs (Approve Leave & Cancel Approved Leave) -->
    <div class="legacy-tabs-bar">
        <button type="button" 
                class="legacy-tab-btn @(activeTab == "approve" ? "active" : "")" 
                @onclick='() => SetTab("approve")'>
            Approve Leave
        </button>
        <button type="button" 
                class="legacy-tab-btn @(activeTab == "cancel" ? "active" : "")" 
                @onclick='() => SetTab("cancel")'>
            Cancel Approved Leave
        </button>
    </div>

    <!-- 2. Action Buttons Toolbar (Exact Match to eLeaveApprove.aspx / eLeavePostApprove.aspx) -->
    <div class="legacy-toolbar">
        <!-- Filter Leave Record -->
        <button type="button" class="legacy-btn" @onclick="ToggleFilters" title="Toggle column filters">
            <i class="bi bi-funnel me-1 text-secondary"></i>Filter Leave Record
        </button>

        <!-- Refresh -->
        <button type="button" class="legacy-btn" @onclick="LoadDataAsync" disabled="@isLoading" title="Refresh table data">
            <i class="bi bi-arrow-clockwise me-1 text-secondary @(isLoading ? "spin" : "")"></i>Refresh
        </button>

        @if (activeTab == "approve")
        {
            <!-- Approve Leave (Batch) -->
            <button type="button" class="legacy-btn btn-highlight" 
                    @onclick="ApproveSelectedAsync" 
                    disabled="@(selectedLeaveNos.Count == 0 || isProcessing)" 
                    title="Approve checked leave records">
                <i class="bi bi-check2-circle me-1 text-success fw-bold"></i>Approve Leave
                @if (selectedLeaveNos.Count > 0)
                {
                    <span class="badge bg-success ms-1">@selectedLeaveNos.Count</span>
                }
            </button>

            <!-- UnApproved Leave (Batch Reject) -->
            <button type="button" class="legacy-btn" 
                    @onclick="UnApproveSelectedAsync" 
                    disabled="@(selectedLeaveNos.Count == 0 || isProcessing)" 
                    title="Reject / Unapprove checked leave records">
                <i class="bi bi-x-circle me-1 text-danger"></i>UnApproved Leave
            </button>
        }
        else
        {
            <!-- Cancel Approved Leave (Batch) -->
            <button type="button" class="legacy-btn btn-highlight" 
                    @onclick="CancelSelectedApprovedAsync" 
                    disabled="@(selectedLeaveNos.Count == 0 || isProcessing)" 
                    title="Cancel checked approved leave records">
                <i class="bi bi-slash-circle me-1 text-danger fw-bold"></i>Cancel Approved Leave
                @if (selectedLeaveNos.Count > 0)
                {
                    <span class="badge bg-danger ms-1">@selectedLeaveNos.Count</span>
                }
            </button>
        }

        <!-- Show Leave Detail -->
        <button type="button" class="legacy-btn" 
                @onclick="ShowSelectedDetail" 
                disabled="@(selectedLeaveNos.Count != 1)" 
                title="View full details of the single selected leave record">
            <i class="bi bi-card-text me-1 text-primary"></i>Show Leave Detail
        </button>

        <div class="legacy-toolbar-sep"></div>

        <!-- Export Excel (xls) -->
        <button type="button" class="legacy-btn" @onclick="() => ExportToCsv(xlsx: false)" title="Export to Excel (xls)">
            <i class="bi bi-file-earmark-excel me-1 text-success"></i>Export Excel(xls)..
        </button>

        <!-- Export Excel (xlsx) -->
        <button type="button" class="legacy-btn" @onclick="() => ExportToCsv(xlsx: true)" title="Export to Excel (xlsx)">
            <i class="bi bi-file-earmark-excel me-1 text-success"></i>Export Excel(xlsx)..
        </button>

        <!-- Export PDF -->
        <button type="button" class="legacy-btn" @onclick="ExportToPdf" title="Print / Export to PDF">
            <i class="bi bi-file-earmark-pdf me-1 text-danger"></i>Export PDF..
        </button>

        <!-- View Switcher (Auto / Grid / Cards - following UserManage.razor) -->
        <div class="btn-group btn-group-sm ms-auto shadow-sm" role="group">
            <button type="button" class="btn btn-sm py-0 px-2 @(viewMode == "auto" ? "btn-primary text-white" : "btn-outline-secondary")" @onclick='() => viewMode = "auto"' title="Adaptive Auto (Cards on Mobile, Grid on Desktop)">
                <i class="bi bi-phone"></i>
            </button>
            <button type="button" class="btn btn-sm py-0 px-2 @(viewMode == "table" ? "btn-primary text-white" : "btn-outline-secondary")" @onclick='() => viewMode = "table"' title="Grid Table View">
                <i class="bi bi-table"></i>
            </button>
            <button type="button" class="btn btn-sm py-0 px-2 @(viewMode == "cards" ? "btn-primary text-white" : "btn-outline-secondary")" @onclick='() => viewMode = "cards"' title="Cards View">
                <i class="bi bi-grid-fill"></i>
            </button>
        </div>
    </div>

    <!-- Legacy Date Filter & Mode Panel (Matching eLeaveApprove.aspx) -->
    @if (showDateFilterPanel)
    {
        <div class="legacy-date-filter-panel mb-2 p-2 bg-light border rounded d-flex align-items-center flex-wrap gap-2 shadow-sm">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold extra-small text-secondary"><i class="bi bi-funnel-fill me-1 text-primary"></i>Date Mode:</span>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input cursor-pointer" type="radio" name="dateFilterType" id="allRecordsRadio" 
                           checked="@(filterAtype == "Y")" 
                           @onchange='() => { filterAtype = "Y"; }' />
                    <label class="form-check-label extra-small cursor-pointer user-select-none" for="allRecordsRadio">Show All Records</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input cursor-pointer" type="radio" name="dateFilterType" id="dateRangeRadio" 
                           checked="@(filterAtype == "N")" 
                           @onchange='() => { filterAtype = "N"; }' />
                    <label class="form-check-label extra-small cursor-pointer user-select-none" for="dateRangeRadio">Filter by Date</label>
                </div>
            </div>

            @if (filterAtype == "N")
            {
                <div class="d-flex align-items-center gap-1 ms-sm-2">
                    <label class="extra-small text-muted mb-0">From:</label>
                    <input type="date" class="form-control form-control-sm py-0 px-2 extra-small" style="width: 135px; height: 26px;" 
                           @bind="filterDateFromVal" />
                    <label class="extra-small text-muted mb-0 ms-1">To:</label>
                    <input type="date" class="form-control form-control-sm py-0 px-2 extra-small" style="width: 135px; height: 26px;" 
                           @bind="filterDateToVal" />
                </div>
            }

            <button type="button" class="btn btn-sm btn-primary py-0 px-3 extra-small shadow-sm d-inline-flex align-items-center gap-1" style="height: 26px;"
                    @onclick="LoadDataAsync" disabled="@isLoading">
                <i class="bi bi-search"></i>
                <span>Search</span>
            </button>

            @if (isSuperAdmin)
            {
                <div class="ms-auto d-none d-md-block">
                    <span class="badge bg-danger text-white extra-small fw-bold px-2 py-1 shadow-sm">
                        <i class="bi bi-shield-lock-fill me-1"></i>YOU ARE SUPER ADMIN NOW.
                    </span>
                </div>
            }
        </div>
    }

    <!-- 3. Group Box Fieldset "Leave Record" -->
    <fieldset class="legacy-fieldset">
        <legend class="legacy-legend">Leave Record</legend>

        <!-- DESKTOP / TABLE VIEW (Wide screen or viewMode == 'table') -->
        @if (viewMode == "table" || viewMode == "auto")
        {
            <div class="@(viewMode == "auto" ? "d-none d-md-block" : "")">
                <div class="legacy-grid-scroll @(activeTab == "approve" ? "grid-cyan" : "grid-olive")">
                    <table class="legacy-grid-table @(activeTab == "approve" ? "theme-cyan" : "theme-olive")">
                        <thead>
                            <!-- Header Row 1: Column Titles -->
                            <tr class="header-row">
                                <th class="col-num">#</th>
                                <th class="col-chk">
                                    <input type="checkbox" checked="@isAllSelected" @onchange="ToggleSelectAll" title="Select / Unselect All" />
                                </th>
                                <th class="col-file">File1</th>
                                <th class="col-file">File2</th>
                                <th class="col-file">File3</th>
                                <th class="col-id">ID</th>
                                <th class="col-name">NAME</th>
                                <th class="col-date">Date From</th>
                                <th class="col-date">Date To</th>
                                <th class="col-leaveid">Leave ID</th>
                                <th class="col-day">Leave Day</th>
                                <th class="col-time">Time In</th>
                                <th class="col-s">s1</th>
                                <th class="col-time">Time Out</th>
                                <th class="col-s">s2</th>
                                <th class="col-status">Status</th>
                                <th class="col-dept">Dept</th>
                                <th class="col-sec">Section</th>
                                <th class="col-shift">Shift Grp</th>
                                <th class="col-type">Type</th>
                                <th class="col-leave">Leave</th>
                                <th class="col-reason">Reason</th>
                                <th class="col-super">Super ID</th>
                                <th class="col-created">Created Date</th>
                                <th class="col-app">App1</th>
                                <th class="col-pass">1Pass</th>
                                <th class="col-app">App2</th>
                                <th class="col-pass">2Pass</th>
                                <th class="col-app">App3</th>
                                <th class="col-pass">3Pass</th>
                                <th class="col-app">App4</th>
                                <th class="col-pass">4Pass</th>
                                <th class="col-remarks">Remarks</th>
                            </tr>

                            <!-- Header Row 2: Inline Column Filters (Toggleable) -->
                            @if (showFilters)
                            {
                                <tr class="filter-row">
                                    <td class="col-num"></td>
                                    <td class="col-chk"></td>
                                    <td class="col-file"></td>
                                    <td class="col-file"></td>
                                    <td class="col-file"></td>
                                    <td class="col-id">
                                        <input type="text" class="filter-input" @bind="filterEmpId" @bind:event="oninput" placeholder="ID" />
                                    </td>
                                    <td class="col-name">
                                        <input type="text" class="filter-input" @bind="filterName" @bind:event="oninput" placeholder="Name" />
                                    </td>
                                    <td class="col-date">
                                        <input type="text" class="filter-input" @bind="filterDateFrom" @bind:event="oninput" placeholder="From" />
                                    </td>
                                    <td class="col-date">
                                        <input type="text" class="filter-input" @bind="filterDateTo" @bind:event="oninput" placeholder="To" />
                                    </td>
                                    <td class="col-leaveid">
                                        <input type="text" class="filter-input" @bind="filterLeaveId" @bind:event="oninput" placeholder="Type" />
                                    </td>
                                    <td class="col-day">
                                        <input type="text" class="filter-input" @bind="filterDays" @bind:event="oninput" placeholder="Days" />
                                    </td>
                                    <td class="col-time">
                                        <input type="text" class="filter-input" @bind="filterTimeIn" @bind:event="oninput" placeholder="In" />
                                    </td>
                                    <td class="col-s">
                                        <input type="text" class="filter-input" @bind="filterS1" @bind:event="oninput" />
                                    </td>
                                    <td class="col-time">
                                        <input type="text" class="filter-input" @bind="filterTimeOut" @bind:event="oninput" placeholder="Out" />
                                    </td>
                                    <td class="col-s">
                                        <input type="text" class="filter-input" @bind="filterS2" @bind:event="oninput" />
                                    </td>
                                    <td class="col-status">
                                        <input type="text" class="filter-input" @bind="filterStatusCol" @bind:event="oninput" placeholder="Status" />
                                    </td>
                                    <td class="col-dept">
                                        <input type="text" class="filter-input" @bind="filterDept" @bind:event="oninput" placeholder="Dept" />
                                    </td>
                                    <td class="col-sec">
                                        <input type="text" class="filter-input" @bind="filterSection" @bind:event="oninput" placeholder="Sec" />
                                    </td>
                                    <td class="col-shift">
                                        <input type="text" class="filter-input" @bind="filterShiftGrp" @bind:event="oninput" placeholder="Shift" />
                                    </td>
                                    <td class="col-type">
                                        <input type="text" class="filter-input" @bind="filterType" @bind:event="oninput" placeholder="Type" />
                                    </td>
                                    <td class="col-leave">
                                        <input type="text" class="filter-input" @bind="filterLeaveName" @bind:event="oninput" placeholder="Leave" />
                                    </td>
                                    <td class="col-reason">
                                        <input type="text" class="filter-input" @bind="filterReason" @bind:event="oninput" placeholder="Reason" />
                                    </td>
                                    <td class="col-super">
                                        <input type="text" class="filter-input" @bind="filterSuperId" @bind:event="oninput" placeholder="Super" />
                                    </td>
                                    <td class="col-created">
                                        <input type="text" class="filter-input" @bind="filterCreatedDate" @bind:event="oninput" placeholder="Created" />
                                    </td>
                                    <td class="col-app">
                                        <input type="text" class="filter-input" @bind="filterApp1" @bind:event="oninput" placeholder="App1" />
                                    </td>
                                    <td class="col-pass">
                                        <input type="text" class="filter-input" @bind="filterApp1Pass" @bind:event="oninput" placeholder="P1" />
                                    </td>
                                    <td class="col-app">
                                        <input type="text" class="filter-input" @bind="filterApp2" @bind:event="oninput" placeholder="App2" />
                                    </td>
                                    <td class="col-pass">
                                        <input type="text" class="filter-input" @bind="filterApp2Pass" @bind:event="oninput" placeholder="P2" />
                                    </td>
                                    <td class="col-app">
                                        <input type="text" class="filter-input" @bind="filterApp3" @bind:event="oninput" placeholder="App3" />
                                    </td>
                                    <td class="col-pass">
                                        <input type="text" class="filter-input" @bind="filterApp3Pass" @bind:event="oninput" placeholder="P3" />
                                    </td>
                                    <td class="col-app">
                                        <input type="text" class="filter-input" @bind="filterApp4" @bind:event="oninput" placeholder="App4" />
                                    </td>
                                    <td class="col-pass">
                                        <input type="text" class="filter-input" @bind="filterApp4Pass" @bind:event="oninput" placeholder="P4" />
                                    </td>
                                    <td class="col-remarks">
                                        <input type="text" class="filter-input" @bind="filterRemarks" @bind:event="oninput" placeholder="Remarks" />
                                    </td>
                                </tr>
                            }
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="33" class="text-center py-4 text-muted">
                                        <div class="spinner-border spinner-border-sm text-secondary mb-1"></div>
                                        <div style="font-size: 0.75rem;">Loading leave records from database...</div>
                                    </td>
                                </tr>
                            }
                            else if (FilteredLeaves.Count == 0)
                            {
                                <!-- Exact Match: "No data to display" Centered Across Table -->
                                <tr class="empty-row">
                                    <td colspan="33" class="empty-cell">
                                        No data to display
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int rowIdx = 1;
                                @foreach (var r in FilteredLeaves)
                                {
                                    bool isSelected = selectedLeaveNos.Contains(r.LeaveNo);
                                    bool canSel = CanSelect(r);
                                    <tr class="data-row @(isSelected ? "selected-row" : "") @(!canSel ? "row-disabled" : "")" 
                                        @onclick='() => ToggleRowSelection(r)' 
                                        @ondblclick='() => OpenDetailModal(r)'
                                        title="@GetRowTooltip(r, canSel)">
                                        <td class="col-num text-center">@rowIdx</td>
                                        <td class="col-chk text-center" @onclick:stopPropagation="true">
                                            @if (canSel)
                                            {
                                                <input type="checkbox" checked="@isSelected" @onchange='(e) => OnCheckboxChanged(r.LeaveNo, e)' />
                                            }
                                            else
                                            {
                                                <input type="checkbox" disabled checked="false" title="@GetRowTooltip(r, canSel)" />
                                            }
                                        </td>
                                        <!-- File1, File2, File3 -->
                                        <td class="col-file text-center">
                                            @if (!string.IsNullOrEmpty(r.File1))
                                            {
                                                <a href="@r.File1" target="_blank" title="View Attachment 1" @onclick:stopPropagation="true"><i class="bi bi-paperclip text-primary"></i></a>
                                            }
                                        </td>
                                        <td class="col-file text-center">
                                            @if (!string.IsNullOrEmpty(r.File2))
                                            {
                                                <a href="@r.File2" target="_blank" title="View Attachment 2" @onclick:stopPropagation="true"><i class="bi bi-paperclip text-primary"></i></a>
                                            }
                                        </td>
                                        <td class="col-file text-center">
                                            @if (!string.IsNullOrEmpty(r.File3))
                                            {
                                                <a href="@r.File3" target="_blank" title="View Attachment 3" @onclick:stopPropagation="true"><i class="bi bi-paperclip text-primary"></i></a>
                                            }
                                        </td>
                                        <!-- ID, Name -->
                                        <td class="col-id">@r.Emp_ID</td>
                                        <td class="col-name text-truncate" style="max-width: 180px;" title="@r.EmpName">@r.EmpName</td>
                                        <!-- Date From, Date To -->
                                        <td class="col-date">@r.Leave_Date_From.ToString("yyyy-MM-dd")</td>
                                        <td class="col-date">@r.Leave_Date_To.ToString("yyyy-MM-dd")</td>
                                        <!-- Leave ID, Leave Day -->
                                        <td class="col-leaveid fw-semibold">@r.Leave_Type</td>
                                        <td class="col-day text-center">@r.TotalDays.ToString("0.0")</td>
                                        <!-- Time In, s1, Time Out, s2 -->
                                        <td class="col-time text-center">@(string.IsNullOrEmpty(r.TimeIn) ? "0000" : r.TimeIn)</td>
                                        <td class="col-s text-center">@r.s1</td>
                                        <td class="col-time text-center">@(string.IsNullOrEmpty(r.TimeOut) ? "0000" : r.TimeOut)</td>
                                        <td class="col-s text-center">@r.s2</td>
                                        <!-- Status -->
                                        <td class="col-status">
                                            @if (r.Leave_Status == "APPROVE" || r.Leave_Status == "APPROVED")
                                            {
                                                <span class="status-tag status-approved">Approved</span>
                                            }
                                            else if (r.Leave_Status == "REJECT" || r.Leave_Status == "REJECTED")
                                            {
                                                <span class="status-tag status-rejected">Rejected</span>
                                            }
                                            else if (r.Leave_Status == "CANCEL" || r.Leave_Status == "CANCELLED")
                                            {
                                                <span class="status-tag status-cancelled">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="status-tag status-pending">Pending</span>
                                            }
                                        </td>
                                        <!-- Dept, Section, Shift Grp, Type -->
                                        <td class="col-dept">@r.Dept</td>
                                        <td class="col-sec">@r.Section</td>
                                        <td class="col-shift">@r.ShiftGrp</td>
                                        <td class="col-type">@r.Type</td>
                                        <td class="col-leave text-truncate" style="max-width: 140px;" title="@r.LeaveName">@r.LeaveName</td>
                                        <td class="col-reason text-truncate" style="max-width: 260px;" title="@r.Leave_Reason">@r.Leave_Reason</td>
                                        <td class="col-super text-truncate" style="max-width: 100px;" title="@r.SuperName">@r.SuperName</td>
                                        <td class="col-created text-center">@(r.CreateDate.HasValue ? r.CreateDate.Value.ToString("yyyy-MM-dd") : "")</td>
                                        <td class="col-app text-center">@r.App1</td>
                                        <td class="col-pass text-center">
                                            @if (r.App1Pass == "YES" || r.App1Pass == "Y")
                                            {
                                                <span class="text-success fw-bold">YES</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@r.App1Pass</span>
                                            }
                                        </td>
                                        <td class="col-app text-center">@r.App2</td>
                                        <td class="col-pass text-center">
                                            @if (r.App2Pass == "YES" || r.App2Pass == "Y")
                                            {
                                                <span class="text-success fw-bold">YES</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@r.App2Pass</span>
                                            }
                                        </td>
                                        <td class="col-app text-center">@r.App3</td>
                                        <td class="col-pass text-center">
                                            @if (r.App3Pass == "YES" || r.App3Pass == "Y")
                                            {
                                                <span class="text-success fw-bold">YES</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@r.App3Pass</span>
                                            }
                                        </td>
                                        <td class="col-app text-center">@r.App4</td>
                                        <td class="col-pass text-center">
                                            @if (r.App4Pass == "YES" || r.App4Pass == "Y")
                                            {
                                                <span class="text-success fw-bold">YES</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@r.App4Pass</span>
                                            }
                                        </td>
                                        <td class="col-remarks text-truncate" style="max-width: 160px;" title="@r.Remarks">@r.Remarks</td>
                                    </tr>
                                    rowIdx++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- MOBILE / CARDS VIEW (Phone site or viewMode == 'cards' - following UserManage.razor) -->
        @if (viewMode == "cards" || viewMode == "auto")
        {
            <div class="@(viewMode == "auto" ? "d-block d-md-none" : "") p-2">
                @if (isLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                        <div class="text-muted small mt-2">Loading leave applications...</div>
                    </div>
                }
                else if (FilteredLeaves.Count == 0)
                {
                    <div class="text-center py-4 text-muted bg-white border rounded p-3 mb-2">
                        <i class="bi bi-inbox fs-2 text-secondary opacity-50 d-block mb-2"></i>
                        <span>No leave applications found.</span>
                    </div>
                }
                else
                {
                    <!-- Mobile Select All Bar -->
                    <div class="d-flex justify-content-between align-items-center mb-2 px-2 py-1.5 @(activeTab == "approve" ? "bg-cyan-subtle border-cyan" : "bg-light border") rounded-2">
                        <div class="form-check d-flex align-items-center gap-2 mb-0 ms-1">
                            <input type="checkbox" class="form-check-input" id="mobileSelectAll" checked="@isAllSelected" @onchange="ToggleSelectAll" />
                            <label class="form-check-label extra-small fw-semibold text-secondary user-select-none" for="mobileSelectAll">
                                Select All (@FilteredLeaves.Count(CanSelect))
                            </label>
                        </div>
                        @if (selectedLeaveNos.Count > 0)
                        {
                            <span class="badge bg-primary me-1">@selectedLeaveNos.Count selected</span>
                        }
                    </div>

                    <div class="row g-2">
                        @foreach (var r in FilteredLeaves)
                        {
                            bool isSelected = selectedLeaveNos.Contains(r.LeaveNo);
                            bool canSel = CanSelect(r);

                            <div class="col-12 col-sm-6 col-xl-4">
                                <div class="card border rounded-3 p-3 shadow-sm leave-card-item @(isSelected ? "card-selected" : "") @(!canSel ? "card-disabled" : "")" 
                                     @onclick="() => ToggleRowSelection(r)"
                                     title="@GetRowTooltip(r, canSel)">
                                    
                                    <!-- Top Line: [Checkbox] [EMP_ID] Employee Name | [Leave Type Badge] [Status Tag] -->
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom">
                                        <div class="d-flex align-items-center gap-1.5 flex-grow-1 text-truncate">
                                            @if (canSel)
                                            {
                                                <input type="checkbox" class="form-check-input me-1 flex-shrink-0 cursor-pointer" 
                                                       checked="@isSelected" 
                                                       @onchange="(e) => OnCheckboxChanged(r.LeaveNo, e)" 
                                                       @onclick:stopPropagation="true" 
                                                       title="Select application" />
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="form-check-input me-1 flex-shrink-0" 
                                                       disabled checked="false" 
                                                       title="@GetRowTooltip(r, canSel)" />
                                            }
                                            <span class="badge bg-secondary font-monospace fw-bold" style="font-size: 0.78rem;">[@r.Emp_ID]</span>
                                            <span class="fw-bold text-dark text-truncate ms-1" style="font-size: 0.92rem;" title="@r.EmpName">@r.EmpName</span>
                                        </div>
                                        <div class="flex-shrink-0 d-flex align-items-center gap-1">
                                            <span class="badge @GetLeaveTypeBadgeClass(r.Leave_Type) fw-bold" style="font-size: 0.72rem;">@r.Leave_Type</span>
                                            <span class="status-tag @GetStatusClass(r.Leave_Status)" style="font-size: 0.7rem;">@GetStatusText(r.Leave_Status)</span>
                                        </div>
                                    </div>

                                    <!-- Line 2: Calendar Dates & Total Days Badge -->
                                    <div class="d-flex align-items-center justify-content-between small text-muted mb-2">
                                        <div class="d-flex align-items-center text-truncate">
                                            <i class="bi bi-calendar-event text-primary me-2 flex-shrink-0"></i>
                                            <span class="text-dark fw-semibold">
                                                @(r.Leave_Date_From.Date == r.Leave_Date_To.Date 
                                                    ? r.Leave_Date_From.ToString("yyyy-MM-dd") 
                                                    : $"{r.Leave_Date_From:yyyy-MM-dd} → {r.Leave_Date_To:yyyy-MM-dd}")
                                            </span>
                                        </div>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold flex-shrink-0 ms-2">
                                            @r.TotalDays.ToString("0.0") Day@(r.TotalDays > 1 ? "s" : "")
                                        </span>
                                    </div>

                                    <!-- Line 3: Created Date / Type -->
                                    <div class="d-flex align-items-center text-muted small mb-1.5 flex-wrap">
                                        <i class="bi bi-calendar-check text-secondary me-2 flex-shrink-0" style="width: 14px;"></i>
                                        <span class="me-2">
                                            <span class="text-secondary fw-semibold">Created Date:</span> 
                                            <span class="text-dark">@(r.CreateDate.HasValue ? r.CreateDate.Value.ToString("yyyy-MM-dd") : "-")</span>
                                        </span>
                                        <span class="badge bg-light text-secondary border py-0.5 px-1.5" style="font-size: 0.68rem;">@r.Type</span>
                                    </div>

                                    <!-- Line 4: Department & Section -->
                                    <div class="d-flex align-items-center text-muted small mb-2">
                                        <i class="bi bi-building text-secondary me-2 flex-shrink-0" style="width: 14px;"></i>
                                        <span class="text-truncate">
                                            <span class="text-secondary fw-semibold">Dept:</span> <span class="text-dark">@(string.IsNullOrEmpty(r.Dept) ? "-" : r.Dept)</span>
                                            @if (!string.IsNullOrEmpty(r.Section))
                                            {
                                                <span class="text-muted mx-1">|</span>
                                                <span class="text-secondary fw-semibold">Sec:</span> <span class="text-dark">@r.Section</span>
                                            }
                                            @if (!string.IsNullOrEmpty(r.ShiftGrp))
                                            {
                                                <span class="text-muted mx-1">|</span>
                                                <span class="badge bg-light text-dark border py-0 px-1">@r.ShiftGrp</span>
                                            }
                                        </span>
                                    </div>

                                    <!-- Line 5: Reason (if any) -->
                                    @if (!string.IsNullOrWhiteSpace(r.Leave_Reason))
                                    {
                                        <div class="d-flex align-items-start small mb-2 bg-light p-2 rounded border">
                                            <i class="bi bi-chat-left-text text-secondary me-2 mt-0.5 flex-shrink-0"></i>
                                            <span class="text-dark text-break" style="font-size: 0.78rem;">@r.Leave_Reason</span>
                                        </div>
                                    }

                                    <!-- Line 6: Attachments (if any) -->
                                    @if (!string.IsNullOrEmpty(r.File1) || !string.IsNullOrEmpty(r.File2) || !string.IsNullOrEmpty(r.File3))
                                    {
                                        <div class="d-flex align-items-center gap-1 mb-2 small flex-wrap" @onclick:stopPropagation="true">
                                            <span class="text-muted extra-small me-1"><i class="bi bi-paperclip"></i> Files:</span>
                                            @if (!string.IsNullOrEmpty(r.File1))
                                            {
                                                <a href="@r.File1" target="_blank" class="badge bg-light text-primary border text-decoration-none">
                                                    <i class="bi bi-file-earmark-arrow-down me-0.5"></i>File 1
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(r.File2))
                                            {
                                                <a href="@r.File2" target="_blank" class="badge bg-light text-primary border text-decoration-none">
                                                    <i class="bi bi-file-earmark-arrow-down me-0.5"></i>File 2
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(r.File3))
                                            {
                                                <a href="@r.File3" target="_blank" class="badge bg-light text-primary border text-decoration-none">
                                                    <i class="bi bi-file-earmark-arrow-down me-0.5"></i>File 3
                                                </a>
                                            }
                                        </div>
                                    }

                                    <!-- Bottom Line: 1-Click Action Buttons -->
                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top gap-1" @onclick:stopPropagation="true">
                                        <div class="d-flex align-items-center gap-1">
                                            @if (activeTab == "approve")
                                            {
                                                <button type="button" class="btn btn-xs btn-success d-inline-flex align-items-center gap-1 py-1 px-2.5 fw-semibold shadow-sm" 
                                                        @onclick='() => ProcessSingleActionAsync(r, "APPROVE")' 
                                                        disabled="@(isProcessing || !canSel)" 
                                                        title="Approve Leave Application">
                                                    <i class="bi bi-check-lg"></i>
                                                    <span>Approve</span>
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-danger d-inline-flex align-items-center gap-1 py-1 px-2 fw-semibold" 
                                                        @onclick='() => ProcessSingleActionAsync(r, "REJECT")' 
                                                        disabled="@(isProcessing || !canSel)" 
                                                        title="Reject / Unapprove Leave">
                                                    <i class="bi bi-x-lg"></i>
                                                    <span>Reject</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-xs btn-danger d-inline-flex align-items-center gap-1 py-1 px-2.5 fw-semibold shadow-sm" 
                                                        @onclick='() => ProcessSingleActionAsync(r, "CANCEL")' 
                                                        disabled="@(isProcessing || !canSel)" 
                                                        title="Cancel Approved Leave">
                                                    <i class="bi bi-slash-circle"></i>
                                                    <span>Cancel Leave</span>
                                                </button>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-xs btn-outline-primary d-inline-flex align-items-center gap-1 py-1 px-2.5 fw-semibold" 
                                                @onclick="() => OpenDetailModal(r)" 
                                                title="View Full Application Details">
                                            <i class="bi bi-card-text"></i>
                                            <span>Detail</span>
                                        </button>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div class="legacy-grid-footer d-flex justify-content-between align-items-center">
            <span>Total Records: <strong>@FilteredLeaves.Count</strong> (Selected: <strong>@selectedLeaveNos.Count</strong>)</span>
            <span class="text-muted extra-small">eLeave - Supervisor Module</span>
        </div>
    </fieldset>

    @if (activeTab == "cancel")
    {
        <div class="legacy-cancel-remark mt-2 ps-1">
            <span class="text-secondary" style="font-size: 0.76rem; font-family: Tahoma, 'Segoe UI', Arial, sans-serif;">
                (Remarks : Approve Leave not&nbsp; allow cancel if&nbsp; Leave date over today date, and cancel leave only for leave no more than 1 days )
            </span>
        </div>
    }

    <!-- 4. Leave Detail Modal Dialog (Triggered by "Show Leave Detail" or double clicking a row) -->
    @if (detailModalRecord != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.45); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content shadow border">
                    <div class="modal-header py-2 px-3 text-white" style="background-color: #2b579a;">
                        <h6 class="modal-title fw-bold extra-small mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>Leave Application Details - #@detailModalRecord.LeaveNo</span>
                        </h6>
                        <button type="button" class="btn-close btn-close-white py-0" @onclick="() => detailModalRecord = null"></button>
                    </div>
                    <div class="modal-body p-3 extra-small">
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Leave No:</label>
                                <div><code>@detailModalRecord.LeaveNo</code></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Employee ID:</label>
                                <div><strong>@detailModalRecord.Emp_ID</strong></div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="text-muted fw-bold">Employee Name:</label>
                                <div><strong>@detailModalRecord.EmpName</strong></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Leave Code:</label>
                                <div><span class="badge bg-primary">@detailModalRecord.Leave_Type</span></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Total Days:</label>
                                <div><strong>@detailModalRecord.TotalDays</strong> day(s)</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Date From:</label>
                                <div>@detailModalRecord.Leave_Date_From.ToString("yyyy-MM-dd")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Date To:</label>
                                <div>@detailModalRecord.Leave_Date_To.ToString("yyyy-MM-dd")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Day Type:</label>
                                <div>@detailModalRecord.Type</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Created Date:</label>
                                <div>@(detailModalRecord.CreateDate.HasValue ? detailModalRecord.CreateDate.Value.ToString("yyyy-MM-dd") : "-")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Status:</label>
                                <div><strong>@detailModalRecord.Leave_Status</strong></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Approval Level:</label>
                                <div>@(string.IsNullOrEmpty(detailModalRecord.AppLevel) ? "Level 1" : detailModalRecord.AppLevel)</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted fw-bold">Leave Reason / Justification:</label>
                            <div class="p-2 border rounded bg-light" style="min-height: 48px;">
                                @(string.IsNullOrWhiteSpace(detailModalRecord.Leave_Reason) ? "No reason specified." : detailModalRecord.Leave_Reason)
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(detailModalRecord.File1) || !string.IsNullOrEmpty(detailModalRecord.File2))
                        {
                            <div class="mb-3">
                                <label class="text-muted fw-bold">Attachments:</label>
                                <div class="d-flex gap-2">
                                    @if (!string.IsNullOrEmpty(detailModalRecord.File1))
                                    {
                                        <a href="@detailModalRecord.File1" target="_blank" class="btn btn-sm btn-outline-primary extra-small">
                                            <i class="bi bi-paperclip me-1"></i>Attachment 1
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(detailModalRecord.File2))
                                    {
                                        <a href="@detailModalRecord.File2" target="_blank" class="btn btn-sm btn-outline-primary extra-small">
                                            <i class="bi bi-paperclip me-1"></i>Attachment 2
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        @if (activeTab == "cancel")
                        {
                            <div class="alert alert-warning py-1 px-2 extra-small mb-2 d-flex align-items-center gap-1">
                                <i class="bi bi-info-circle-fill text-warning"></i>
                                <span>(Remarks : Approve Leave not allow cancel if Leave date over today date, and cancel leave only for leave no more than 1 days )</span>
                            </div>
                        }
                    </div>
                    <div class="modal-footer py-1 px-3 d-flex justify-content-between">
                        <div>
                            @if (activeTab == "approve" && detailModalRecord.Leave_Status != "APPROVE" && detailModalRecord.Leave_Status != "REJECT")
                            {
                                <button type="button" class="btn btn-sm btn-success extra-small px-3 me-1" @onclick='() => ProcessSingleActionAsync(detailModalRecord, "APPROVE")' disabled="@(isProcessing || !CanSelect(detailModalRecord))">
                                    <i class="bi bi-check2 me-1"></i>Approve Leave
                                </button>
                                <button type="button" class="btn btn-sm btn-danger extra-small px-3" @onclick='() => ProcessSingleActionAsync(detailModalRecord, "REJECT")' disabled="@(isProcessing || !CanSelect(detailModalRecord))">
                                    <i class="bi bi-x me-1"></i>UnApprove (Reject)
                                </button>
                            }
                            else if (activeTab == "cancel" && (detailModalRecord.Leave_Status == "APPROVE" || detailModalRecord.Leave_Status == "APPROVED"))
                            {
                                <button type="button" class="btn btn-sm btn-danger extra-small px-3" @onclick='() => ProcessSingleActionAsync(detailModalRecord, "CANCEL")' disabled="@(isProcessing || !CanSelect(detailModalRecord))">
                                    <i class="bi bi-slash-circle me-1"></i>Cancel Approved Leave
                                </button>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-secondary extra-small px-3" @onclick="() => detailModalRecord = null">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .leave-approval-legacy-container {
        font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
        color: #222222;
        width: 100%;
    }

    /* 1. Legacy Tab Styling (Exact Match to eLeaveApprove.aspx / eLeavePostApprove.aspx) */
    .legacy-tabs-bar {
        display: flex;
        align-items: flex-end;
        border-bottom: 1px solid #7f9db9;
        margin-bottom: 6px;
        padding-left: 4px;
        gap: 3px;
    }

    .legacy-tab-btn {
        background: #ece9d8;
        border: 1px solid #7f9db9;
        border-bottom: 1px solid #7f9db9;
        border-radius: 4px 4px 0 0;
        padding: 4px 18px;
        font-size: 0.78rem;
        font-weight: 600;
        color: #333333;
        cursor: pointer;
        outline: none;
        transition: background-color 0.12s ease;
    }

    .legacy-tab-btn:hover {
        background: #f5f5f5;
    }

    .legacy-tab-btn.active {
        background: #ffffff;
        border-bottom: 1px solid #ffffff;
        margin-bottom: -1px;
        color: #000000;
        font-weight: 700;
        z-index: 2;
    }

    /* 2. Legacy Action Buttons Toolbar */
    .legacy-toolbar {
        background: #fbfbfb;
        border: 1px solid #b5b5b5;
        border-radius: 2px;
        padding: 3px 6px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px;
        margin-bottom: 6px;
    }

    .legacy-btn {
        background: linear-gradient(to bottom, #ffffff 0%, #ece9d8 100%);
        border: 1px solid #707070;
        border-radius: 2px;
        padding: 2px 10px;
        font-size: 0.74rem;
        font-family: Tahoma, 'Segoe UI', Arial, sans-serif;
        font-weight: 500;
        color: #111111;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        line-height: 1.35;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
        outline: none;
        transition: all 0.1s ease;
    }

    .legacy-btn:hover:not(:disabled) {
        background: linear-gradient(to bottom, #f2f7fc 0%, #dce9f6 100%);
        border-color: #337ab7;
        color: #000000;
    }

    .legacy-btn:active:not(:disabled) {
        background: #d8e5f2;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    .legacy-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        background: #f4f4f4;
        border-color: #cccccc;
        color: #888888;
    }

    .legacy-btn.btn-highlight {
        font-weight: 700;
    }

    .legacy-toolbar-sep {
        width: 1px;
        height: 18px;
        background: #cccccc;
        margin: 0 3px;
    }

    /* 3. Group Box FieldSet */
    .legacy-fieldset {
        border: 1px solid #8ba0b5;
        border-radius: 2px;
        padding: 6px;
        margin: 0 0 12px 0;
        background: #ffffff;
    }

    .legacy-legend {
        font-size: 0.78rem;
        font-weight: 700;
        color: #111111;
        width: auto;
        float: none;
        padding: 0 6px;
        margin-bottom: 2px;
    }

    /* 4. Legacy Grid Table (Exact Match to User Screenshot) */
    .legacy-grid-scroll {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #7a9456;
        min-height: 180px;
        background: #ffffff;
    }

    .legacy-grid-scroll.grid-cyan {
        border-color: #5aa2b0;
    }

    .legacy-grid-scroll.grid-olive {
        border-color: #7a9456;
    }

    .legacy-grid-table {
        width: 100%;
        min-width: 2350px;
        border-collapse: collapse;
        font-size: 0.72rem;
        font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
    }

    /* Common Header Th */
    .legacy-grid-table thead tr.header-row th {
        font-weight: 700;
        padding: 4px 6px;
        text-align: left;
        white-space: nowrap;
        user-select: none;
    }

    .legacy-grid-table thead tr.filter-row td {
        padding: 1px 2px;
    }

    .filter-input {
        width: 100%;
        height: 19px;
        font-size: 0.70rem;
        padding: 1px 3px;
        background: #ffffff;
        color: #111111;
        outline: none;
        box-sizing: border-box;
    }

    /* --- APPROVAL GRID PART: LIGHT CYAN THEME --- */
    .legacy-grid-table.theme-cyan thead tr.header-row th {
        background-color: #b2e3e8; /* Light Cyan */
        color: #0c363d;
        border: 1px solid #5aa2b0;
    }

    .legacy-grid-table.theme-cyan thead tr.filter-row td {
        background-color: #d6f2f5; /* Very Light Cyan */
        border: 1px solid #5aa2b0;
    }

    .legacy-grid-table.theme-cyan .filter-input {
        border: 1px solid #72b3bf;
    }

    .legacy-grid-table.theme-cyan .filter-input:focus {
        border-color: #0b687c;
        background: #fffffa;
    }

    .legacy-grid-table.theme-cyan tbody tr.data-row:hover {
        background-color: #e6f7f9;
    }

    /* --- CANCEL APPROVAL GRID PART: OLIVE GREEN THEME (UNCHANGED) --- */
    .legacy-grid-table.theme-olive thead tr.header-row th,
    .legacy-grid-table:not(.theme-cyan) thead tr.header-row th {
        background-color: #b0c890;
        color: #1e3010;
        border: 1px solid #7a9456;
    }

    .legacy-grid-table.theme-olive thead tr.filter-row td,
    .legacy-grid-table:not(.theme-cyan) thead tr.filter-row td {
        background-color: #c8dcab;
        border: 1px solid #7a9456;
    }

    .legacy-grid-table.theme-olive .filter-input,
    .legacy-grid-table:not(.theme-cyan) .filter-input {
        border: 1px solid #7a9456;
    }

    .legacy-grid-table.theme-olive .filter-input:focus,
    .legacy-grid-table:not(.theme-cyan) .filter-input:focus {
        border-color: #2b579a;
        background: #fffffa;
    }

    .bg-cyan-subtle {
        background-color: #eaf8fa !important;
    }

    .border-cyan {
        border: 1px solid #b2e3e8 !important;
