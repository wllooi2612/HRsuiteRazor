    private void DetermineActiveTab()
    {
        var uri = NavManager.Uri.ToLowerInvariant();
        if (TabQuery == "cancel" || uri.Contains("postapprove") || uri.Contains("tab=cancel"))
        {
            activeTab = "cancel";
        }
        else
        {
            activeTab = "approve";
        }
    }

    private async Task SetTab(string tab)
    {
        if (activeTab != tab)
        {
            activeTab = tab;
            selectedLeaveNos.Clear();
            statusMessage = null;
            if (tab == "cancel")
            {
                NavManager.NavigateTo("leaves/approval?tab=cancel", replace: true);
            }
            else
            {
                NavManager.NavigateTo("leaves/approval", replace: true);
            }
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            var supervisorId = ApiClient.CurrentUser?.ID ?? "admin";
            string targetStatus = activeTab == "approve" ? "PENDING" : "CANCELLEAVE";

            leaves = await ApiClient.GetSupervisorApprovalLeavesAsync(
                targetStatus,
                filterDateFromVal,
                filterDateToVal,
                filterAtype,
                supervisorId);

            // Check if supervisor is super admin for LEAVE
            try
            {
                var appLevels = await ApiClient.GetLeaveApprovalLevelsAsync(supervisorId);
                var myLevel = appLevels?.FirstOrDefault(l => string.Equals(l.ID, supervisorId, StringComparison.OrdinalIgnoreCase));
                isSuperAdmin = myLevel?.SuperAdminLeave == "Y" || string.Equals(supervisorId, "admin", StringComparison.OrdinalIgnoreCase);
            }
            catch
            {
                isSuperAdmin = string.Equals(supervisorId, "admin", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading leaves: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
        showDateFilterPanel = showFilters;
    }

    private bool CanSelect(LeaveRequest r)
    {
        if (r == null) return false;

        if (activeTab == "cancel")
        {
            // 1. Must be in approved status
            if (r.Leave_Status != "APPROVE" && r.Leave_Status != "APPROVED")
                return false;

            // 2. Remarks : cancel leave only for leave no more than 1 days (applies to ALL users including Super Admin)
            if (r.TotalDays > 1.0m)
                return false;

            // 3. Permission check: if not super admin, must be authorized approver (CheckBoxOpen2)
            if (!isSuperAdmin && !r.CheckBoxOpen2)
                return false;

            return true;
        }
        else
        {
            // Approve Leave tab:
            // 1. Only pending leaves can be approved
            if (r.Leave_Status != "PENDING" && r.Leave_Status != "PROCESS")
                return false;

            // 2. Approver level check: prior level approver must have approved (CheckBoxOpen)
            if (!isSuperAdmin && !r.CheckBoxOpen)
                return false;

            return true;
        }
    }

    private string GetRowTooltip(LeaveRequest r, bool canSel)
    {
        if (canSel)
            return "Click to select/unselect record. Double-click to view details.";

        if (activeTab == "cancel")
        {
            if (r.TotalDays > 1.0m)
                return $"Not allowed to select: Leave duration is {r.TotalDays:0.0} days. Cancel leave is only allowed for leave no more than 1 day.";
            if (r.Leave_Status != "APPROVE" && r.Leave_Status != "APPROVED")
                return "Not allowed to select: Leave record is not in Approved status.";
            if (!isSuperAdmin && !r.CheckBoxOpen2)
                return "Not allowed to select: You are not authorized to cancel this leave record.";
            return "Not allowed to select this record.";
        }
        else
        {
            if (r.Leave_Status != "PENDING" && r.Leave_Status != "PROCESS")
                return "Not allowed to select: Leave record is not pending approval.";
            if (!isSuperAdmin && !r.CheckBoxOpen)
                return "Not allowed to select: Pending approval from prior level approver.";
            return "Not allowed to select this record.";
        }
    }

