    private bool isAllSelected => FilteredLeaves.Any(CanSelect) && FilteredLeaves.Where(CanSelect).All(l => selectedLeaveNos.Contains(l.LeaveNo));

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool select = (bool)(e.Value ?? false);
        if (select)
        {
            foreach (var r in FilteredLeaves.Where(CanSelect))
            {
                selectedLeaveNos.Add(r.LeaveNo);
            }
        }
        else
        {
            selectedLeaveNos.Clear();
        }
    }

    private void ToggleRowSelection(LeaveRequest r)
    {
        if (!CanSelect(r)) return;
        if (selectedLeaveNos.Contains(r.LeaveNo))
            selectedLeaveNos.Remove(r.LeaveNo);
        else
            selectedLeaveNos.Add(r.LeaveNo);
    }

    private void OnCheckboxChanged(string leaveNo, ChangeEventArgs e)
    {
        var r = FilteredLeaves.FirstOrDefault(x => x.LeaveNo == leaveNo);
        if (r != null && !CanSelect(r)) return;
        bool val = (bool)(e.Value ?? false);
        if (val)
            selectedLeaveNos.Add(leaveNo);
        else
            selectedLeaveNos.Remove(leaveNo);
    }

    private void ShowSelectedDetail()
    {
        if (selectedLeaveNos.Count == 1)
        {
            var no = selectedLeaveNos.First();
            var target = leaves?.FirstOrDefault(l => l.LeaveNo == no);
            if (target != null)
            {
                OpenDetailModal(target);
            }
        }
    }

    private void OpenDetailModal(LeaveRequest item)
    {
        detailModalRecord = item;
    }

    // Action 1: Batch Approve
    private async Task ApproveSelectedAsync()
    {
        if (selectedLeaveNos.Count == 0) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to APPROVE {selectedLeaveNos.Count} selected leave application(s)?");
        if (!confirmed) return;

        isProcessing = true;
        statusMessage = null;
        try
        {
            var supervisorId = ApiClient.CurrentUser?.ID ?? "admin";
            var targetItems = leaves?.Where(l => selectedLeaveNos.Contains(l.LeaveNo)).ToList() ?? new();
            var batchModels = targetItems.Select(item => new ApproveActionModel
            {
                LeaveNo = item.LeaveNo,
                EmpId = item.Emp_ID,
                Action = "APPROVE",
                Remarks = "Approved via Supervisor Approval Batch",
                SupervisorId = supervisorId
            }).ToList();

            bool ok = await ApiClient.ApproveBatchLeavesAsync(batchModels);
            if (ok)
            {
                statusMessage = $"Successfully approved {batchModels.Count} leave request(s)!";
                isSuccess = true;
                selectedLeaveNos.Clear();
                await LoadDataAsync();
            }
            else
            {
                statusMessage = "Failed to approve selected leaves via Web API.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Exception approving leaves: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    // Action 2: Batch UnApprove (Reject)
    private async Task UnApproveSelectedAsync()
    {
        if (selectedLeaveNos.Count == 0) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to REJECT / UNAPPROVE {selectedLeaveNos.Count} selected leave application(s)?");
        if (!confirmed) return;

        isProcessing = true;
        statusMessage = null;
        try
        {
            var supervisorId = ApiClient.CurrentUser?.ID ?? "admin";
            var targetItems = leaves?.Where(l => selectedLeaveNos.Contains(l.LeaveNo)).ToList() ?? new();
            var batchModels = targetItems.Select(item => new ApproveActionModel
            {
                LeaveNo = item.LeaveNo,
                EmpId = item.Emp_ID,
                Action = "REJECT",
                Remarks = "Rejected / Unapproved via Supervisor Approval Batch",
                SupervisorId = supervisorId
            }).ToList();

            bool ok = await ApiClient.ApproveBatchLeavesAsync(batchModels);
            if (ok)
            {
                statusMessage = $"Successfully unapproved/rejected {batchModels.Count} leave request(s)!";
                isSuccess = true;
                selectedLeaveNos.Clear();
                await LoadDataAsync();
            }
            else
            {
                statusMessage = "Failed to reject selected leaves via Web API.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Exception unapproving leaves: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    // Action 3: Batch Cancel Approved Leave
    private async Task CancelSelectedApprovedAsync()
    {
        if (selectedLeaveNos.Count == 0) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to CANCEL the {selectedLeaveNos.Count} selected approved leave request(s)? This will return the leave days to employee balance.\n\n(Remarks : Approve Leave not allow cancel if Leave date over today date, and cancel leave only for leave no more than 1 days )");
        if (!confirmed) return;

        isProcessing = true;
        statusMessage = null;
        try
        {
            var supervisorId = ApiClient.CurrentUser?.ID ?? "admin";
            var targetItems = leaves?.Where(l => selectedLeaveNos.Contains(l.LeaveNo)).ToList() ?? new();

            // Validate 1 day rule for cancel
            if (!isSuperAdmin && targetItems.Any(l => l.TotalDays > 1.0m))
            {
                statusMessage = "Cannot cancel: Cancel leave is only allowed for leave of no more than 1 day.";
                isSuccess = false;
                return;
            }
            var batchModels = targetItems.Select(item => new ApproveActionModel
            {
                LeaveNo = item.LeaveNo,
                EmpId = item.Emp_ID,
                Action = "CANCEL",
                Remarks = "Cancelled via Supervisor Cancel Approved Leave Module",
                SupervisorId = supervisorId
            }).ToList();

            bool ok = await ApiClient.ApproveBatchLeavesAsync(batchModels);
            if (ok)
            {
                statusMessage = $"Successfully cancelled {batchModels.Count} approved leave request(s)! Balance has been refunded.";
                isSuccess = true;
                selectedLeaveNos.Clear();
                await LoadDataAsync();
            }
            else
            {
                statusMessage = "Failed to cancel selected approved leaves via Web API.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Exception cancelling leaves: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    // Action 4: Single Action from Modal
    private async Task ProcessSingleActionAsync(LeaveRequest item, string action)
    {
        isProcessing = true;
        try
        {
            if (action == "CANCEL" && !isSuperAdmin && item.TotalDays > 1.0m)
            {
                statusMessage = $"Cannot cancel leave #{item.LeaveNo}: Cancel leave is only allowed for leave no more than 1 day ({item.TotalDays} days applied).";
                isSuccess = false;
                return;
            }

            var supervisorId = ApiClient.CurrentUser?.ID ?? "admin";
            var model = new ApproveActionModel
            {
                LeaveNo = item.LeaveNo,
                EmpId = item.Emp_ID,
                Action = action,
                Remarks = $"Processed via Leave Supervisor Modal ({action})",
                SupervisorId = supervisorId
            };

            bool ok = await ApiClient.ApproveLeaveAsync(model);
            if (ok)
            {
                statusMessage = $"Leave #{item.LeaveNo} for employee [{item.Emp_ID}] was successfully {(action == "APPROVE" ? "APPROVED" : action == "CANCEL" ? "CANCELLED" : "REJECTED")}!";
                isSuccess = true;
                detailModalRecord = null;
                selectedLeaveNos.Remove(item.LeaveNo);
                await LoadDataAsync();
            }
            else
            {
                statusMessage = $"Failed to {action} leave #{item.LeaveNo}.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    // Export Excel (CSV)
    private async Task ExportToCsv(bool xlsx)
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("No,ID,NAME,Date From,Date To,Leave ID,Leave Day,Time In,s1,Time Out,s2,Status,Dept,Section,Shift Grp,Type,Leave,Reason,Super ID,Created Date,App1,1Pass,App2,2Pass,App3,3Pass,App4,4Pass,Remarks");
            int idx = 1;
            foreach (var r in FilteredLeaves)
            {
                sb.AppendLine($"{idx},\"{r.Emp_ID}\",\"{r.EmpName}\",{r.Leave_Date_From:yyyy-MM-dd},{r.Leave_Date_To:yyyy-MM-dd},\"{r.Leave_Type}\",{r.TotalDays},\"{r.TimeIn}\",\"{r.s1}\",\"{r.TimeOut}\",\"{r.s2}\",\"{r.Leave_Status}\",\"{r.Dept}\",\"{r.Section}\",\"{r.ShiftGrp}\",\"{r.Type}\",\"{r.LeaveName}\",\"{r.Leave_Reason}\",\"{r.SuperName}\",\"{(r.CreateDate.HasValue ? r.CreateDate.Value.ToString("yyyy-MM-dd") : "")}\",\"{r.App1}\",\"{r.App1Pass}\",\"{r.App2}\",\"{r.App2Pass}\",\"{r.App3}\",\"{r.App3Pass}\",\"{r.App4}\",\"{r.App4Pass}\",\"{r.Remarks}\"");
                idx++;
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            string filename = activeTab == "approve" 
                ? (xlsx ? "ApproveLeaveList.xlsx" : "ApproveLeaveList.xls") 
                : (xlsx ? "CancelApprovedLeaveList.xlsx" : "CancelApprovedLeaveList.xls");

            await JS.InvokeVoidAsync("eval", $@"
                var a = document.createElement('a');
                a.href = 'data:text/csv;charset=utf-8;base64,{base64}';
                a.download = '{filename}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            ");
        }
        catch (Exception ex)
        {
            statusMessage = $"Export error: {ex.Message}";
            isSuccess = false;
        }
    }

    // Export PDF
    private async Task ExportToPdf()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            statusMessage = $"Print error: {ex.Message}";
            isSuccess = false;
        }
    }

    // Helper methods for mobile cards view (matching UserManage.razor style)
    private string GetStatusClass(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "APPROVE" or "APPROVED" => "status-approved",
            "REJECT" or "REJECTED" => "status-rejected",
            "CANCEL" or "CANCELLED" => "status-cancelled",
            _ => "status-pending"
        };
    }

    private string GetStatusText(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "APPROVE" or "APPROVED" => "Approved",
            "REJECT" or "REJECTED" => "Rejected",
            "CANCEL" or "CANCELLED" => "Cancelled",
            _ => "Pending"
        };
    }

    private string GetLeaveTypeBadgeClass(string? type)
    {
        return (type?.ToUpperInvariant()) switch
        {
            "AL" => "bg-primary text-white",
            "MC" or "SL" => "bg-danger text-white",
            "EL" => "bg-warning text-dark",
            "UL" => "bg-secondary text-white",
            "CL" => "bg-info text-dark",
            "HL" => "bg-success text-white",
            _ => "bg-dark text-white"
        };
    }
