@code {
    private DbStatusInfo? dbStatus;
    private List<TableStat>? tables;
    private List<StaffDirectoryItem>? users;
    private List<LeaveRequest>? leaves;
    private List<OTRecord>? otRecords;
    private TableDetailDto? inspectedTable;

    private bool isLoading = true;
    private string activeTab = "users";
    private string userSearch = "";
    private string? statusMessage;
    private bool isSuccessMessage;

    // CRUD Tester fields
    private string crudTableName = "aspnet_users";
    private string crudOperation = "SELECT";
    private string crudKeyCol = "ID";
    private string crudKeyVal = "00001";
    private string crudJsonPayload = "{\n  \"Name\": \"UPDATED NAME\"\n}";
    private bool isExecutingCrud = false;
    private List<Dictionary<string, object?>>? crudResultRows;
    private string? crudStatusResponse;

    private List<StaffDirectoryItem> FilteredUsers => 
        string.IsNullOrWhiteSpace(userSearch)
            ? (users ?? new List<StaffDirectoryItem>())
            : (users?.Where(u => u.Name.Contains(userSearch, StringComparison.OrdinalIgnoreCase) ||
                                 u.EmpId.Contains(userSearch, StringComparison.OrdinalIgnoreCase) ||
                                 u.Email.Contains(userSearch, StringComparison.OrdinalIgnoreCase)).ToList() ?? new List<StaffDirectoryItem>());

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            dbStatus = await ApiClient.GetDatabaseStatusAsync();
            tables = await ApiClient.GetTableStatsAsync();
            users = await ApiClient.GetUsersAsync();
            leaves = await ApiClient.GetLeavesAsync();
            otRecords = await ApiClient.GetOtHistoryAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to load data from Web API: {ex.Message}";
            isSuccessMessage = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task InspectTableAsync(string tableName)
    {
        inspectedTable = await ApiClient.GetTableDetailAsync(tableName, 5);
    }

    private async Task ExecuteCrudTaskAsync()
    {
        isExecutingCrud = true;
        crudResultRows = null;
        crudStatusResponse = null;

        try
        {
            if (crudOperation == "SELECT")
            {
                crudResultRows = await ApiClient.SelectTableAsync(crudTableName, 20, 0);
                crudStatusResponse = $"[SUCCESS] Fetched {crudResultRows.Count} rows from {crudTableName} via GET /api/DbCrud/{crudTableName}";
            }
            else if (crudOperation == "INSERT")
            {
                var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object?>>(crudJsonPayload);
                if (dict == null) throw new Exception("Invalid JSON payload.");
                var res = await ApiClient.InsertRecordAsync(crudTableName, dict);
                crudStatusResponse = $"[RESULT] Success: {res.Success}, RowsAffected: {res.RowsAffected}, InsertedId: {res.InsertedId}, Message: {res.Message}";
                if (res.Success) await RefreshDataAsync();
            }
            else if (crudOperation == "UPDATE")
            {
                var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object?>>(crudJsonPayload);
                if (dict == null) throw new Exception("Invalid JSON payload.");
                var res = await ApiClient.UpdateRecordAsync(crudTableName, crudKeyCol, crudKeyVal, dict);
                crudStatusResponse = $"[RESULT] Success: {res.Success}, RowsAffected: {res.RowsAffected}, Message: {res.Message}";
                if (res.Success) await RefreshDataAsync();
            }
            else if (crudOperation == "DELETE")
            {
                var res = await ApiClient.DeleteRecordAsync(crudTableName, crudKeyCol, crudKeyVal);
                crudStatusResponse = $"[RESULT] Success: {res.Success}, RowsAffected: {res.RowsAffected}, Message: {res.Message}";
                if (res.Success) await RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            crudStatusResponse = $"[ERROR] {ex.Message}";
        }
        finally
        {
            isExecutingCrud = false;
        }
    }
}
