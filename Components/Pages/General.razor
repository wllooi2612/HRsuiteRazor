                                        <input type="date" class="form-control form-control-sm" value="@(model.ClaimCutOffEnd?.ToString("yyyy-MM-dd"))" @onchange="OnClaimEndChanged" />
                                    </div>
                                </div>

                                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                    <div>
                                        <div class="small fw-semibold text-dark">Individual Employee Cut-Off Overrides</div>
                                        <div class="extra-small text-muted">Allow individual employee exceptions to default claim cycle boundaries.</div>
                                    </div>
                                    <div class="form-check form-switch m-0">
                                        <input class="form-check-input" type="checkbox" id="claimIndSwitch" checked="@(model.ClaimIndividualCutOff == "Y")" @onchange='(e) => model.ClaimIndividualCutOff = (bool)(e.Value ?? false) ? "Y" : "N"' />
