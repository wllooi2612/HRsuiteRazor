                                        </div>

                                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom mb-3">
                                            <div>
                                                <div class="small fw-semibold text-dark">Unlimited Leave Submission Delay</div>
                                                <div class="extra-small text-muted">Allows applying for pending leave at any time.</div>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="leaveSubUnl" checked="@(model.LEAVESubmitUnlimited == "Y")" @onchange='(e) => model.LEAVESubmitUnlimited = (bool)(e.Value ?? false) ? "Y" : "N"' />
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-semibold">Leave Submission Delay Interval</label>
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="5" min="0" class="form-control" @bind="model.LEAVEPendingProcessInterval" />
                                                <span class="input-group-text">mins</span>
                                            </div>
                                            <div class="form-text extra-small">Interval buffer between applying pending leave and present execution.</div>
                                        </div>

                                        <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                            <div>
                                                <div class="small fw-semibold text-dark">Open Timeman Schedule Integration</div>
