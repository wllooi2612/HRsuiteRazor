@if (showCompanyModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg rounded-4 border-0">
                <div class="modal-header bg-success text-white py-3 px-4 rounded-top-4">
                    <h5 class="modal-head-title mb-0 d-flex align-items-center gap-2">
                        <i class="bi @(isEditCompany ? "bi-pencil-square" : "bi-building-add")"></i>
                        <span>@(isEditCompany ? "Edit Company Information" : "Add New Company Profile")</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showCompanyModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-4">
                            <label class="form-label small fw-semibold text-muted">Company ID (CoNo) *</label>
                            <input type="text" class="form-control form-control-sm" @bind="companyForm.CoNo" disabled="@isEditCompany" placeholder="e.g. 2" />
                        </div>
                        <div class="col-8">
                            <label class="form-label small fw-semibold text-muted">Company Name *</label>
                            <input type="text" class="form-control form-control-sm" @bind="companyForm.CompanyName" placeholder="e.g. Acme Corporation Sdn Bhd" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Address Line 1</label>
                            <input type="text" class="form-control form-control-sm" @bind="companyForm.Add1" placeholder="Street Address" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted">Address Line 2</label>
                            <input type="text" class="form-control form-control-sm" @bind="companyForm.Add2" placeholder="Suite / Unit / Building" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted">Address Line 3</label>
                            <input type="text" class="form-control form-control-sm" @bind="companyForm.Add3" placeholder="City, State, Postcode" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted">Telephone</label>
                            <input type="text" class="form-control form-control-sm" @bind="companyForm.Tel" placeholder="+60 3-1234 5678" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted">Fax</label>
                            <input type="text" class="form-control form-control-sm" @bind="companyForm.Fax" placeholder="+60 3-1234 5679" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted">Corporate Email</label>
                            <input type="email" class="form-control form-control-sm" @bind="companyForm.Email" placeholder="info@company.com" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted">Website / HTTP Main</label>
                            <input type="text" class="form-control form-control-sm" @bind="companyForm.HttpMain" placeholder="https://company.com" />
