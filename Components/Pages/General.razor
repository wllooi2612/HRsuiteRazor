<!-- ========================================== -->
<!-- MODAL: BREAK TIME SYNTAX HELPER            -->
<!-- ========================================== -->
@if (showBreakTimeHelperModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg rounded-4 border-0">
                <div class="modal-header bg-dark text-white py-3 px-4 rounded-top-4">
                    <h6 class="modal-title mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill text-info"></i>
                        <span>Break Time Definition Syntax Cheatsheet</span>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showBreakTimeHelperModal = false"></button>
                </div>
                <div class="modal-body p-4 small">
                    <div class="alert alert-info py-2 px-3 mb-3">
                        Break time definitions dictate unpaid or deducted intervals when employee OT falls within specific periods.
                    </div>

                    <h6 class="fw-bold text-dark">Syntax Format:</h6>
                    <div class="p-3 bg-light rounded-3 border mb-3 font-monospace">
                        [Start Time]-[End Time]=[Deducted Minutes];<br />
                        e.g. <code>12:00-13:00=60;18:00-18:30=30;</code>
                    </div>

                    <h6 class="fw-bold text-dark">Examples:</h6>
                    <table class="table table-sm table-bordered mb-3">
                        <thead class="table-light">
                            <tr>
                                <th>Definition</th>
                                <th>Explanation</th>
                                <th>Quick Apply</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>12:00-13:00=60;</code></td>
                                <td>Deducts 60 mins break if OT spans between 12:00 PM and 1:00 PM.</td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary" @onclick='() => ApplyDefinitionTemplate("12:00-13:00=60;")'>Use</button>
                                </td>
                            </tr>
                            <tr>
                                <td><code>12:00-13:00=60;18:00-18:30=30;</code></td>
                                <td>Deducts lunch break (60 mins) and dinner break (30 mins).</td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary" @onclick='() => ApplyDefinitionTemplate("12:00-13:00=60;18:00-18:30=30;")'>Use</button>
                                </td>
                            </tr>
                            <tr>
                                <td><code>00:00-01:00=60;12:00-13:00=60;18:00-19:00=60;</code></td>
                                <td>3-shift rotational break deduction configuration.</td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary" @onclick='() => ApplyDefinitionTemplate("00:00-01:00=60;12:00-13:00=60;18:00-19:00=60;")'>Use</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer bg-light px-4 py-2 rounded-bottom-4">
                    <button type="button" class="btn btn-sm btn-secondary px-4" @onclick="() => showBreakTimeHelperModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

