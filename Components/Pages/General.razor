@code {
    private string activeTab = "general";
    private string selectedCoNo = "1";
    private GeneralSettingsModel model = new();
    private List<CompanyDetailModel> companies = new();

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isTestingEmail = false;
    private string? testEmailResult = null;
    private bool testEmailSuccess = false;

    private string? statusMessage = null;
    private bool statusSuccess = true;

    private bool showPassword = false;

    // Modals
    private bool showCompanyModal = false;
    private bool isEditCompany = false;
    private CompanyDetailModel companyForm = new();

    private bool showDeleteModal = false;
    private string? companyToDelete = null;

    private bool showBreakTimeHelperModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            companies = await ApiClient.GetCompanyDetailsAsync();
            if (companies.Count > 0 && !companies.Any(c => c.CoNo.Equals(selectedCoNo, StringComparison.OrdinalIgnoreCase)))
            {
                selectedCoNo = companies[0].CoNo;
            }

            var res = await ApiClient.GetGeneralSettingsAsync(selectedCoNo);
            if (res != null)
            {
                model = res;
            }
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Error loading configuration: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnCompanySelected(ChangeEventArgs e)
    {
        selectedCoNo = e.Value?.ToString() ?? "1";
        isLoading = true;
        try
        {
            var res = await ApiClient.GetGeneralSettingsAsync(selectedCoNo);
            if (res != null)
            {
                model = res;
            }
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Error switching company: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        isSaving = true;
        statusMessage = null;
        try
        {
            model.CoNo = selectedCoNo;
            var (success, msg) = await ApiClient.SaveGeneralSettingsAsync(model);
            statusSuccess = success;
            statusMessage = msg ?? (success ? "Settings saved successfully." : "Failed to save settings.");

            if (success)
            {
                // Reload list to synchronize company name if updated
                companies = await ApiClient.GetCompanyDetailsAsync();
            }
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Error saving settings: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task TestEmailConnectionAsync()
    {
        isTestingEmail = true;
        testEmailResult = null;
        try
        {
            var (success, msg) = await ApiClient.TestEmailConnectionAsync(model);
            testEmailSuccess = success;
            testEmailResult = msg;
        }
        catch (Exception ex)
        {
            testEmailSuccess = false;
            testEmailResult = $"Test failed: {ex.Message}";
        }
        finally
        {
            isTestingEmail = false;
        }
    }

    // --- COMPANY MODAL HANDLERS ---
    private void OpenAddCompanyModal()
    {
        isEditCompany = false;
        companyForm = new CompanyDetailModel();
        showCompanyModal = true;
    }

    private void OpenEditCompanyModal(CompanyDetailModel comp)
    {
        isEditCompany = true;
        companyForm = new CompanyDetailModel
        {
            CoNo = comp.CoNo,
            CompanyName = comp.CompanyName,
            Add1 = comp.Add1,
            Add2 = comp.Add2,
            Add3 = comp.Add3,
            Tel = comp.Tel,
            Fax = comp.Fax,
            Email = comp.Email,
            HttpMain = comp.HttpMain
        };
        showCompanyModal = true;
    }

    private async Task SaveCompanyAsync()
    {
        if (string.IsNullOrWhiteSpace(companyForm.CoNo))
        {
            statusSuccess = false;
            statusMessage = "Company ID (CoNo) is required.";
            return;
        }

        try
        {
            var (success, msg) = await ApiClient.SaveCompanyAsync(companyForm);
            showCompanyModal = false;
            statusSuccess = success;
            statusMessage = msg;

            if (success)
            {
                companies = await ApiClient.GetCompanyDetailsAsync();
                if (companyForm.CoNo.Equals(selectedCoNo, StringComparison.OrdinalIgnoreCase))
                {
                    model.CompanyName = companyForm.CompanyName;
                    model.Add1 = companyForm.Add1;
                    model.Add2 = companyForm.Add2;
                    model.Add3 = companyForm.Add3;
                    model.Tel = companyForm.Tel;
                    model.Fax = companyForm.Fax;
                    model.Email = companyForm.Email;
                    model.HttpMain = companyForm.HttpMain;
                }
            }
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Failed to save company: {ex.Message}";
        }
    }

    private void PromptDeleteCompany(string coNo)
    {
        companyToDelete = coNo;
        showDeleteModal = true;
    }

    private async Task ConfirmDeleteCompanyAsync()
    {
        if (string.IsNullOrWhiteSpace(companyToDelete)) return;

        try
        {
            var (success, msg) = await ApiClient.DeleteCompanyAsync(companyToDelete);
            showDeleteModal = false;
            statusSuccess = success;
            statusMessage = msg;

            if (success)
            {
                companies = await ApiClient.GetCompanyDetailsAsync();
                if (selectedCoNo.Equals(companyToDelete, StringComparison.OrdinalIgnoreCase))
                {
                    selectedCoNo = companies.FirstOrDefault()?.CoNo ?? "1";
                    await LoadDataAsync();
                }
            }
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Failed to delete company: {ex.Message}";
        }
    }

