@page "/admin/general"
@page "/general"
@rendermode InteractiveServer
@inject HrApiClient ApiClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>General Settings - HRsuite</PageTitle>

<div class="general-settings-page pb-5">
    <!-- Top Header Bar -->
    <div class="page-top-bar d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-link text-dark p-0 text-decoration-none fs-4 d-inline-flex align-items-center back-arrow-btn" @onclick='() => NavManager.NavigateTo("admin")' title="Back to Admin">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div>
                <h4 class="mb-0 fw-bold d-flex align-items-center gap-2 text-dark">
                    <span class="general-icon-badge"><i class="bi bi-gear-wide-connected"></i></span>
                    <span>General Settings</span>
                </h4>
                <div class="text-muted small">Configure company profiles, mail server, OT, leave, and claim policies</div>
            </div>
        </div>

        <!-- Right Action Controls -->
        <div class="d-flex align-items-center gap-2">
            <!-- Company Selector -->
            <div class="d-flex align-items-center gap-1 bg-white px-2 py-1 rounded-3 border shadow-sm">
                <i class="bi bi-building text-success small"></i>
                <span class="small text-muted fw-semibold me-1">Company:</span>
                <select class="form-select form-select-sm border-0 bg-transparent fw-semibold" style="width: auto; min-width: 140px;" value="@selectedCoNo" @onchange="OnCompanySelected">
                    @foreach (var c in companies)
                    {
                        <option value="@c.CoNo">@c.CoNo - @c.CompanyName</option>
                    }
                </select>
            </div>

            <!-- Reload Button -->
            <button class="btn btn-sm btn-outline-secondary shadow-sm px-3" @onclick="LoadDataAsync" disabled="@isLoading" title="Refresh settings">
                <i class="bi bi-arrow-clockwise @(isLoading ? "spin" : "")"></i>
                <span class="d-none d-md-inline ms-1">Refresh</span>
            </button>

            <!-- Save All Settings Button -->
            <button class="btn btn-sm btn-success shadow-sm px-3 fw-semibold" @onclick="SaveSettingsAsync" disabled="@(isLoading || isSaving)" title="Save General Settings">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-floppy-fill me-1"></i>
                    <span>Save Settings</span>
                }
            </button>
        </div>
    </div>

    <!-- Status Message Alert Banner -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center gap-2 mb-3 shadow-sm" role="alert">
            <i class="bi @(statusSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-5"></i>
            <div class="flex-grow-1 small">@statusMessage</div>
            <button type="button" class="btn-close btn-close-sm" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Modern Navigation Tabs -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="settings-tabs-header border-bottom px-3 pt-2 bg-light bg-opacity-50">
            <ul class="nav nav-pills custom-settings-pills gap-1 flex-nowrap overflow-x-auto pb-2">
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "company" ? "active" : "")" @onclick='() => activeTab = "company"'>
                        <i class="bi bi-buildings-fill me-1"></i>
                        <span>Company Setting</span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill ms-1">@companies.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "general" ? "active" : "")" @onclick='() => activeTab = "general"'>
                        <i class="bi bi-envelope-at-fill me-1"></i>
                        <span>General & Email</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "ot" ? "active" : "")" @onclick='() => activeTab = "ot"'>
                        <i class="bi bi-clock-history me-1"></i>
                        <span>OT Setting</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "leave" ? "active" : "")" @onclick='() => activeTab = "leave"'>
                        <i class="bi bi-calendar2-check-fill me-1"></i>
                        <span>Leave Setting</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "claim" ? "active" : "")" @onclick='() => activeTab = "claim"'>
                        <i class="bi bi-receipt-cutoff me-1"></i>
                        <span>Claim Setting</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            @if (isLoading)
            {
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-success mb-3" role="status"></div>
                    <div>Loading system configuration...</div>
                </div>
            }
            else
            {
                <!-- ========================================== -->
                <!-- TAB 1: COMPANY SETTING                     -->
                <!-- ========================================== -->
                @if (activeTab == "company")
                {
                    <div class="tab-pane-content animate-fade-in">
                        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Registered Companies Directory</h6>
                                <p class="text-muted small mb-0">Multi-company setup and corporate contact profiles</p>
                            </div>
                            <button class="btn btn-sm btn-success px-3 shadow-sm" @onclick="OpenAddCompanyModal">
                                <i class="bi bi-plus-circle-fill me-1"></i>
                                <span>Add New Company</span>
                            </button>
                        </div>

                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0 custom-company-table">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 80px;">Co No</th>
                                        <th style="min-width: 180px;">Company Name</th>
                                        <th style="min-width: 220px;">Address</th>
                                        <th style="width: 130px;">Contact</th>
                                        <th style="min-width: 160px;">Email</th>
                                        <th style="min-width: 140px;">Website</th>
                                        <th style="width: 140px;" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (companies.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">No companies configured.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var comp in companies)
                                        {
                                            var isSelected = comp.CoNo.Equals(selectedCoNo, StringComparison.OrdinalIgnoreCase);
                                            <tr class="@(isSelected ? "table-active-row" : "")">
                                                <td>
                                                    <span class="badge @(comp.CoNo == "1" ? "bg-primary" : "bg-secondary")">@comp.CoNo</span>
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark">@comp.CompanyName</div>
                                                    @if (isSelected)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success extra-small">Active In View</span>
                                                    }
                                                </td>
                                                <td class="small text-secondary">
                                                    <div>@comp.Add1</div>
                                                    @if (!string.IsNullOrWhiteSpace(comp.Add2))
                                                    {
                                                        <div>@comp.Add2</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(comp.Add3))
                                                    {
                                                        <div>@comp.Add3</div>
                                                    }
                                                </td>
                                                <td class="small">
                                                    @if (!string.IsNullOrWhiteSpace(comp.Tel))
                                                    {
                                                        <div><i class="bi bi-telephone text-muted me-1"></i>@comp.Tel</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(comp.Fax))
                                                    {
                                                        <div><i class="bi bi-printer text-muted me-1"></i>@comp.Fax</div>
                                                    }
                                                </td>
                                                <td class="small">
                                                    @if (!string.IsNullOrWhiteSpace(comp.Email))
                                                    {
                                                        <a href="mailto:@comp.Email" class="text-decoration-none text-primary">@comp.Email</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="small">
                                                    @if (!string.IsNullOrWhiteSpace(comp.HttpMain))
                                                    {
                                                        <a href="@comp.HttpMain" target="_blank" class="text-decoration-none text-truncate d-inline-block" style="max-width: 140px;">@comp.HttpMain</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary" @onclick="() => OpenEditCompanyModal(comp)" title="Edit Company Details">
                                                            <i class="bi bi-pencil-fill"></i>
                                                        </button>
                                                        @if (comp.CoNo != "1")
                                                        {
                                                            <button class="btn btn-outline-danger" @onclick="() => PromptDeleteCompany(comp.CoNo)" title="Delete Company">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- ========================================== -->
                <!-- TAB 2: GENERAL & EMAIL SETTING             -->
                <!-- ========================================== -->
                @if (activeTab == "general")
                {
                    <div class="tab-pane-content animate-fade-in">
                        <div class="row g-4">
                            <!-- Email Server Configuration Card -->
                            <div class="col-12 col-lg-7">
                                <div class="card border rounded-3 h-100 shadow-sm">
                                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-mailbox2 text-success fs-5"></i>
                                            <h6 class="mb-0 fw-bold text-dark">Email Server Configuration</h6>
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary px-3" @onclick="TestEmailConnectionAsync" disabled="@isTestingEmail" title="Test SMTP Server Connection">
                                            @if (isTestingEmail)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                <span>Testing...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-broadcast me-1"></i>
                                                <span>Test Connection</span>
                                            }
                                        </button>
                                    </div>
                                    <div class="card-body p-3">
                                        @if (!string.IsNullOrEmpty(testEmailResult))
                                        {
                                            <div class="alert @(testEmailSuccess ? "alert-success" : "alert-warning") alert-dismissible fade show small p-2 mb-3" role="alert">
                                                <i class="bi @(testEmailSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-1"></i>
                                                <span>@testEmailResult</span>
                                                <button type="button" class="btn-close btn-close-sm" @onclick="() => testEmailResult = null"></button>
                                            </div>
                                        }

                                        <!-- Email Type Radio -->
                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-semibold">Email Type</label>
                                            <div class="d-flex gap-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="emailType" id="etSmtp" value="0" checked="@(model.EmailType == "0")" @onchange='() => model.EmailType = "0"' />
                                                    <label class="form-check-label fw-semibold" for="etSmtp">Standard SMTP Server</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="emailType" id="etExch" value="1" checked="@(model.EmailType == "1")" @onchange='() => model.EmailType = "1"' />
                                                    <label class="form-check-label fw-semibold" for="etExch">Exchange Server</label>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Server & Port -->
                                        <div class="row g-2 mb-3">
                                            <div class="col-8">
                                                <label class="form-label small text-muted fw-semibold">Server / Hosting Host</label>
                                                <input type="text" class="form-control form-control-sm" placeholder="e.g. mail.company.com or 192.168.1.10" @bind="model.EmailServer" />
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label small text-muted fw-semibold">Port</label>
                                                <input type="text" class="form-control form-control-sm" placeholder="25" @bind="model.EmailPort" />
                                            </div>
                                        </div>

                                        <!-- Domain & SSL -->
                                        <div class="row g-2 mb-3 align-items-center">
                                            <div class="col-8">
                                                <label class="form-label small text-muted fw-semibold">Domain (if required)</label>
                                                <input type="text" class="form-control form-control-sm" placeholder="e.g. yourdomain.local" @bind="model.EmailDomain" />
                                            </div>
                                            <div class="col-4 pt-3">
                                                <div class="form-check form-switch mt-2">
                                                    <input class="form-check-input" type="checkbox" id="sslSwitch" checked="@(model.EmailSSL == "Y")" @onchange='(e) => model.EmailSSL = (bool)(e.Value ?? false) ? "Y" : "N"' />
                                                    <label class="form-check-label fw-semibold small" for="sslSwitch">Enable SSL</label>
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-3 opacity-25" />

                                        <!-- Credentials & Sender -->
                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-semibold">Sender Company Email</label>
                                            <input type="email" class="form-control form-control-sm" placeholder="noreply@company.com" @bind="model.CompanyEmail" />
                                        </div>

                                        <div class="row g-2 mb-2">
                                            <div class="col-6">
                                                <label class="form-label small text-muted fw-semibold">Username</label>
                                                <input type="text" class="form-control form-control-sm" placeholder="Username" @bind="model.EmailUserName" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small text-muted fw-semibold">Password</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="@(showPassword ? "text" : "password")" class="form-control" placeholder="••••••••" @bind="model.EmailPassword" />
                                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => showPassword = !showPassword">
                                                        <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Logging, Paths, & Security Policies -->
                            <div class="col-12 col-lg-5">
                                <div class="d-flex flex-column gap-3">
                                    <!-- Log File Settings Card -->
                                    <div class="card border rounded-3 shadow-sm">
                                        <div class="card-header bg-white py-2 px-3 border-bottom d-flex align-items-center gap-2">
                                            <i class="bi bi-file-earmark-text text-warning fs-6"></i>
                                            <h6 class="mb-0 fw-bold small text-dark">Log File Settings</h6>
                                        </div>
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="small fw-semibold text-muted">Enable Log File Recording</span>
                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input" type="checkbox" id="logSwitch" checked="@(model.OpenMsg == "Y")" @onchange='(e) => model.OpenMsg = (bool)(e.Value ?? false) ? "Y" : "N"' />
                                                </div>
                                            </div>
                                            <div>
                                                <label class="form-label small text-muted fw-semibold">Log File Storage Path</label>
                                                <input type="text" class="form-control form-control-sm" placeholder="c:\logfile" @bind="model.LogFilePath" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Network & Date Format Card -->
                                    <div class="card border rounded-3 shadow-sm">
                                        <div class="card-header bg-white py-2 px-3 border-bottom d-flex align-items-center gap-2">
                                            <i class="bi bi-hdd-network text-info fs-6"></i>
                                            <h6 class="mb-0 fw-bold small text-dark">Network & Date Formatting</h6>
                                        </div>
                                        <div class="card-body p-3">
                                            <div class="mb-2">
                                                <label class="form-label small text-muted fw-semibold">Localhost URL / Address</label>
                                                <input type="text" class="form-control form-control-sm" placeholder="http://localhost:5103" @bind="model.LocalhostAdd" />
                                                <div class="form-text extra-small">Base URL used to format notification and email approval links.</div>
                                            </div>
                                            <div>
                                                <label class="form-label small text-muted fw-semibold">Application Date Time Format</label>
                                                <input type="text" class="form-control form-control-sm" placeholder="yyyy-MM-dd" @bind="model.DatetimeFormat" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Security & Policies Card -->
                                    <div class="card border rounded-3 shadow-sm">
                                        <div class="card-header bg-white py-2 px-3 border-bottom d-flex align-items-center gap-2">
                                            <i class="bi bi-shield-lock-fill text-danger fs-6"></i>
                                            <h6 class="mb-0 fw-bold small text-dark">Security & Feature Policies</h6>
                                        </div>
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                                <div>
                                                    <div class="small fw-semibold text-dark">Allow Email Direct Link Login</div>
                                                    <div class="extra-small text-muted">Users can approve directly via tokenized email links without password prompt.</div>
                                                </div>
                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input" type="checkbox" id="directLinkSwitch" checked="@(model.AllowEmaildirectlink == "Y")" @onchange='(e) => model.AllowEmaildirectlink = (bool)(e.Value ?? false) ? "Y" : "N"' />
                                                </div>
                                            </div>

                                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                                <div>
                                                    <div class="small fw-semibold text-dark">Password Required for Payslip</div>
                                                    <div class="extra-small text-muted">Enforce password check before decrypting or downloading payslip PDF.</div>
                                                </div>
                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input" type="checkbox" id="payslipPwdSwitch" checked="@(model.PasswordPayslip == "Y")" @onchange='(e) => model.PasswordPayslip = (bool)(e.Value ?? false) ? "Y" : "N"' />
                                                </div>
                                            </div>

                                            <div class="d-flex align-items-center justify-content-between pt-2">
                                                <div>
                                                    <div class="small fw-semibold text-dark">Allow Employee Password & Email Updates</div>
                                                    <div class="extra-small text-muted">Permit employees to update personal email and credentials in self-service.</div>
                                                </div>
                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input" type="checkbox" id="modifyPwdSwitch" checked="@(model.Offpwdemailmodify == "Y")" @onchange='(e) => model.Offpwdemailmodify = (bool)(e.Value ?? false) ? "Y" : "N"' />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ========================================== -->
                <!-- TAB 3: OT (OVERTIME) SETTING               -->
                <!-- ========================================== -->
                @if (activeTab == "ot")
                {
                    <div class="tab-pane-content animate-fade-in">
                        <div class="row g-4">
                            <!-- Left: General OT Policies -->
                            <div class="col-12 col-lg-7">
                                <div class="card border rounded-3 h-100 shadow-sm">
                                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                                        <i class="bi bi-clock-history text-success fs-5"></i>
                                        <h6 class="mb-0 fw-bold text-dark">Overtime (OT) General Rules</h6>
                                    </div>
                                    <div class="card-body p-3">
                                        <!-- Active Time & Insert Type -->
                                        <div class="row g-3 mb-3">
                                            <div class="col-6">
                                                <label class="form-label small text-muted fw-semibold">OT Active Date (From)</label>
                                                <input type="date" class="form-control form-control-sm" value="@(model.OTDateFrom?.ToString("yyyy-MM-dd"))" @onchange="OnOTDateChanged" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small text-muted fw-semibold">OT Insert Type</label>
                                                <div class="d-flex gap-3 pt-1">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="otInsertType" id="otitH" value="H" checked="@(model.OTInsertType == "H")" @onchange='() => model.OTInsertType = "H"' />
                                                        <label class="form-check-label small fw-semibold" for="otitH">Hour Type</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="otInsertType" id="otitT" value="T" checked="@(model.OTInsertType == "T")" @onchange='() => model.OTInsertType = "T"' />
                                                        <label class="form-check-label small fw-semibold" for="otitT">Time Type</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Break Time Generation Mode -->
                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-semibold">Break Time Generation Mode</label>
                                            <div class="d-flex gap-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="otBreakType" id="btA" value="A" checked="@(model.OTBreakTimeType == "A")" @onchange='() => model.OTBreakTimeType = "A"' />
                                                    <label class="form-check-label small fw-semibold" for="btA">Auto Calculate</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="otBreakType" id="btM" value="M" checked="@(model.OTBreakTimeType == "M")" @onchange='() => model.OTBreakTimeType = "M"' />
                                                    <label class="form-check-label small fw-semibold" for="btM">Manual Input</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="otBreakType" id="btD" value="D" checked="@(model.OTBreakTimeType == "D")" @onchange='() => model.OTBreakTimeType = "D"' />
                                                    <label class="form-check-label small fw-semibold" for="btD">Define (Custom Schedule)</label>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- OT Break Time Definition -->
                                        <div class="mb-3">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <label class="form-label small text-muted fw-semibold mb-0">Break Time Definition Syntax</label>
                                                <button type="button" class="btn btn-xs btn-outline-info" @onclick="() => showBreakTimeHelperModal = true">
                                                    <i class="bi bi-question-circle me-1"></i>Syntax Guide & Examples
                                                </button>
                                            </div>
                                            <textarea class="form-control font-monospace small" rows="5" placeholder="e.g. 12:00-13:00=60;18:00-18:30=30;" @bind="model.OTBreakTimeDefinition"></textarea>
                                            <div class="form-text extra-small">Custom break schedule applied when break time mode is set to 'Define'.</div>
                                        </div>

                                        <hr class="my-3 opacity-25" />

                                        <!-- Code Type & Limits -->
                                        <div class="row g-3">
                                            <div class="col-6">
                                                <label class="form-label small text-muted fw-semibold">OT Code Selection</label>
                                                <div class="d-flex gap-3 pt-1">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="otCodeSelect" id="otcsY" value="Y" checked="@(model.OTCodeSelect == "Y")" @onchange='() => model.OTCodeSelect = "Y"' />
                                                        <label class="form-check-label small fw-semibold" for="otcsY">Select from List</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="otCodeSelect" id="otcsN" value="N" checked="@(model.OTCodeSelect == "N")" @onchange='() => model.OTCodeSelect = "N"' />
                                                        <label class="form-check-label small fw-semibold" for="otcsN">Fixed Code</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small text-muted fw-semibold">Max OT Allowed Per Day (Hours)</label>
                                                <div class="input-group input-group-sm" style="max-width: 140px;">
                                                    <input type="number" min="1" max="24" class="form-control" @bind="model.TotalOtAllowPerDay" />
                                                    <span class="input-group-text">hrs</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-3">
                                            <label class="form-label small text-muted fw-semibold">OT Reason Assignment</label>
                                            <div class="d-flex gap-3 pt-1">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="otReason" id="otrY" value="Y" checked="@(model.OTReason == "Y")" @onchange='() => model.OTReason = "Y"' />
                                                    <label class="form-check-label small fw-semibold" for="otrY">Auto Populate</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="otReason" id="otrN" value="N" checked="@(model.OTReason == "N")" @onchange='() => model.OTReason = "N"' />
                                                    <label class="form-check-label small fw-semibold" for="otrN">Manual Entry</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Processing Delays -->
                            <div class="col-12 col-lg-5">
                                <div class="card border rounded-3 shadow-sm">
                                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                                        <i class="bi bi-hourglass-split text-warning fs-5"></i>
                                        <h6 class="mb-0 fw-bold text-dark">OT Processing & Submission Delay</h6>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                            <div>
                                                <div class="small fw-semibold text-dark">Unlimited Submission Delay</div>
                                                <div class="extra-small text-muted">When enabled, employees can submit OT without interval cutoff restriction.</div>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="otSubUnl" checked="@(model.OTSubmitUnlimited == "Y")" @onchange='(e) => model.OTSubmitUnlimited = (bool)(e.Value ?? false) ? "Y" : "N"' />
                                            </div>
                                        </div>

                                        <div>
                                            <label class="form-label small text-muted fw-semibold">Submission Interval Buffer (Minutes)</label>
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="5" min="0" class="form-control" @bind="model.OTPendingProcessInterval" />
                                                <span class="input-group-text">mins</span>
                                            </div>
                                            <div class="form-text extra-small">Minimum interval between applying pending OT and processing now (default: 300 mins).</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ========================================== -->
                <!-- TAB 4: LEAVE SETTING                       -->
                <!-- ========================================== -->
