                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="timemanSwitch" checked="@(model.OpenMysqlSchd == "Y")" @onchange='(e) => model.OpenMysqlSchd = (bool)(e.Value ?? false) ? "Y" : "N"' />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6">
                                <div class="card border rounded-3 shadow-sm h-100">
                                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                                        <i class="bi bi-bell-fill text-warning fs-5"></i>
                                        <h6 class="mb-0 fw-bold text-dark">Daily Email Reminder Setup</h6>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                            <div>
                                                <div class="small fw-semibold text-dark">Enable Daily Leave Reminder Email</div>
                                                <div class="extra-small text-muted">Trigger automatic notification emails to managers and pending approvers.</div>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="remindSwitch" checked="@(model.AllowLeaveRemindTimeGeneral == "Y")" @onchange='(e) => model.AllowLeaveRemindTimeGeneral = (bool)(e.Value ?? false) ? "Y" : "N"' />
                                            </div>
                                        </div>

                                        <div>
                                            <label class="form-label small text-muted fw-semibold">Scheduled Reminder Time (24h:min:sec)</label>
                                            <div class="input-group input-group-sm" style="max-width: 220px;">
                                                <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                                <input type="text" class="form-control" placeholder="13:00:00" @bind="model.LeaveRemindTimeGeneral" />
                                            </div>
                                            <div class="form-text extra-small">Example: <code>13:00:00</code> means emails are dispatched daily at 1:00 PM.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
