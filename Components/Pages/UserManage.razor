                        <div class="col-12">
                            <label class="form-label small fw-bold">EA Form Group (EA Grp ID)</label>
                            <select class="form-select form-select-sm" @bind="currentUser.EAFORMGroupID">
                                <option value="">(None)</option>
                                @foreach (var g in eaGroups)
                                {
                                    <option value="@g.UserGroupID">@(string.IsNullOrWhiteSpace(g.UserGroup) || g.UserGroup.Equals(g.UserGroupID, StringComparison.OrdinalIgnoreCase) ? g.UserGroupID : $"{g.UserGroupID} - {g.UserGroup}")</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold">Staff Group (Staff Grp ID)</label>
                            <select class="form-select form-select-sm" @bind="currentUser.UserGroupID">
                                <option value="">(None)</option>
                                @foreach (var g in staffGroups)
                                {
                                    <option value="@g.UserGroupID">@(string.IsNullOrWhiteSpace(g.UserGroup) || g.UserGroup.Equals(g.UserGroupID, StringComparison.OrdinalIgnoreCase) ? g.UserGroupID : $"{g.UserGroupID} - {g.UserGroup}")</option>
                                }
