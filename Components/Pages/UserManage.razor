                        <div class="col-12">
                            <label class="form-label small fw-bold">Payslip Group (Payslip Grp ID)</label>
                            <select class="form-select form-select-sm" @bind="currentUser.PayslipUserGroupID">
                                <option value="">(None)</option>
                                @foreach (var g in payslipGroups)
                                {
                                    <option value="@g.UserGroupID">@(string.IsNullOrWhiteSpace(g.UserGroup) || g.UserGroup.Equals(g.UserGroupID, StringComparison.OrdinalIgnoreCase) ? g.UserGroupID : $"{g.UserGroupID} - {g.UserGroup}")</option>
