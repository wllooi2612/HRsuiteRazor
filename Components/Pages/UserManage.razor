                    </div>
                </div>
                <div class="card-footer py-3 px-4 bg-light d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseFormView">Cancel</button>
                    <button type="button" class="btn @(isEditMode ? "btn-primary" : "btn-success") px-4 fw-semibold" @onclick="RequestSaveUser" disabled="@isSubmitting">
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>@(isEditMode ? "Update Record" : "Save Record")</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- MODAL: CONFIRMATION BEFORE SAVE/UPDATE -->
    @if (isConfirmSaveModalOpen)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content border-0 shadow-lg rounded-3">
                    <div class="modal-header @(isEditMode ? "bg-primary text-white" : "bg-success text-white") py-2 px-3">
                        <h6 class="modal-title fw-bold">
                            <i class="bi bi-question-circle me-1"></i> Confirmation
                        </h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => isConfirmSaveModalOpen = false"></button>
                    </div>
                    <div class="modal-body p-4 text-center">
                        <div class="mb-3">
                            <i class="bi bi-question-circle-fill text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h6 class="fw-bold mb-2">Are you sure you want to continue?</h6>
                        <p class="small text-muted mb-0">
                            @(isEditMode 
                                ? $"Are you sure you want to update user '{currentUser.ID}'?" 
                                : $"Are you sure you want to add new user '{currentUser.ID}'?")
                        </p>
                    </div>
                    <div class="modal-footer py-2 px-3 bg-light justify-content-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" @onclick="() => isConfirmSaveModalOpen = false" disabled="@isSubmitting">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-sm @(isEditMode ? "btn-primary" : "btn-success") px-4 fw-semibold" @onclick="ConfirmAndSaveUserAsync" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-1"></i>
                                <span>Confirm</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- MODAL 2: UPDATE COMPANY ID MODAL (Bulk Action) -->
    @if (isCompanyModalOpen)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-3">
                    <div class="modal-header bg-info text-dark py-2 px-3">
                        <h6 class="modal-title fw-bold">
                            <i class="bi bi-building me-1"></i> Update Company ID (CoNo)
                        </h6>
                        <button type="button" class="btn-close" @onclick='() => isCompanyModalOpen = false'></button>
                    </div>
                    <div class="modal-body p-3">
                        <p class="small text-muted mb-2">Update the Company ID (CoNo) for the <strong>@SelectedCount</strong> selected user(s):</p>
                        <select class="form-select form-select-sm" @bind="bulkCoNo">
                            @foreach (var comp in companyList)
                            {
                                <option value="@comp.CoNo">@comp.CoNo - @comp.CompanyName</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer py-2 px-3 bg-light">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => isCompanyModalOpen = false'>Cancel</button>
                        <button type="button" class="btn btn-sm btn-info px-4 fw-semibold" @onclick="ExecuteBulkUpdateCoNoAsync">
                            Apply Update
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? EditUserId { get; set; }

    [SupplyParameterFromQuery]
    public string? Action { get; set; }

    [SupplyParameterFromQuery]
    public string? Edit { get; set; }

    private string viewMode = "table"; // "table" or "cards"
    private bool showFilters = false;
    private bool isLoading = true;
    private bool isSubmitting = false;

    private List<AdminUserModel> usersList = new();
    private AdminUserModel? activeUser;
    private HashSet<string> selectedUserIds = new();

    private string? statusMessage;
    private bool statusSuccess = true;

    // Filters
    private string globalSearchText = "";
    private string? filterStatus = null;

    // Per-column filters (matching old DevExpress grid)
    private string colFilterCoNo = "";
    private string colFilterId = "";
    private string colFilterName = "";
    private string colFilterEmpId = "";
    private string colFilterActive = "";
    private string colFilterOT = "";
    private string colFilterLeave = "";
    private string colFilterAttn = "";
    private string colFilterPayslip = "";
    private string colFilterClaim = "";
    private string colFilterEA = "";
    private string colFilterStaff = "";
    private string colFilterEmail = "";

    // Page Views
    private bool isFormView = false;
    private bool isFormModalOpen => isFormView;
    private bool isEditMode = false;
    private AdminUserModel currentUser = new();
    private bool isConfirmSaveModalOpen = false;
    private string? formErrorMessage;

    private bool isCompanyModalOpen = false;
    private string bulkCoNo = "ID";

    // Dynamic Lookups from MySQL (aspnet_usergroup, aspnet_general, dw_emp)
    private List<UserGroupModel> allGroups = new();
    private List<CompanyModel> companyList = new();
    private List<EmployeeLookupModel> employeeList = new();

    private IEnumerable<UserGroupModel> leaveGroups => allGroups.Where(g => g.GroupID.Equals("LEAVE", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<UserGroupModel> otGroups => allGroups.Where(g => g.GroupID.Equals("OT", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<UserGroupModel> attnGroups => allGroups.Where(g => g.GroupID.Equals("ATTENDANCE", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<UserGroupModel> payslipGroups => allGroups.Where(g => g.GroupID.Equals("PAYSLIP", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<UserGroupModel> claimGroups => allGroups.Where(g => g.GroupID.Equals("CLAIM", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<UserGroupModel> eaGroups => allGroups.Where(g => g.GroupID.Equals("EAFORM", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<UserGroupModel> staffGroups => allGroups.Where(g => g.GroupID.Equals("STAFF", StringComparison.OrdinalIgnoreCase));

    private int SelectedCount => selectedUserIds.Count;
    private bool IsAllSelected => usersList.Count > 0 && selectedUserIds.Count == FilteredUsers.Count;

    private List<AdminUserModel> FilteredUsers
    {
        get
        {
            return usersList.Where(u =>
                // Global search
                (string.IsNullOrWhiteSpace(globalSearchText) ||
                 u.ID.Contains(globalSearchText, StringComparison.OrdinalIgnoreCase) ||
                 u.Name.Contains(globalSearchText, StringComparison.OrdinalIgnoreCase) ||
                 (u.EmpId != null && u.EmpId.Contains(globalSearchText, StringComparison.OrdinalIgnoreCase)) ||
                 (u.Email != null && u.Email.Contains(globalSearchText, StringComparison.OrdinalIgnoreCase))) &&

                // Top Status pill
                (string.IsNullOrEmpty(filterStatus) || u.IsActive == filterStatus) &&

                // Column-level filters
                (string.IsNullOrEmpty(colFilterCoNo) || (u.CoNo != null && u.CoNo.Contains(colFilterCoNo, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrEmpty(colFilterId) || u.ID.Contains(colFilterId, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(colFilterName) || u.Name.Contains(colFilterName, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(colFilterEmpId) || (u.EmpId != null && u.EmpId.Contains(colFilterEmpId, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrEmpty(colFilterActive) || u.IsActive == colFilterActive) &&
                (string.IsNullOrEmpty(colFilterOT) || (u.OTUserGroupID != null && u.OTUserGroupID.Contains(colFilterOT, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrEmpty(colFilterLeave) || (u.LeaveUserGroupID != null && u.LeaveUserGroupID.Contains(colFilterLeave, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrEmpty(colFilterAttn) || (u.AttnUserGroupID != null && u.AttnUserGroupID.Contains(colFilterAttn, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrEmpty(colFilterPayslip) || (u.PayslipUserGroupID != null && u.PayslipUserGroupID.Contains(colFilterPayslip, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrEmpty(colFilterClaim) || (u.ClaimUserGroupID != null && u.ClaimUserGroupID.Contains(colFilterClaim, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrEmpty(colFilterEA) || (u.EAFORMGroupID != null && u.EAFORMGroupID.Contains(colFilterEA, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrEmpty(colFilterStaff) || (u.UserGroupID != null && u.UserGroupID.Contains(colFilterStaff, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrEmpty(colFilterEmail) || (u.Email != null && u.Email.Contains(colFilterEmail, StringComparison.OrdinalIgnoreCase)))
            ).ToList();
        }
    }

    private string? EffectiveEditId => !string.IsNullOrEmpty(EditUserId) ? EditUserId : Edit;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadUsersAsync(),
            LoadLookupsAsync()
        );

        ApplyRouteParameters();
    }

    protected override void OnParametersSet()
    {
        ApplyRouteParameters();
    }

    private void ApplyRouteParameters()
    {
        if (!string.IsNullOrEmpty(EffectiveEditId) && usersList.Count > 0)
        {
            if (!isFormView || currentUser.ID != EffectiveEditId)
            {
                var u = usersList.FirstOrDefault(x => x.ID.Equals(EffectiveEditId, StringComparison.OrdinalIgnoreCase));
                if (u != null)
                {
                    StartEditUser(u, syncUrl: false);
                }
            }
        }
        else if ((string.Equals(Action, "new", StringComparison.OrdinalIgnoreCase) || NavManager.Uri.EndsWith("/new", StringComparison.OrdinalIgnoreCase)))
        {
            if (!isFormView || isEditMode)
            {
                OpenAddUserView(syncUrl: false);
            }
        }
        else if (string.IsNullOrEmpty(EffectiveEditId) && !string.Equals(Action, "new", StringComparison.OrdinalIgnoreCase) && !NavManager.Uri.EndsWith("/new", StringComparison.OrdinalIgnoreCase))
        {
            isFormView = false;
        }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            allGroups = await ApiClient.GetAdminGroupsAsync();
            companyList = await ApiClient.GetCompaniesAsync();
            employeeList = await ApiClient.GetEmployeesAsync();

            if (companyList.Count > 0 && (string.IsNullOrEmpty(bulkCoNo) || bulkCoNo == "ID"))
            {
                bulkCoNo = companyList[0].CoNo;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading lookup data: " + ex.Message);
        }
    }

    private void OnEmpIdChanged()
    {
        if (!string.IsNullOrWhiteSpace(currentUser.EmpId))
        {
            var matchedEmp = employeeList.FirstOrDefault(e => e.EmpId.Equals(currentUser.EmpId, StringComparison.OrdinalIgnoreCase));
            if (matchedEmp != null)
            {
                if (string.IsNullOrWhiteSpace(currentUser.Name))
                {
                    currentUser.Name = matchedEmp.Name;
                }
                if (!isEditMode && string.IsNullOrWhiteSpace(currentUser.ID))
                {
                    currentUser.ID = matchedEmp.EmpId;
                }
            }
        }
    }

    private async Task LoadUsersAsync(bool keepStatus = false)
    {
        isLoading = true;
        if (!keepStatus)
        {
            statusMessage = null;
        }
        try
        {
            usersList = await ApiClient.GetAdminUsersAsync();
        }
        catch (Exception ex)
        {
            statusMessage = "Error loading users: " + ex.Message;
            statusSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectRow(AdminUserModel user)
    {
        activeUser = user;
    }

    private void ToggleUserSelection(string userId, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked) selectedUserIds.Add(userId);
        else selectedUserIds.Remove(userId);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        selectedUserIds.Clear();
        if (isChecked)
        {
            foreach (var u in FilteredUsers)
            {
                selectedUserIds.Add(u.ID);
            }
        }
    }

    private void OpenAddUserModal()
    {
        OpenAddUserView(syncUrl: true);
    }

    private void OpenAddUserView(bool syncUrl = true)
    {
        currentUser = new AdminUserModel
        {
            IsActive = "Y",
            CoNo = companyList.FirstOrDefault()?.CoNo ?? "ID",
            UserGroupID = staffGroups.FirstOrDefault()?.UserGroupID ?? "",
            LeaveUserGroupID = leaveGroups.FirstOrDefault()?.UserGroupID ?? "",
            Password = "123"
        };
        isEditMode = false;
        isFormView = true;
        if (syncUrl)
        {
            NavManager.NavigateTo("admin/users?action=new");
        }
    }

    private void StartEditUser(AdminUserModel user, bool syncUrl = true)
    {
        currentUser = new AdminUserModel
        {
            ID = user.ID,
            Name = user.Name,
            Email = user.Email,
            EmpId = user.EmpId,
            CoNo = string.IsNullOrEmpty(user.CoNo) ? "ID" : user.CoNo,
            IsActive = user.IsActive,
            OTUserGroupID = user.OTUserGroupID,
            LeaveUserGroupID = user.LeaveUserGroupID,
            AttnUserGroupID = user.AttnUserGroupID,
            PayslipUserGroupID = user.PayslipUserGroupID,
            ClaimUserGroupID = user.ClaimUserGroupID,
            EAFORMGroupID = user.EAFORMGroupID,
            UserGroupID = user.UserGroupID,
            Remark = user.Remark,
            Password = ""
        };
        isEditMode = true;
        isFormView = true;
        if (syncUrl)
        {
            NavManager.NavigateTo($"admin/users?edit={Uri.EscapeDataString(user.ID)}");
        }
    }

    private void StartEditUser(AdminUserModel user) => StartEditUser(user, syncUrl: true);

    private void CloseFormView()
    {
        isFormView = false;
        isConfirmSaveModalOpen = false;
        currentUser = new AdminUserModel();
        formErrorMessage = null;
        NavManager.NavigateTo("admin/users");
    }

    private void CloseFormModal() => CloseFormView();

    private void RequestSaveUser()
    {
        if (string.IsNullOrWhiteSpace(currentUser.ID) || string.IsNullOrWhiteSpace(currentUser.Name))
        {
            formErrorMessage = "User ID and Full Name are required.";
            return;
        }

        formErrorMessage = null;
        isConfirmSaveModalOpen = true;
    }

    private async Task ConfirmAndSaveUserAsync()
    {
        isSubmitting = true;
        formErrorMessage = null;

        try
        {
            if (isEditMode)
            {
                var (ok, errMsg) = await ApiClient.UpdateAdminUserWithDetailsAsync(currentUser.ID, currentUser);
                if (ok)
                {
                    statusMessage = $"User record '{currentUser.ID}' updated successfully!";
                    statusSuccess = true;
                    CloseFormView();
                    await LoadUsersAsync(keepStatus: true);
                }
                else
                {
                    isConfirmSaveModalOpen = false;
                    formErrorMessage = !string.IsNullOrWhiteSpace(errMsg) ? errMsg : "Web API error updating user record.";
                }
            }
            else
            {
                bool ok = await ApiClient.CreateAdminUserAsync(currentUser);
                if (ok)
                {
                    statusMessage = $"New user '{currentUser.ID}' created successfully!";
                    statusSuccess = true;
                    CloseFormView();
                    await LoadUsersAsync(keepStatus: true);
                }
                else
                {
                    isConfirmSaveModalOpen = false;
                    formErrorMessage = "Web API error: User ID may already exist.";
                }
            }
        }
        catch (Exception ex)
        {
            isConfirmSaveModalOpen = false;
            formErrorMessage = "Error saving user: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ToggleUserActiveStatus(AdminUserModel user)
    {
        string newStatus = (user.IsActive == "Y") ? "N" : "Y";
        user.IsActive = newStatus;

        try
        {
            bool ok = await ApiClient.UpdateAdminUserAsync(user.ID, user);
            if (ok)
            {
                statusMessage = $"User '{user.ID}' active status toggled to '{newStatus}'.";
                statusSuccess = true;
            }
            else
            {
                statusMessage = $"Failed to toggle status for '{user.ID}'.";
                statusSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Error: " + ex.Message;
            statusSuccess = false;
        }
    }

    private async Task DeleteSelectedUsersAsync()
    {
        if (SelectedCount == 0) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the {SelectedCount} selected user(s)?");
        if (!confirmed) return;

        int deletedCount = 0;
        foreach (var id in selectedUserIds.ToList())
        {
            bool ok = await ApiClient.DeleteAdminUserAsync(id);
            if (ok) deletedCount++;
        }

        selectedUserIds.Clear();
        statusMessage = $"Successfully deleted {deletedCount} user(s).";
        statusSuccess = true;
        await LoadUsersAsync();
    }

    private async Task ResetSelectedUserPassword()
    {
        string? singleId = selectedUserIds.FirstOrDefault();
        if (string.IsNullOrEmpty(singleId)) return;

        try
        {
            string? tempPwd = await ApiClient.ResetUserPasswordAsync(singleId);
            if (!string.IsNullOrEmpty(tempPwd))
            {
                statusMessage = $"Password for '{singleId}' reset successfully! Temporary Password: {tempPwd}";
                statusSuccess = true;
            }
            else
            {
                statusMessage = $"Failed to reset password for '{singleId}'.";
                statusSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Error: " + ex.Message;
            statusSuccess = false;
        }
    }

    private async Task ResetPassword(AdminUserModel user)
    {
        try
        {
            string? tempPwd = await ApiClient.ResetUserPasswordAsync(user.ID);
            if (!string.IsNullOrEmpty(tempPwd))
            {
                statusMessage = $"Password for '{user.ID}' reset! Temporary Password: {tempPwd}";
                statusSuccess = true;
            }
            else
            {
                statusMessage = $"Failed to reset password for '{user.ID}'.";
                statusSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Error: " + ex.Message;
            statusSuccess = false;
        }
    }

    private void OpenUpdateCompanyModal()
    {
        isCompanyModalOpen = true;
    }

    private async Task ExecuteBulkUpdateCoNoAsync()
    {
        if (string.IsNullOrWhiteSpace(bulkCoNo)) return;

        int updated = 0;
        foreach (var id in selectedUserIds.ToList())
        {
            var user = usersList.FirstOrDefault(u => u.ID == id);
            if (user != null)
            {
                user.CoNo = bulkCoNo;
                bool ok = await ApiClient.UpdateAdminUserAsync(id, user);
                if (ok) updated++;
            }
        }

        isCompanyModalOpen = false;
        statusMessage = $"Updated Company ID (CoNo='{bulkCoNo}') for {updated} user(s).";
        statusSuccess = true;
        await LoadUsersAsync();
    }

    private void SendNotificationEmail()
    {
        statusMessage = $"Notification email dispatched to {SelectedCount} selected user(s).";
        statusSuccess = true;
    }

    private void PrintUsers()
    {
        statusMessage = "Print view ready. You can use your browser's Print dialog (Ctrl+P) to print the user list.";
        statusSuccess = true;
    }
}

