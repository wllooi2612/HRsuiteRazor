@page "/admin/users"
@page "/users"
@page "/admin/users/edit/{EditUserId}"
@page "/admin/users/new"
@rendermode InteractiveServer
@inject HrApiClient ApiClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>User Management - HRsuite</PageTitle>

<div class="user-management-page">
    @if (!isFormView)
    {
        <!-- Top Header Bar (Matching Image 2: Clean back arrow and title, no unneeded subtitle) -->
        <div class="page-top-bar d-flex align-items-center gap-3 mb-3">
            <button class="btn btn-link text-dark p-0 text-decoration-none fs-4 d-inline-flex align-items-center back-arrow-btn" @onclick='() => NavManager.NavigateTo("admin")' title="Back to Admin">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h4 class="mb-0 fw-bold d-flex align-items-center gap-2 text-dark">
            <i class="bi bi-person-lines-fill text-primary"></i>
            <span>User Management Directory</span>
        </h4>
    </div>

    <!-- Status Alert Banner -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center gap-2 mb-2 shadow-sm animate-fade-in" role="alert">
            <i class="bi @(statusSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-5"></i>
            <div class="flex-grow-1 small">@statusMessage</div>
            <button type="button" class="btn-close btn-close-sm" @onclick='() => statusMessage = null'></button>
        </div>
    }

    <!-- Unified Single-Line Control Bar (Compact Icons with Tooltips, Inline Status, No Group Pills) -->
    <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
        <div class="card-body p-2 d-flex flex-wrap align-items-center gap-2">
            <!-- Search Box -->
            <div class="search-box" style="width: 230px; min-width: 180px;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 py-1"><i class="bi bi-search text-muted small"></i></span>
                    <input type="text" class="form-control border-start-0 bg-light py-1" placeholder="Search ID, Name, EmpID, Email..." @bind="globalSearchText" @bind:event="oninput" title="Search by User ID, Name, EmpID, or Email" />
                    @if (!string.IsNullOrEmpty(globalSearchText))
                    {
                        <button class="btn btn-sm btn-outline-secondary bg-light border-start-0 py-1" @onclick='() => globalSearchText = ""' title="Clear search">✕</button>
                    }
                </div>
            </div>

            <!-- Status Filter Chips (Inline on the same line) -->
            <div class="d-flex align-items-center gap-1">
                <span class="text-muted small me-1">Status:</span>
                <button class="btn btn-xs rounded-pill @(filterStatus == null ? "btn-dark text-white" : "btn-light text-dark border")" @onclick='() => filterStatus = null' title="Show all users">All</button>
                <button class="btn btn-xs rounded-pill @(filterStatus == "Y" ? "btn-success text-white" : "btn-light text-dark border")" @onclick='() => filterStatus = "Y"' title="Show active users only">Active</button>
                <button class="btn btn-xs rounded-pill @(filterStatus == "N" ? "btn-danger text-white" : "btn-light text-dark border")" @onclick='() => filterStatus = "N"' title="Show inactive users only">Inactive</button>
            </div>

            <div class="vr mx-1 my-auto text-secondary opacity-25 d-none d-sm-block" style="height: 22px;"></div>

            <!-- Action Icons Toolbar (All Icon Buttons with Tooltips in ONE Line) -->
            <div class="d-flex align-items-center gap-1 flex-wrap">
                <!-- Add New Record -->
                <a href="admin/users/new" class="btn btn-sm btn-success icon-toolbar-btn shadow-sm text-decoration-none text-white d-inline-flex align-items-center justify-content-center" @onclick="() => OpenAddUserView(syncUrl: false)" title="Add New Record">
                    <i class="bi bi-plus-lg fs-6"></i>
                </a>

                <!-- Delete Selected Users -->
                <button class="btn btn-sm btn-outline-danger icon-toolbar-btn position-relative shadow-sm" @onclick="DeleteSelectedUsersAsync" disabled="@(SelectedCount == 0)" title="Delete Selected User(s)">
                    <i class="bi bi-trash3-fill"></i>
                    @if (SelectedCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white" style="font-size: 0.65rem;">
                            @SelectedCount
                        </span>
                    }
                </button>

                <!-- Print All Users -->
                <button class="btn btn-sm btn-outline-secondary icon-toolbar-btn shadow-sm" @onclick="PrintUsers" title="Print All Users">
                    <i class="bi bi-printer-fill"></i>
                </button>

                <!-- Send Email Notification -->
                <button class="btn btn-sm btn-outline-primary icon-toolbar-btn shadow-sm" @onclick="SendNotificationEmail" disabled="@(SelectedCount == 0)" title="Send Email Notification to Selected">
                    <i class="bi bi-envelope-fill"></i>
                </button>

                <!-- Reset Password -->
                <button class="btn btn-sm btn-outline-warning text-dark icon-toolbar-btn shadow-sm" @onclick="ResetSelectedUserPassword" disabled="@(SelectedCount != 1)" title="Reset Password (1 selected user)">
                    <i class="bi bi-key-fill"></i>
                </button>

                <!-- Update Company ID -->
                <button class="btn btn-sm btn-outline-info text-dark icon-toolbar-btn shadow-sm" @onclick="OpenUpdateCompanyModal" disabled="@(SelectedCount == 0)" title="Update Company ID (CoNo)">
                    <i class="bi bi-building"></i>
                </button>

                <div class="vr mx-1 my-auto text-secondary opacity-25" style="height: 22px;"></div>

                <!-- Column Filters Toggle -->
                <button class="btn btn-sm @(showFilters ? "btn-dark text-white" : "btn-outline-dark") icon-toolbar-btn shadow-sm" @onclick='() => showFilters = !showFilters' title="Toggle Per-Column Filters">
                    <i class="bi bi-funnel-fill"></i>
                </button>

                <!-- View Switcher (Grid / Cards) -->
                <div class="btn-group btn-group-sm shadow-sm" role="group">
                    <button type="button" class="btn @(viewMode == "table" ? "btn-primary" : "btn-outline-primary") icon-toolbar-btn" @onclick='() => viewMode = "table"' title="Grid Table View">
                        <i class="bi bi-table"></i>
                    </button>
                    <button type="button" class="btn @(viewMode == "cards" ? "btn-primary" : "btn-outline-primary") icon-toolbar-btn" @onclick='() => viewMode = "cards"' title="Mobile Cards View">
                        <i class="bi bi-grid-fill"></i>
                    </button>
                </div>

                <!-- Refresh Button -->
                <button class="btn btn-sm btn-outline-secondary icon-toolbar-btn shadow-sm" @onclick="() => LoadUsersAsync()" title="Refresh Users from Database">
                    <i class="bi bi-arrow-clockwise @(isLoading ? "spin" : "")"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN DATA DISPLAY (GRID / TABLE VIEW) -->
    @if (viewMode == "table")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
            <div class="table-responsive enterprise-table-container">
                <table class="table table-hover table-sm align-middle enterprise-table mb-0">
                    <thead class="table-header-custom sticky-top">
                        <!-- Main Header Row -->
                        <tr>
                            <th class="col-action text-center">#</th>
                            <th class="col-checkbox text-center">
                                <input type="checkbox" class="form-check-input" checked="@IsAllSelected" @onchange="ToggleSelectAll" title="Select All" />
                            </th>
                            <th class="col-cono text-center">CoNo</th>
                            <th class="col-id">User ID</th>
                            <th class="col-name">Name</th>
                            <th class="col-empid text-center">EmpID</th>
                            <th class="col-active text-center">IsActive</th>
                            <th class="col-ot text-center">OT Grp ID</th>
                            <th class="col-leave text-center">Leave Grp ID</th>
                            <th class="col-attn text-center">Attn Grp ID</th>
                            <th class="col-payslip text-center">Payslip Grp ID</th>
                            <th class="col-claim text-center">Claim Grp ID</th>
                            <th class="col-ea text-center">EA Form Grp ID</th>
                            <th class="col-staff text-center">Staff Grp ID</th>
                            <th class="col-email">Email</th>
                        </tr>

                        <!-- Interactive Per-Column Filter Row (from Legacy ASP.NET) -->
                        @if (showFilters)
                        {
                            <tr class="filter-row bg-light">
                                <th class="text-center"><small class="text-muted">Filter</small></th>
                                <th></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterCoNo" @bind:event="oninput" placeholder="CoNo" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterId" @bind:event="oninput" placeholder="ID" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterName" @bind:event="oninput" placeholder="Name" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterEmpId" @bind:event="oninput" placeholder="EmpID" /></th>
                                <th>
                                    <select class="form-select form-select-xs" @bind="colFilterActive">
                                        <option value="">All</option>
                                        <option value="Y">Y</option>
                                        <option value="N">N</option>
                                    </select>
                                </th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterOT" @bind:event="oninput" placeholder="OT Grp" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterLeave" @bind:event="oninput" placeholder="Leave Grp" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterAttn" @bind:event="oninput" placeholder="Attn Grp" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterPayslip" @bind:event="oninput" placeholder="Payslip Grp" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterClaim" @bind:event="oninput" placeholder="Claim Grp" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterEA" @bind:event="oninput" placeholder="EA Grp" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterStaff" @bind:event="oninput" placeholder="Staff Grp" /></th>
                                <th><input type="text" class="form-control form-control-xs" @bind="colFilterEmail" @bind:event="oninput" placeholder="Email" /></th>
                            </tr>
                        }
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="15" class="text-center py-5">
                                    <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                    <div class="text-muted small mt-2">Loading user records from MySQL via Web API...</div>
                                </td>
                            </tr>
                        }
                        else if (FilteredUsers.Count == 0)
                        {
                            <tr>
                                <td colspan="15" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 text-secondary opacity-50 d-block mb-2"></i>
                                    <span>No users match the search criteria.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in FilteredUsers)
                            {
                                bool isSelected = selectedUserIds.Contains(user.ID);
                                bool isHighlighted = (activeUser?.ID == user.ID);

                                <tr class="user-row @(isHighlighted ? "row-highlighted" : "") @(isSelected ? "row-selected" : "")" @onclick="() => SelectRow(user)">
                                    <!-- Edit Link -->
                                    <td class="text-center col-action" @onclick:stopPropagation="true">
                                        <a href="admin/users/edit/@user.ID" class="btn btn-xs btn-outline-primary py-0 px-2 fw-semibold text-decoration-none" @onclick="() => StartEditUser(user, syncUrl: false)">
                                            Edit
                                        </a>
                                    </td>

                                    <!-- Selection Checkbox -->
                                    <td class="text-center col-checkbox" @onclick:stopPropagation="true">
                                        <input type="checkbox" class="form-check-input" checked="@isSelected" @onchange="(e) => ToggleUserSelection(user.ID, e)" />
                                    </td>

                                    <!-- CoNo -->
                                    <td class="text-center col-cono text-muted font-monospace">@(string.IsNullOrEmpty(user.CoNo) ? "ID" : user.CoNo)</td>

                                    <!-- User ID -->
                                    <td class="col-id">
                                        <span class="badge bg-secondary font-monospace fw-bold">@user.ID</span>
                                    </td>

                                    <!-- Full Name -->
                                    <td class="col-name fw-semibold text-dark">@user.Name</td>

                                    <!-- EmpID -->
                                    <td class="text-center col-empid font-monospace text-muted">@(string.IsNullOrEmpty(user.EmpId) ? "-" : user.EmpId)</td>

                                    <!-- IsActive Checkbox Display -->
                                    <td class="text-center col-active" @onclick:stopPropagation="true">
                                        <input type="checkbox" class="form-check-input" checked="@(user.IsActive == "Y")" @onchange="() => ToggleUserActiveStatus(user)" title="Toggle Active Status" />
                                    </td>

                                    <!-- OT Grp ID Badge -->
                                    <td class="text-center col-ot">
                                        @if (!string.IsNullOrEmpty(user.OTUserGroupID))
                                        {
                                            <span class="badge badge-group bg-warning-subtle text-dark border border-warning">@user.OTUserGroupID</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Leave Grp ID Badge -->
                                    <td class="text-center col-leave">
                                        @if (!string.IsNullOrEmpty(user.LeaveUserGroupID))
                                        {
                                            <span class="badge badge-group bg-success-subtle text-success border border-success">@user.LeaveUserGroupID</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Attn Grp ID Badge -->
                                    <td class="text-center col-attn">
                                        @if (!string.IsNullOrEmpty(user.AttnUserGroupID))
                                        {
                                            <span class="badge badge-group bg-primary-subtle text-primary border border-primary">@user.AttnUserGroupID</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Payslip Grp ID Badge -->
                                    <td class="text-center col-payslip">
                                        @if (!string.IsNullOrEmpty(user.PayslipUserGroupID))
                                        {
                                            <span class="badge badge-group bg-purple-subtle text-purple border border-purple">@user.PayslipUserGroupID</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Claim Grp ID Badge -->
                                    <td class="text-center col-claim">
                                        @if (!string.IsNullOrEmpty(user.ClaimUserGroupID))
                                        {
                                            <span class="badge badge-group bg-info-subtle text-info border border-info">@user.ClaimUserGroupID</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- EA Form Grp ID Badge -->
                                    <td class="text-center col-ea">
                                        @if (!string.IsNullOrEmpty(user.EAFORMGroupID))
                                        {
                                            <span class="badge badge-group bg-secondary-subtle text-secondary border">@user.EAFORMGroupID</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Staff Grp ID Badge -->
                                    <td class="text-center col-staff">
                                        @if (!string.IsNullOrEmpty(user.UserGroupID))
                                        {
                                            <span class="badge badge-group bg-dark-subtle text-dark border">@user.UserGroupID</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Email -->
                                    <td class="col-email">
                                        @if (!string.IsNullOrEmpty(user.Email))
                                        {
                                            <a href="mailto:@user.Email" class="text-decoration-none text-muted font-monospace small" @onclick:stopPropagation="true">
                                                <i class="bi bi-envelope me-1"></i>@user.Email
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Table Footer Status -->
            <div class="card-footer bg-light d-flex justify-content-between align-items-center py-2 px-3 small text-muted border-top">
                <div>
                    Showing <strong>@FilteredUsers.Count</strong> of <strong>@usersList.Count</strong> users
                    @if (SelectedCount > 0)
                    {
                        <span class="ms-3 badge bg-primary">@SelectedCount Selected</span>
                    }
                </div>
                <div class="d-none d-md-block">
                    <span>Source: MySQL 5.7 schema <code>myhrsuitelog.aspnet_users</code></span>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- MOBILE / RESPONSIVE CARD VIEW -->
        <div class="row g-3 mb-4">
            @foreach (var user in FilteredUsers)
            {
                bool isSelected = selectedUserIds.Contains(user.ID);

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100 user-card @(isSelected ? "card-selected" : "")">
                        <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <input type="checkbox" class="form-check-input" checked="@isSelected" @onchange="(e) => ToggleUserSelection(user.ID, e)" />
                                <span class="badge bg-secondary font-monospace">@user.ID</span>
                                <span class="badge bg-light text-dark border">CoNo: @(string.IsNullOrEmpty(user.CoNo) ? "ID" : user.CoNo)</span>
                            </div>
                            <div>
                                @if (user.IsActive == "Y")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">Inactive</span>
                                }
                            </div>
                        </div>

                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark mb-1">@user.Name</h6>
                            <div class="small text-muted mb-2">
                                <i class="bi bi-person-vcard me-1"></i> Emp ID: <strong>@(string.IsNullOrEmpty(user.EmpId) ? "-" : user.EmpId)</strong>
                            </div>
                            @if (!string.IsNullOrEmpty(user.Email))
                            {
                                <div class="small text-muted mb-3 text-truncate">
                                    <i class="bi bi-envelope me-1"></i> @user.Email
                                </div>
                            }

                            <!-- Group Badges Grid -->
                            <div class="group-badges-container p-2 bg-light rounded-2 small mb-3">
                                <div class="row g-1 text-center" style="font-size: 0.72rem;">
                                    <div class="col-4">
                                        <div class="text-muted fw-semibold">OT</div>
                                        <div class="badge bg-warning-subtle text-dark border border-warning w-100 text-truncate">@(string.IsNullOrEmpty(user.OTUserGroupID) ? "-" : user.OTUserGroupID)</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted fw-semibold">Leave</div>
                                        <div class="badge bg-success-subtle text-success border border-success w-100 text-truncate">@(string.IsNullOrEmpty(user.LeaveUserGroupID) ? "-" : user.LeaveUserGroupID)</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted fw-semibold">Attn</div>
                                        <div class="badge bg-primary-subtle text-primary border border-primary w-100 text-truncate">@(string.IsNullOrEmpty(user.AttnUserGroupID) ? "-" : user.AttnUserGroupID)</div>
                                    </div>
                                    <div class="col-4 mt-1">
                                        <div class="text-muted fw-semibold">Payslip</div>
                                        <div class="badge bg-purple-subtle text-purple border border-purple w-100 text-truncate">@(string.IsNullOrEmpty(user.PayslipUserGroupID) ? "-" : user.PayslipUserGroupID)</div>
                                    </div>
                                    <div class="col-4 mt-1">
                                        <div class="text-muted fw-semibold">Claim</div>
                                        <div class="badge bg-info-subtle text-info border border-info w-100 text-truncate">@(string.IsNullOrEmpty(user.ClaimUserGroupID) ? "-" : user.ClaimUserGroupID)</div>
                                    </div>
                                    <div class="col-4 mt-1">
                                        <div class="text-muted fw-semibold">EA Form</div>
                                        <div class="badge bg-secondary-subtle text-secondary border w-100 text-truncate">@(string.IsNullOrEmpty(user.EAFORMGroupID) ? "-" : user.EAFORMGroupID)</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top p-2 d-flex justify-content-end gap-1">
                            <a href="admin/users/edit/@user.ID" class="btn btn-sm btn-outline-primary py-0 px-2 text-decoration-none" @onclick="() => StartEditUser(user, syncUrl: false)">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-outline-warning py-0 px-2" @onclick="() => ResetPassword(user)">
                                <i class="bi bi-key me-1"></i> Reset Pwd
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    }
    else
    {
        <!-- NEW / EDIT USER FULL PAGE VIEW (No pop-out modal!) -->
        <div class="user-edit-page animate-fade-in">
            <!-- Header bar with Back button and Actions -->
            <div class="page-top-bar d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" @onclick="CloseFormView" title="Back to User List">
                        <i class="bi bi-arrow-left"></i>
                        <span>Back to User List</span>
                    </button>
                    <h4 class="mb-0 fw-bold d-flex align-items-center gap-2 text-dark ms-2">
                        <i class="bi @(isEditMode ? "bi-person-fill-gear text-primary" : "bi-person-plus-fill text-success")"></i>
                        <span>@(isEditMode ? $"Edit User: {currentUser.ID}" : "Add New User Record")</span>
                    </h4>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" @onclick="CloseFormView">Cancel</button>
                    <button type="button" class="btn btn-sm @(isEditMode ? "btn-primary" : "btn-success") px-4 fw-semibold" @onclick="RequestSaveUser" disabled="@isSubmitting">
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>@(isEditMode ? "Update Record" : "Save Record")</span>
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(formErrorMessage))
            {
                <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span>@formErrorMessage</span>
                </div>
            }

            <!-- Form Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
                <div class="card-header @(isEditMode ? "bg-primary" : "bg-success") text-white py-2 px-3">
                    <h6 class="mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle-fill")"></i>
                        <span>@(isEditMode ? $"User Details & Permission Groups — {currentUser.ID}" : "New User Registration")</span>
                    </h6>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <!-- Section 1: Basic Credentials -->
                        <div class="col-12"><h6 class="fw-bold text-muted border-bottom pb-2 mb-2 small">1. Basic Credentials</h6></div>

                        <div class="col-12">
                            <label class="form-label small fw-bold">User ID (Login Name) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" placeholder="e.g. 00021" @bind="currentUser.ID" disabled="@isEditMode" />
                        </div>

                        <div class="col-12">
