                                    <option value="@g.UserGroupID">@(string.IsNullOrWhiteSpace(g.UserGroup) || g.UserGroup.Equals(g.UserGroupID, StringComparison.OrdinalIgnoreCase) ? g.UserGroupID : $"{g.UserGroupID} - {g.UserGroup}")</option>
                                }
