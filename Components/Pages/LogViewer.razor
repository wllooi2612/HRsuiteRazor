@page "/admin/logviewer"
@page "/admin/log-viewer"
@page "/logviewer"
@rendermode InteractiveServer
@inject HrApiClient ApiClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Log File Report - HRsuite</PageTitle>

<div class="log-viewer-page pb-5">
    <!-- Top Header Bar -->
    <div class="page-top-bar d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-link text-dark p-0 text-decoration-none fs-5 d-inline-flex align-items-center back-arrow-btn" @onclick='() => NavManager.NavigateTo("admin")' title="Back to Admin">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h6 class="mb-0 fw-bold d-flex align-items-center gap-2 text-dark">
                <span class="log-icon-badge" style="width: 26px; height: 26px; font-size: 0.9rem;"><i class="bi bi-journal-text"></i></span>
                <span>Log File Report &amp; System Audit</span>
            </h6>
        </div>

        <!-- Right Quick Action Controls -->
        <div class="d-flex align-items-center gap-1 flex-wrap">
            <div class="btn-group btn-group-sm shadow-sm" role="group">
                <button class="btn btn-outline-warning py-0 px-2 extra-small d-inline-flex align-items-center" style="height: 28px;" @onclick="() => SeedLogsAsync(100)" disabled="@isSeeding" title="Generate Sample Diagnostic Logs">
                    <i class="bi bi-magic me-1"></i>
                    <span>@(isSeeding ? "..." : "Seed")</span>
                </button>
                <button class="btn btn-outline-warning dropdown-toggle dropdown-toggle-split py-0 px-1 extra-small" style="height: 28px;" data-bs-toggle="dropdown" aria-expanded="false" disabled="@isSeeding">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li><button class="dropdown-item small" @onclick="() => SeedLogsAsync(100)"><i class="bi bi-magic me-2 text-warning"></i>Seed 100 Logs</button></li>
                    <li><button class="dropdown-item small" @onclick="() => SeedLogsAsync(500)"><i class="bi bi-database-add me-2 text-warning"></i>Seed 500 Logs</button></li>
                    <li><button class="dropdown-item small" @onclick="() => SeedLogsAsync(2000)"><i class="bi bi-lightning-charge-fill me-2 text-danger"></i>Seed 2,000 Logs</button></li>
                </ul>
            </div>

            <button class="btn btn-sm btn-outline-info shadow-sm py-0 px-2 extra-small d-inline-flex align-items-center" style="height: 28px;" @onclick="OpenStreamModal" title="Stream Logs via IAsyncEnumerable (Real-time pipeline)">
                <i class="bi bi-broadcast me-1"></i>
                <span>Stream</span>
            </button>

            <div class="btn-group btn-group-sm shadow-sm" role="group">
                <button class="btn btn-outline-secondary py-0 px-2 extra-small d-inline-flex align-items-center" style="height: 28px;" @onclick="ExportToCsv" disabled="@(queryResult.Items.Count == 0)" title="Export Current Page to CSV">
                    <i class="bi bi-file-earmark-spreadsheet me-1 text-success"></i>
                    <span>Export</span>
                </button>
                <button class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split py-0 px-1 extra-small" style="height: 28px;" data-bs-toggle="dropdown" aria-expanded="false" title="Export Options">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li><button class="dropdown-item small" @onclick="ExportToCsv"><i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i>Export Current Page (CSV)</button></li>
                    <li><button class="dropdown-item small" @onclick="StreamExportAllFiltered"><i class="bi bi-cloud-arrow-down-fill me-2 text-primary"></i>Stream Export All Filtered Logs</button></li>
                </ul>
            </div>

            <button class="btn btn-sm btn-outline-primary shadow-sm py-0 px-2 extra-small d-inline-flex align-items-center" style="height: 28px;" @onclick="PrintTable" title="Print Log Report">
                <i class="bi bi-printer-fill me-1"></i>
                <span>Print</span>
            </button>

            <button class="btn btn-sm btn-success shadow-sm py-0 px-2 fw-semibold extra-small d-inline-flex align-items-center" style="height: 28px;" @onclick="ExecuteSearchAsync" disabled="@isLoading" title="Refresh Logs">
                <i class="bi bi-arrow-clockwise @(isLoading ? "spin" : "") me-1"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    <!-- Status Alert Banner -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center gap-2 mb-2 py-1 px-2 shadow-sm" role="alert">
            <i class="bi @(statusSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-6"></i>
            <div class="flex-grow-1 extra-small">@statusMessage</div>
            <button type="button" class="btn-close btn-close-sm" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Compact Filter Bar (Tight 2-Row Layout) -->
    <div class="card border-0 shadow-sm rounded-3 mb-2 bg-white">
        <div class="card-body p-2">
            <!-- Row 1: Search & Filter Button -->
            <div class="d-flex align-items-center gap-1 mb-1">
                <div class="input-group input-group-sm flex-grow-1">
                    <span class="input-group-text bg-light border-end-0 py-0"><i class="bi bi-search text-muted extra-small"></i></span>
                    <input type="text" class="form-control border-start-0 bg-light py-0" style="font-size: 12px; height: 30px;" placeholder="Search Message, UserID, IP, Page, Exception..." @bind="queryRequest.SearchText" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
                    @if (!string.IsNullOrEmpty(queryRequest.SearchText))
                    {
                        <button class="btn btn-outline-secondary bg-light border-start-0 py-0" style="height: 30px;" @onclick="ClearSearch" title="Clear search">✕</button>
                    }
                    <button class="btn btn-primary py-0 px-3 fw-semibold extra-small" style="height: 30px;" @onclick="ExecuteSearchAsync" title="Run Search">Filter</button>
                </div>
            </div>

            <!-- Row 2: Dates, Quick Presets, Level & Rows -->
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-1 border-top">
                <!-- Left: Dates & Presets -->
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <span class="extra-small text-muted fw-bold text-uppercase">Date:</span>
                    <input type="date" class="form-control form-control-sm py-0 px-1" style="width: 120px; font-size: 11px; height: 28px;" value="@(queryRequest.DateFrom?.ToString("yyyy-MM-dd"))" @onchange="OnDateFromChanged" title="From Date" />
                    <span class="text-muted extra-small">to</span>
                    <input type="date" class="form-control form-control-sm py-0 px-1" style="width: 120px; font-size: 11px; height: 28px;" value="@(queryRequest.DateTo?.ToString("yyyy-MM-dd"))" @onchange="OnDateToChanged" title="To Date" />

                    <div class="btn-group btn-group-sm ms-1" role="group">
                        <button type="button" class="btn btn-outline-secondary py-0 px-2 extra-small" style="height: 28px;" @onclick="SetDateToday" title="Today">Today</button>
                        <button type="button" class="btn btn-outline-secondary py-0 px-2 extra-small" style="height: 28px;" @onclick="SetDate7Days" title="Last 7 Days">7D</button>
                        <button type="button" class="btn btn-outline-secondary py-0 px-2 extra-small" style="height: 28px;" @onclick="ClearDates" title="Clear Date Range">All</button>
                    </div>
                </div>

                <!-- Right: Level & Rows -->
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center gap-1">
                        <span class="extra-small text-muted fw-bold text-uppercase">Level:</span>
                        <select class="form-select form-select-sm py-0 px-1" style="width: 82px; height: 28px; font-size: 11px;" value="@queryRequest.Level" @onchange="OnLevelChanged">
                            <option value="ALL">ALL</option>
                            <option value="INFO">INFO</option>
                            <option value="WARN">WARN</option>
                            <option value="ERROR">ERROR</option>
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-1">
                        <span class="extra-small text-muted fw-bold text-uppercase">Rows:</span>
                        <select class="form-select form-select-sm py-0 px-1" style="width: 68px; height: 28px; font-size: 11px;" value="@queryRequest.PageSize" @onchange="OnPageSizeChanged">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="250">250</option>
                            <option value="500">500</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Grid Container (Starts immediately below filters) -->
    <div class="card border-0 shadow-sm rounded-3 bg-white overflow-hidden">


        <!-- Table View -->
        <div class="table-responsive log-table-wrapper" style="min-height: 380px; max-height: 65vh;">
            <table class="table table-hover align-middle mb-0 log-grid-table">
                <thead class="table-light sticky-top shadow-sm">
                    <tr>
                        <th style="width: 60px;" class="text-center">#</th>
                        <th style="width: 165px; cursor: pointer;" @onclick='() => ToggleSort("Date")'>
                            <div class="d-flex align-items-center justify-content-between">
                                <span>Date &amp; Time</span>
                                <i class="bi @(GetSortIcon("Date")) text-muted extra-small"></i>
                            </div>
                        </th>
                        <th style="width: 85px; cursor: pointer;" @onclick='() => ToggleSort("Level")'>
                            <div class="d-flex align-items-center justify-content-between">
                                <span>Level</span>
                                <i class="bi @(GetSortIcon("Level")) text-muted extra-small"></i>
                            </div>
                        </th>
                        <th style="width: 100px; cursor: pointer;" @onclick='() => ToggleSort("UserID")'>
                            <div class="d-flex align-items-center justify-content-between">
                                <span>User ID</span>
                                <i class="bi @(GetSortIcon("UserID")) text-muted extra-small"></i>
                            </div>
                        </th>
                        <th style="width: 130px; cursor: pointer;" @onclick='() => ToggleSort("PageName")'>
                            <div class="d-flex align-items-center justify-content-between">
                                <span>Page / Caller</span>
                                <i class="bi @(GetSortIcon("PageName")) text-muted extra-small"></i>
                            </div>
                        </th>
                        <th style="width: 130px;">IP / Host</th>
                        <th>Message</th>
                        <th style="width: 60px;" class="text-center">Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="spinner-border text-primary spinner-border-sm mb-2" role="status"></div>
                                <div class="small">Querying logs from database...</div>
                            </td>
                        </tr>
                    }
                    else if (queryResult.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 text-secondary opacity-50 d-block mb-2"></i>
                                <div>No log records found matching your filter criteria.</div>
                                <div class="extra-small text-muted mt-1">Try expanding the date range or clearing filters.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var index = ((queryRequest.PageIndex - 1) * queryRequest.PageSize) + 1;
                        @foreach (var item in queryResult.Items)
                        {
                            var hasException = !string.IsNullOrWhiteSpace(item.Exception);
                            <tr class="log-row @(hasException ? "table-danger-subtle" : "")" @onclick="() => OpenDetailModal(item)">
                                <td class="text-center text-muted extra-small">@index</td>
                                <td class="font-monospace small text-nowrap">
                                    <i class="bi bi-clock text-muted me-1 extra-small"></i>
                                    <span>@(item.Date?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>
                                </td>
                                <td>
                                    <span class="badge @(GetLevelBadgeClass(item.Level)) extra-small px-2 py-1">
                                        @item.Level
                                    </span>
                                </td>
                                <td class="small">
                                    @if (!string.IsNullOrWhiteSpace(item.UserID) && item.UserID != "UNKNOWN")
                                    {
                                        <span class="user-chip"><i class="bi bi-person-fill me-1 extra-small"></i>@item.UserID</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted extra-small">SYSTEM</span>
                                    }
                                </td>
                                <td class="small text-truncate" style="max-width: 140px;" title="@item.PageName">
                                    @if (!string.IsNullOrWhiteSpace(item.PageName))
                                    {
                                        <span class="badge bg-light text-dark border extra-small text-truncate d-inline-block" style="max-width: 130px;">@item.PageName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="extra-small text-muted text-nowrap">
                                    <div>@item.IP</div>
                                    @if (!string.IsNullOrWhiteSpace(item.ComputerName))
                                    {
                                        <div class="text-secondary opacity-75">@item.ComputerName</div>
                                    }
                                </td>
                                <td class="small log-message-cell">
                                    <div class="text-truncate-2" title="@item.Message">@item.Message</div>
                                    @if (hasException)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger extra-small mt-1">
                                            <i class="bi bi-bug-fill me-1"></i>Exception Attached
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-circle" @onclick:stopPropagation="true" @onclick="() => OpenDetailModal(item)" title="Inspect Log Entry">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Bottom Pagination Bar (Consolidated & moved below grid) -->
        <div class="card-footer bg-white py-2 px-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="small text-muted">
                @if (queryResult.TotalCount > 0)
                {
                    var startRow = ((queryRequest.PageIndex - 1) * queryRequest.PageSize) + 1;
                    var endRow = Math.Min(queryRequest.PageIndex * queryRequest.PageSize, queryResult.TotalCount);
                    <span>Showing <strong>@startRow.ToString("N0")</strong> to <strong>@endRow.ToString("N0")</strong> of <strong>@queryResult.TotalCount.ToString("N0")</strong> logs</span>
                }
                else
                {
                    <span>No log records found</span>
                }
            </div>

            @if (queryResult.TotalPages > 0)
            {
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" style="height: 28px;" @onclick="() => GoToPage(1)" disabled="@(queryRequest.PageIndex <= 1)" title="First Page">
                        <i class="bi bi-chevron-double-left"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" style="height: 28px;" @onclick="() => GoToPage(queryRequest.PageIndex - 1)" disabled="@(queryRequest.PageIndex <= 1)" title="Previous Page">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="px-2 small fw-bold text-dark">Page @queryRequest.PageIndex of @Math.Max(1, queryResult.TotalPages)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" style="height: 28px;" @onclick="() => GoToPage(queryRequest.PageIndex + 1)" disabled="@(queryRequest.PageIndex >= queryResult.TotalPages)" title="Next Page">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" style="height: 28px;" @onclick="() => GoToPage(queryResult.TotalPages)" disabled="@(queryRequest.PageIndex >= queryResult.TotalPages)" title="Last Page">
                        <i class="bi bi-chevron-double-right"></i>
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- ========================================== -->
    <!-- MODAL: DETAILED LOG ENTRY INSPECTOR        -->
    <!-- ========================================== -->
    @if (selectedLog != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.55);" role="dialog">
            <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                <div class="modal-content shadow-lg rounded-4 border-0">
                    <div class="modal-header bg-dark text-white py-3 px-4 rounded-top-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(GetLevelBadgeClass(selectedLog.Level)) fs-6">@selectedLog.Level</span>
                            <h6 class="modal-title mb-0 fw-bold">Log Record Details #@selectedLog.Id</h6>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => selectedLog = null"></button>
                    </div>
                    <div class="modal-body p-4">
                        <!-- Key Metadata Grid -->
                        <div class="row g-2 p-3 bg-light rounded-3 border mb-3 small">
                            <div class="col-6 col-md-4">
                                <span class="text-muted d-block extra-small text-uppercase fw-semibold">Timestamp:</span>
                                <span class="fw-bold font-monospace">@(selectedLog.Date?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted d-block extra-small text-uppercase fw-semibold">User ID:</span>
                                <span class="fw-bold text-primary">@(!string.IsNullOrWhiteSpace(selectedLog.UserID) ? selectedLog.UserID : "N/A")</span>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted d-block extra-small text-uppercase fw-semibold">Page / Module:</span>
                                <span class="fw-bold">@(!string.IsNullOrWhiteSpace(selectedLog.PageName) ? selectedLog.PageName : "-")</span>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted d-block extra-small text-uppercase fw-semibold">Client IP Address:</span>
                                <span class="fw-bold font-monospace">@(!string.IsNullOrWhiteSpace(selectedLog.IP) ? selectedLog.IP : "-")</span>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted d-block extra-small text-uppercase fw-semibold">Computer Host:</span>
                                <span>@(!string.IsNullOrWhiteSpace(selectedLog.ComputerName) ? selectedLog.ComputerName : "-")</span>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted d-block extra-small text-uppercase fw-semibold">Thread / Logger:</span>
                                <span class="text-truncate d-inline-block font-monospace extra-small" style="max-width: 180px;">@selectedLog.Thread / @selectedLog.Logger</span>
                            </div>
                        </div>

                        <!-- Message Body -->
                        <div class="mb-3">
                            <label class="form-label small text-muted fw-semibold">Log Message</label>
                            <div class="p-3 bg-white rounded-3 border font-monospace small" style="white-space: pre-wrap; word-break: break-word;">
                                @selectedLog.Message
                            </div>
                        </div>

                        <!-- Exception Stack Trace (if present) -->
                        @if (!string.IsNullOrWhiteSpace(selectedLog.Exception))
                        {
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <label class="form-label small text-danger fw-semibold mb-0"><i class="bi bi-exclamation-triangle-fill me-1"></i>Exception &amp; Stack Trace</label>
                                    <button type="button" class="btn btn-xs btn-outline-secondary" @onclick="CopyExceptionToClipboard">
                                        <i class="bi bi-clipboard me-1"></i>Copy Stack Trace
                                    </button>
                                </div>
                                <pre class="p-3 bg-dark text-danger-emphasis rounded-3 border border-danger font-monospace extra-small" style="max-height: 250px; overflow-y: auto; white-space: pre-wrap;">@selectedLog.Exception</pre>
                            </div>
                        }
                    </div>
                    <div class="modal-footer bg-light px-4 py-2 rounded-bottom-4 d-flex justify-content-between">
                        <div class="extra-small text-muted font-monospace">Log ID: @selectedLog.Id &bull; Logger: @selectedLog.Logger</div>
                        <button type="button" class="btn btn-sm btn-secondary px-4" @onclick="() => selectedLog = null">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- MODAL: REAL-TIME STREAMING FEED (IAsyncEnumerable) -->
    <!-- ========================================== -->
    @if (isStreamModalOpen)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);" role="dialog">
            <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
                <div class="modal-content shadow-lg rounded-4 border-0">
                    <div class="modal-header bg-dark text-white py-3 px-4 rounded-top-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-info text-dark fs-6"><i class="bi bi-broadcast me-1"></i>IAsyncEnumerable Stream</span>
                            <h6 class="modal-title mb-0 fw-bold">Live MySQL Streaming Pipeline (.NET 9)</h6>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseStreamModal"></button>
                    </div>
                    <div class="modal-body p-3 bg-light">
                        <div class="d-flex align-items-center justify-content-between p-2 mb-2 bg-white rounded-3 shadow-sm border">
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    <span class="small text-muted fw-semibold">Status:</span>
                                    @if (isStreamingActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success ms-1">
                                            <span class="spinner-grow spinner-grow-sm me-1" role="status"></span>
                                            Streaming Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border ms-1">Idle / Completed</span>
                                    }
                                </div>
                                <div>
                                    <span class="small text-muted fw-semibold">Streamed Count:</span>
                                    <span class="badge bg-primary fs-6 ms-1">@streamedCount</span>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                @if (isStreamingActive)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="StopStreamFeed">
                                        <i class="bi bi-stop-circle me-1"></i>Stop Stream
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-success" @onclick="StartStreamFeed">
                                        <i class="bi bi-play-circle me-1"></i>Restart Stream
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="table-responsive rounded-3 border bg-white" style="max-height: 55vh; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0 font-monospace extra-small">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th style="width: 150px;">Timestamp</th>
                                        <th style="width: 80px;">Level</th>
                                        <th style="width: 90px;">User</th>
                                        <th style="width: 120px;">Page</th>
                                        <th style="width: 110px;">IP</th>
                                        <th>Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (streamedLogs.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                @if (isStreamingActive)
                                                {
                                                    <div class="spinner-border spinner-border-sm text-primary mb-1"></div>
                                                    <div>Connecting to MySQL stream socket...</div>
                                                }
                                                else
                                                {
                                                    <div>No streamed records. Click 'Restart Stream' to begin.</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        var idx = 1;
                                        @foreach (var log in streamedLogs)
                                        {
                                            <tr>
                                                <td class="text-muted">@idx</td>
                                                <td>@(log.Date?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                                                <td><span class="badge @GetLevelBadgeClass(log.Level) extra-small">@log.Level</span></td>
                                                <td class="text-primary fw-bold">@log.UserID</td>
                                                <td class="text-truncate" style="max-width: 120px;" title="@log.PageName">@log.PageName</td>
                                                <td>@log.IP</td>
                                                <td class="text-truncate" style="max-width: 350px;" title="@log.Message">@log.Message</td>
                                            </tr>
                                            idx++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer bg-white px-4 py-2 rounded-bottom-4 d-flex justify-content-between">
                        <div class="extra-small text-muted">
                            Powered by <code>IAsyncEnumerable&lt;LogEntryModel&gt;</code> &bull; Chunked HTTP/1.1 Transfer &bull; O(1) Memory Footprint
                        </div>
                        <button type="button" class="btn btn-sm btn-secondary px-4" @onclick="CloseStreamModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private LogQueryRequest queryRequest = new()
    {
        DateFrom = DateTime.Today.AddDays(-7),
        DateTo = DateTime.Today,
        Level = "ALL",
        PageIndex = 1,
        PageSize = 50,
        SortBy = "Date",
        SortDesc = true
    };

    private LogQueryResult queryResult = new();
    private bool isLoading = true;
    private bool isSeeding = false;
    private string? statusMessage = null;
    private bool statusSuccess = true;

    private LogEntryModel? selectedLog = null;

    protected override async Task OnInitializedAsync()
    {
        await ExecuteSearchAsync();
    }

    private async Task ExecuteSearchAsync()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            queryResult = await ApiClient.QueryLogsAsync(queryRequest);
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Error retrieving logs: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || (queryResult.TotalPages > 0 && page > queryResult.TotalPages)) return;
        queryRequest.PageIndex = page;
        await ExecuteSearchAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size))
        {
            queryRequest.PageSize = size;
            queryRequest.PageIndex = 1;
            await ExecuteSearchAsync();
        }
    }

    private async Task OnLevelChanged(ChangeEventArgs e)
    {
        queryRequest.Level = e.Value?.ToString() ?? "ALL";
        queryRequest.PageIndex = 1;
        await ExecuteSearchAsync();
    }

    private void OnDateFromChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            queryRequest.DateFrom = dt;
        else
            queryRequest.DateFrom = null;
    }

    private void OnDateToChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            queryRequest.DateTo = dt;
        else
            queryRequest.DateTo = null;
    }

    private async Task SetDateToday()
    {
        queryRequest.DateFrom = DateTime.Today;
        queryRequest.DateTo = DateTime.Today;
        queryRequest.PageIndex = 1;
        await ExecuteSearchAsync();
    }

    private async Task SetDateYesterday()
    {
        queryRequest.DateFrom = DateTime.Today.AddDays(-1);
        queryRequest.DateTo = DateTime.Today.AddDays(-1);
        queryRequest.PageIndex = 1;
        await ExecuteSearchAsync();
    }

    private async Task SetDate7Days()
    {
        queryRequest.DateFrom = DateTime.Today.AddDays(-7);
        queryRequest.DateTo = DateTime.Today;
        queryRequest.PageIndex = 1;
        await ExecuteSearchAsync();
    }

    private async Task ClearDates()
    {
        queryRequest.DateFrom = null;
        queryRequest.DateTo = null;
        queryRequest.PageIndex = 1;
        await ExecuteSearchAsync();
    }

    private async Task ClearSearch()
    {
        queryRequest.SearchText = null;
        queryRequest.PageIndex = 1;
        await ExecuteSearchAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            queryRequest.PageIndex = 1;
            await ExecuteSearchAsync();
        }
    }

    private async Task ToggleSort(string column)
    {
        if (queryRequest.SortBy == column)
        {
            queryRequest.SortDesc = !queryRequest.SortDesc;
        }
        else
        {
            queryRequest.SortBy = column;
            queryRequest.SortDesc = true;
        }
        queryRequest.PageIndex = 1;
        await ExecuteSearchAsync();
    }

    private string GetSortIcon(string column)
    {
        if (queryRequest.SortBy != column) return "bi-arrow-down-up";
        return queryRequest.SortDesc ? "bi-arrow-down" : "bi-arrow-up";
    }

    private string GetLevelBadgeClass(string? level)
    {
        return (level?.ToUpperInvariant()) switch
        {
            "INFO" => "bg-success text-white",
            "WARN" or "WARNING" => "bg-warning text-dark",
            "ERROR" or "FATAL" => "bg-danger text-white",
            "DEBUG" => "bg-info text-white",
            _ => "bg-secondary text-white"
        };
    }

    private int GetLevelCount(string level)
    {
        return queryResult.LevelCounts.TryGetValue(level, out int cnt) ? cnt : 0;
    }

    private void OpenDetailModal(LogEntryModel item)
    {
        selectedLog = item;
    }

    private async Task CopyExceptionToClipboard()
    {
        if (selectedLog != null && !string.IsNullOrWhiteSpace(selectedLog.Exception))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", selectedLog.Exception);
                statusSuccess = true;
                statusMessage = "Exception stack trace copied to clipboard.";
            }
            catch
            {
                // Fallback
            }
        }
    }

    private bool isStreamModalOpen = false;
    private bool isStreamingActive = false;
    private int streamedCount = 0;
    private List<LogEntryModel> streamedLogs = new();
    private CancellationTokenSource? streamCts;

    private async Task OpenStreamModal()
    {
        isStreamModalOpen = true;
        await StartStreamFeed();
    }

    private void CloseStreamModal()
    {
        StopStreamFeed();
        isStreamModalOpen = false;
    }

    private void StopStreamFeed()
    {
        streamCts?.Cancel();
        isStreamingActive = false;
    }

    private async Task StartStreamFeed()
    {
        streamCts?.Cancel();
        streamCts = new CancellationTokenSource();
        streamedLogs.Clear();
        streamedCount = 0;
        isStreamingActive = true;
        StateHasChanged();

        try
        {
            await foreach (var log in ApiClient.StreamLogsAsync(queryRequest, streamCts.Token))
            {
                streamedLogs.Insert(0, log);
                if (streamedLogs.Count > 300)
                {
                    streamedLogs.RemoveAt(streamedLogs.Count - 1);
                }
                streamedCount++;
                if (streamedCount % 5 == 0 || streamedCount < 10)
                {
                    StateHasChanged();
                }
                await Task.Yield();
            }
        }
        catch (OperationCanceledException)
        {
            // Clean exit
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Streaming error: {ex.Message}";
        }
        finally
        {
            isStreamingActive = false;
            StateHasChanged();
        }
    }

    private async Task SeedLogsAsync(int count)
    {
        isSeeding = true;
        try
        {
            var (success, msg) = await ApiClient.SeedSampleLogsAsync(count);
            statusSuccess = success;
            statusMessage = msg;
            if (success)
            {
                queryRequest.PageIndex = 1;
                await ExecuteSearchAsync();
            }
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Failed to seed sample logs: {ex.Message}";
        }
        finally
        {
            isSeeding = false;
        }
    }

    private async Task SeedSampleLogsAsync() => await SeedLogsAsync(100);

    private static string EscapeCsv(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "\"\"";
        return "\"" + val.Replace("\"", "\"\"") + "\"";
    }

    private async Task ExportToCsv()
    {
        if (queryResult.Items.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("ID,Date,Level,UserID,PageName,IP,ComputerName,Message");
        foreach (var log in queryResult.Items)
        {
            sb.AppendLine($"{log.Id},{log.Date:yyyy-MM-dd HH:mm:ss},{EscapeCsv(log.Level)},{EscapeCsv(log.UserID)},{EscapeCsv(log.PageName)},{EscapeCsv(log.IP)},{EscapeCsv(log.ComputerName)},{EscapeCsv(log.Message)}");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var filename = "LogReport_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".csv";
        var script = "let a = document.createElement('a'); a.href = 'data:text/csv;base64," + base64 + "'; a.download = '" + filename + "'; a.click();";
        await JS.InvokeVoidAsync("eval", script);
    }

    private async Task StreamExportAllFiltered()
    {
        var url = ApiClient.GetExportCsvStreamUrl(queryRequest);
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task PrintTable()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private List<int> GetPageNumbers()
    {
        var list = new List<int>();
        int total = queryResult.TotalPages;
        int current = queryRequest.PageIndex;
        if (total <= 1) return list;

        int start = Math.Max(1, current - 2);
        int end = Math.Min(total, current + 2);

        for (int i = start; i <= end; i++)
        {
            list.Add(i);
        }
        return list;
    }
}
