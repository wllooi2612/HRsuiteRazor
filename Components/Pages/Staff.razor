@page "/staff"
@rendermode InteractiveServer
@inject HrApiClient ApiClient

<PageTitle>Staff Directory &amp; Management - HRsuite</PageTitle>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Staff Directory &amp; Users</h2>
            <p class="text-muted mb-0">Managed via <code>/api/Staff</code> and <code>/api/Admin/users</code> in Web API</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" @onclick="LoadStaffAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
            <button class="btn btn-primary btn-sm" @onclick="OpenCreateUserModal">
                <i class="bi bi-person-plus-fill me-1"></i> Add New User
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
            @alertMessage
            <button type="button" class="btn-close" @onclick='() => alertMessage = null'></button>
        </div>
    }

    <!-- Search filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Search by name, ID, or email..." @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-7 text-md-end text-muted small">
                    Showing <strong>@FilteredStaff.Count</strong> staff members (All fetched from MySQL via Web API)
                </div>
            </div>
        </div>
    </div>

    <!-- Staff Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Loading staff from Web API...</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 100px;">User ID</th>
                                <th>Name</th>
                                <th>Position</th>
                                <th>Department</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th style="width: 120px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredStaff.Count > 0)
                            {
                                @foreach (var s in FilteredStaff)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@s.EmpId</span></td>
                                        <td class="fw-semibold text-dark">@s.Name</td>
                                        <td>@(string.IsNullOrWhiteSpace(s.Position) ? "Staff Member" : s.Position)</td>
                                        <td>@(string.IsNullOrWhiteSpace(s.Department) ? "-" : s.Department)</td>
                                        <td><a href="mailto:@s.Email" class="text-decoration-none">@s.Email</a></td>
                                        <td><span class="text-muted small">@(string.IsNullOrWhiteSpace(s.HpNo) ? "-" : s.HpNo)</span></td>
                                        <td>
                                            @if (s.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="() => ViewProfileAsync(s.EmpId)">
                                                <i class="bi bi-eye"></i> View
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No staff found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Profile Modal -->
@if (selectedProfile != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Employee Profile: @selectedProfile.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => selectedProfile = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Employee ID</label>
                            <input class="form-control form-control-sm" value="@selectedProfile.EmpId" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Full Name</label>
                            <input class="form-control form-control-sm" value="@selectedProfile.Name" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Email</label>
                            <input class="form-control form-control-sm" @bind="editEmail" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Phone Number</label>
                            <input class="form-control form-control-sm" @bind="editHpNo" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-muted">Address</label>
                            <input class="form-control form-control-sm mb-2" @bind="editAddress1" placeholder="Address line 1" />
                            <input class="form-control form-control-sm" @bind="editAddress2" placeholder="Address line 2" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">City</label>
                            <input class="form-control form-control-sm" @bind="editCity" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">State</label>
                            <input class="form-control form-control-sm" @bind="editState" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">Postcode</label>
                            <input class="form-control form-control-sm" @bind="editPostcode" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Emergency Contact Name</label>
                            <input class="form-control form-control-sm" @bind="editEmergencyName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Emergency Contact Phone</label>
                            <input class="form-control form-control-sm" @bind="editEmergencyPhone" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => selectedProfile = null">Close</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveProfileAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Saving via Web API...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span>Save Changes (UPDATE via Web API)</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Create User Modal -->
@if (showCreateUser)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Create New User (INSERT via Web API)</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateUser = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">User ID / Username</label>
                            <input class="form-control form-control-sm" @bind="newUserId" placeholder="e.g. 00027" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Password</label>
                            <input type="password" class="form-control form-control-sm" @bind="newUserPassword" placeholder="Default password" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-muted">Full Name</label>
                            <input class="form-control form-control-sm" @bind="newUserName" placeholder="Full name" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-muted">Email</label>
                            <input type="email" class="form-control form-control-sm" @bind="newUserEmail" placeholder="employee@bca.com.my" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">User Group</label>
                            <input class="form-control form-control-sm" @bind="newUserGroup" placeholder="e.g. USER" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Leave Group</label>
                            <input class="form-control form-control-sm" @bind="newUserLeaveGroup" placeholder="e.g. LV IDV APPLY" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showCreateUser = false">Cancel</button>
                    <button type="button" class="btn btn-success btn-sm" @onclick="SubmitCreateUserAsync" disabled="@isSaving">
                        <i class="bi bi-person-check-fill me-1"></i> Create User via Web API
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<StaffDirectoryItem> staffList = new();
    private StaffProfile? selectedProfile;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showCreateUser = false;
    private string searchTerm = "";
    private string? alertMessage;
    private bool isSuccess;

    // Profile edit fields
    private string editEmail = "";
    private string editHpNo = "";
    private string editAddress1 = "";
    private string editAddress2 = "";
    private string editCity = "";
    private string editState = "";
    private string editPostcode = "";
    private string editEmergencyName = "";
    private string editEmergencyPhone = "";

    // Create user fields
    private string newUserId = "";
    private string newUserName = "";
    private string newUserPassword = "";
    private string newUserEmail = "";
    private string newUserGroup = "USER";
    private string newUserLeaveGroup = "LV IDV APPLY";

    private List<StaffDirectoryItem> FilteredStaff => 
        string.IsNullOrWhiteSpace(searchTerm)
            ? staffList
            : staffList.Where(s => s.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                  s.EmpId.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                  s.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadStaffAsync();
    }

    private async Task LoadStaffAsync()
    {
        isLoading = true;
        alertMessage = null;
        try
        {
            staffList = await ApiClient.GetUsersAsync();
        }
        catch (Exception ex)
        {
            alertMessage = $"Error fetching staff from Web API: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ViewProfileAsync(string empId)
    {
        selectedProfile = await ApiClient.GetStaffProfileAsync(empId);
        if (selectedProfile != null)
        {
            editEmail = selectedProfile.Email;
            editHpNo = selectedProfile.HpNo;
            editAddress1 = selectedProfile.Address1;
            editAddress2 = selectedProfile.Address2;
            editCity = selectedProfile.City;
            editState = selectedProfile.State;
            editPostcode = selectedProfile.Postcode;
            editEmergencyName = selectedProfile.EmergencyContactName;
            editEmergencyPhone = selectedProfile.EmergencyContactPhone;
        }
    }

    private async Task SaveProfileAsync()
    {
        if (selectedProfile == null) return;
        isSaving = true;

        try
        {
            var req = new UpdateStaffProfileRequest
            {
                EmpId = selectedProfile.EmpId,
                Email = editEmail,
                HpNo = editHpNo,
                Address1 = editAddress1,
                Address2 = editAddress2,
                City = editCity,
                State = editState,
                Postcode = editPostcode,
                EmergencyContactName = editEmergencyName,
                EmergencyContactPhone = editEmergencyPhone
            };

            bool ok = await ApiClient.UpdateStaffProfileAsync(req);
            if (ok)
            {
                alertMessage = $"Profile for {selectedProfile.Name} successfully updated via Web API!";
                isSuccess = true;
                selectedProfile = null;
                await LoadStaffAsync();
            }
            else
            {
                alertMessage = "Failed to update profile through Web API.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Error saving profile: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenCreateUserModal()
    {
        newUserId = "";
        newUserName = "";
        newUserPassword = "";
        newUserEmail = "";
        showCreateUser = true;
    }

    private async Task SubmitCreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(newUserId) || string.IsNullOrWhiteSpace(newUserName))
        {
            alertMessage = "User ID and Name are required.";
            isSuccess = false;
            return;
        }

        isSaving = true;
        try
        {
            var user = new AdminUserModel
            {
                ID = newUserId,
                Name = newUserName,
                Password = newUserPassword,
                Email = newUserEmail,
                UserGroupID = newUserGroup,
                LeaveUserGroupID = newUserLeaveGroup,
                IsActive = "Y"
            };

            bool ok = await ApiClient.CreateUserAsync(user);
            if (ok)
            {
                alertMessage = $"New user '{newUserName}' ({newUserId}) inserted into MySQL via Web API!";
                isSuccess = true;
                showCreateUser = false;
                await LoadStaffAsync();
            }
            else
            {
                alertMessage = "Web API failed to insert user.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Error creating user: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }
}
