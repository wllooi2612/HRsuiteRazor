@page "/database"
@rendermode InteractiveServer
@inject HrApiClient ApiClient

<PageTitle>Database Explorer - HRsuite</PageTitle>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">MySQL Database Explorer</h2>
            <p class="text-muted mb-0">Direct CRUD tasks executed via Web API <code>/api/Database</code> &amp; <code>/api/DbCrud</code></p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" @onclick="LoadTablesAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick='() => statusMessage = null'></button>
        </div>
    }

    <div class="row g-4">
        <!-- Tables List -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">Tables (57 Total)</h5>
                    <span class="badge bg-primary rounded-pill">MySQL 5.7</span>
                </div>
                <div class="p-2 border-bottom">
                    <input type="text" class="form-control form-control-sm" placeholder="Filter tables..." @bind="tableFilter" @bind:event="oninput" />
                </div>
                <div class="list-group list-group-flush overflow-auto" style="max-height: 600px;">
                    @if (isLoadingTables)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                            <span class="text-muted small ms-2">Loading tables...</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var t in FilteredTables)
                        {
                            <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selectedTableName == t.TableName ? "active" : "")"
                                    @onclick="() => SelectTableAsync(t.TableName)">
                                <div class="text-truncate">
                                    <i class="bi bi-table me-2"></i>
                                    <code>@t.TableName</code>
                                </div>
                                <span class="badge @(selectedTableName == t.TableName ? "bg-white text-dark" : "bg-secondary-subtle text-dark")">
                                    @t.RowCount
                                </span>
                            </button>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Table Details & Actions -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="mb-0 fw-semibold text-primary">
                            @if (!string.IsNullOrEmpty(selectedTableName))
                            {
                                <span>Table: <code>@selectedTableName</code> (@(tableDetail?.RowCount ?? 0) rows)</span>
                            }
                            else
                            {
                                <span>Select a table to inspect &amp; manage</span>
                            }
                        </h5>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedTableName))
                    {
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary" @onclick='() => showInsertModal = true'>
                                <i class="bi bi-plus-circle me-1"></i> Insert Row (POST)
                            </button>
                        </div>
                    }
                </div>
                <div class="card-body p-3">
                    @if (isLoadingDetail)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary"></div>
                            <p class="text-muted mt-2">Loading table data from Web API...</p>
                        </div>
                    }
                    else if (tableDetail != null)
                    {
                        <!-- Columns Schema View -->
                        <h6 class="fw-bold text-dark mb-2">Column Definitions</h6>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var col in tableDetail.Columns)
                            {
                                <span class="badge @(col.IsPrimaryKey ? "bg-warning text-dark border" : "bg-light text-dark border") p-2">
                                    @if (col.IsPrimaryKey)
                                    {
                                        <i class="bi bi-key-fill text-warning me-1"></i>
                                    }
                                    <strong>@col.ColumnName</strong>
                                    <span class="text-muted">(@col.DataType)</span>
                                </span>
                            }
                        </div>

                        <!-- Sample Rows View -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-dark mb-0">Records (Fetched via Web API)</h6>
                            <span class="text-muted small">Showing up to @tableDetail.SampleRows.Count records</span>
                        </div>

                        @if (tableDetail.SampleRows.Count > 0)
                        {
                            <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                                <table class="table table-sm table-hover table-bordered align-middle mb-0 font-monospace" style="font-size: 0.85rem;">
                                    <thead class="table-dark sticky-top">
                                        <tr>
                                            @foreach (var c in tableDetail.Columns)
                                            {
                                                <th>@c.ColumnName</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in tableDetail.SampleRows)
                                        {
                                            <tr>
                                                @foreach (var c in tableDetail.Columns)
                                                {
                                                    <td>@(r.ContainsKey(c.ColumnName) ? r[c.ColumnName]?.ToString() ?? "NULL" : "NULL")</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted border rounded">
                                No records currently stored in this table.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-arrow-left-circle fs-2 d-block mb-2"></i>
                            Select a table from the list on the left to inspect its schema and data via Web API.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Insert Modal -->
@if (showInsertModal && tableDetail != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Insert Record into <code>@selectedTableName</code> (Web API POST)</h5>
                    <button type="button" class="btn-close" @onclick="() => showInsertModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Enter field values below. All data will be submitted to <code>POST /api/DbCrud/@selectedTableName</code>.</p>
                    <div class="row g-2">
                        @foreach (var c in tableDetail.Columns.Where(col => col.Extra != "auto_increment"))
                        {
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">
                                    @c.ColumnName <span class="text-muted fw-normal">(@c.DataType)</span>
                                </label>
                                <input type="text" class="form-control form-control-sm"
                                       @onchange="(e) => newRowData[c.ColumnName] = e.Value?.ToString()" />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showInsertModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SubmitInsertAsync" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Inserting via Web API...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle me-1"></i>
                            <span>Execute INSERT</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TableStat> tables = new();
    private TableDetailDto? tableDetail;
    private string selectedTableName = "aspnet_users";
    private string tableFilter = "";
    private bool isLoadingTables = true;
    private bool isLoadingDetail = false;
    private bool isSubmitting = false;
    private bool showInsertModal = false;
    private string? statusMessage;
    private bool isSuccess;

    private Dictionary<string, object?> newRowData = new();

    private List<TableStat> FilteredTables =>
        string.IsNullOrWhiteSpace(tableFilter)
            ? tables
            : tables.Where(t => t.TableName.Contains(tableFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadTablesAsync();
        if (tables.Count > 0)
        {
            await SelectTableAsync("aspnet_users");
        }
    }

    private async Task LoadTablesAsync()
    {
        isLoadingTables = true;
        try
        {
            tables = await ApiClient.GetTableStatsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading tables from Web API: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoadingTables = false;
        }
    }

    private async Task SelectTableAsync(string tableName)
    {
        selectedTableName = tableName;
        isLoadingDetail = true;
        tableDetail = null;
        newRowData.Clear();

        try
        {
            tableDetail = await ApiClient.GetTableDetailAsync(tableName, 25);
        }
        catch (Exception ex)
        {
            statusMessage = $"Error fetching table detail for {tableName}: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoadingDetail = false;
        }
    }

    private async Task SubmitInsertAsync()
    {
        if (string.IsNullOrEmpty(selectedTableName) || newRowData.Count == 0)
        {
            statusMessage = "No data provided to insert.";
            isSuccess = false;
            return;
        }

        isSubmitting = true;
        try
        {
            var res = await ApiClient.InsertRecordAsync(selectedTableName, newRowData);
            if (res.Success)
            {
                statusMessage = $"Successfully inserted record into `{selectedTableName}` via Web API!";
                isSuccess = true;
                showInsertModal = false;
                await SelectTableAsync(selectedTableName);
            }
            else
            {
                statusMessage = $"Web API returned error: {res.Message}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error inserting record: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
