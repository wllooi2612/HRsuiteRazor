@page "/leaves"
@page "/eleave"
@page "/eLeave/eLeaveDefault.aspx"
@rendermode InteractiveServer
@inject HrApiClient ApiClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Leave Portal - HRsuite</PageTitle>

<div class="leave-mobile-container pb-5">
    <!-- Top Header Bar -->
    <div class="page-top-bar d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-link text-dark p-0 text-decoration-none fs-5 d-inline-flex align-items-center back-arrow-btn" @onclick='() => NavManager.NavigateTo("admin")' title="Back to Admin">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h6 class="mb-0 fw-bold d-flex align-items-center gap-2 text-dark">
                <span class="leave-icon-badge" style="width: 26px; height: 26px; font-size: 0.95rem;"><i class="bi bi-calendar2-check-fill"></i></span>
                <span>Leave Management Portal</span>
            </h6>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" style="height: 28px;" @onclick="LoadDataAsync" title="Refresh Leave Data">
                <i class="bi bi-arrow-clockwise @(isLoading ? "spin" : "") me-1"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    <!-- 12-Tile Dashboard Grid (Exact match to eLeaveDefault.aspx & User Reference) -->
    <div class="leave-grid-wrapper mb-3">
        <div class="leave-grid">
            <!-- Row 1: Green & Red -->
            <button type="button" class="leave-tile @(activeTab == "group_apply" ? "active" : "")" @onclick='() => SelectTile("group_apply")' title="Group Leave Apply">
                <img src="img/icon/GroupLeaveApply.png" alt="Group Leave Apply" class="leave-tile-img" />
            </button>

            <button type="button" class="leave-tile @(activeTab == "ind_apply" ? "active" : "")" @onclick='() => SelectTile("ind_apply")' title="Individual Leave Apply">
                <img src="img/icon/IndLeaveApply.png" alt="Individual Leave Apply" class="leave-tile-img" />
            </button>

            <button type="button" class="leave-tile @(activeTab == "supervisor" ? "active" : "")" @onclick='() => SelectTile("supervisor")' title="Leave Supervisor">
                <img src="img/icon/LeaveSupervisor.png" alt="Leave Supervisor" class="leave-tile-img" />
            </button>

            <!-- Row 2: Orange, Cyan, Teal, Rust -->
            <button type="button" class="leave-tile" @onclick='() => NavManager.NavigateTo("leaves/create-user-access")' title="Create User Access">
                <img src="img/icon/CreateUserAccess.png" alt="Create User Access" class="leave-tile-img" />
            </button>

            <button type="button" class="leave-tile" @onclick='() => NavManager.NavigateTo("leaves/approval-level")' title="Leave Approval Level">
                <img src="img/icon/LeaveApprovalLevel.png" alt="Leave Approval Level" class="leave-tile-img" />
            </button>

            <button type="button" class="leave-tile" @onclick='() => NavManager.NavigateTo("leaves/maintenance")' title="Leave Maintenance">
                <img src="img/icon/LeaveMaintenance.png" alt="Leave Maintenance" class="leave-tile-img" />
            </button>

            <button type="button" class="leave-tile @(activeTab == "doc_rule" ? "active" : "")" @onclick='() => SelectTile("doc_rule")' title="Leave Doc Rule">
                <img src="img/icon/LeaveDocRule.png" alt="Leave Doc Rule" class="leave-tile-img" />
            </button>

            <!-- Row 3: Rust, Olive Green, Olive Green, Rust -->
            <button type="button" class="leave-tile @(activeTab == "administrator" ? "active" : "")" @onclick='() => SelectTile("administrator")' title="Leave Administrator">
                <img src="img/icon/LeaveAdministrator.png" alt="Leave Administrator" class="leave-tile-img" />
            </button>

            <button type="button" class="leave-tile @(activeTab == "view_leave" ? "active" : "")" @onclick='() => SelectTile("view_leave")' title="View Leave">
                <img src="img/icon/ViewLeave.png" alt="View Leave" class="leave-tile-img" />
            </button>

            <button type="button" class="leave-tile @(activeTab == "calendar" ? "active" : "")" @onclick='() => SelectTile("calendar")' title="Leave Calendar">
                <img src="img/icon/LeaveCalendar.png" alt="Leave Calendar" class="leave-tile-img" />
            </button>

            <button type="button" class="leave-tile @(activeTab == "user_review" ? "active" : "")" @onclick='() => SelectTile("user_review")' title="User Access Review">
                <img src="img/icon/UserAccessReview.png" alt="User Access Review" class="leave-tile-img" />
            </button>

            <!-- Transparent spacer slot to maintain 4-column grid alignment -->
            <div class="tile-spacer"></div>
        </div>
    </div>

    <!-- Status Alert Notification -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center gap-2 mb-3 shadow-sm py-2 px-3 rounded-3" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5"></i>
            <div class="flex-grow-1 extra-small">@statusMessage</div>
            <button type="button" class="btn-close" @onclick='() => statusMessage = null'></button>
        </div>
    }

    <!-- ============================================================== -->
    <!-- DETAIL FEATURE PANELS (Triggered only when a tile is tapped)   -->
    <!-- ============================================================== -->

    <!-- 1. INDIVIDUAL LEAVE APPLY PANEL -->
    @if (activeTab == "ind_apply")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 animate-fade-in bg-white">
            <div class="card-header bg-success text-white py-2 px-3 d-flex align-items-center justify-content-between rounded-top-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-fill"></i>
                    <h6 class="mb-0 fw-bold">Individual Leave Application</h6>
                </div>
                <button class="btn btn-sm btn-outline-light py-0 px-2 extra-small" @onclick='() => activeTab = null'>✕ Close</button>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Employee ID</label>
                        <input class="form-control form-control-sm" @bind="applyEmpId" placeholder="e.g. 00001" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Leave Type</label>
                        <select class="form-select form-select-sm" @bind="applyLeaveCode">
                            @if (leaveTypes?.Count > 0)
                            {
                                @foreach (var lt in leaveTypes)
                                {
                                    <option value="@lt.Code">@lt.Name (@lt.Code) - Bal: @lt.Balance</option>
                                }
                            }
                            else
                            {
                                <option value="AL">Annual Leave (AL) - Bal: 14</option>
                                <option value="MC">Medical Leave (MC) - Bal: 14</option>
                                <option value="HL">Hospitalization Leave (HL) - Bal: 60</option>
                                <option value="EL">Emergency Leave (EL)</option>
                                <option value="UL">Unpaid Leave (UL)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Day Type</label>
                        <select class="form-select form-select-sm" @bind="applyDayType">
                            <option value="FULL">Full Day</option>
                            <option value="FIRST_HALF">First Half (Morning)</option>
                            <option value="SECOND_HALF">Second Half (Afternoon)</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Date From</label>
                        <input type="date" class="form-control form-control-sm" @bind="applyDateFrom" @bind:after="RecalculateDays" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Date To</label>
                        <input type="date" class="form-control form-control-sm" @bind="applyDateTo" @bind:after="RecalculateDays" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Total Days</label>
                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="applyDays" />
                    </div>

                    <div class="col-12">
                        <label class="form-label extra-small fw-semibold text-muted">Reason / Justification</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="applyReason" placeholder="State reason for leave application..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                    <button type="button" class="btn btn-light btn-sm extra-small px-3" @onclick='() => activeTab = null'>Cancel</button>
                    <button type="button" class="btn btn-success btn-sm extra-small px-4 fw-semibold" @onclick="SubmitLeaveApplicationAsync" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Submitting via Web API...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-fill me-1"></i>
                            <span>Submit Application (INSERT)</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- 2. GROUP LEAVE APPLY PANEL -->
    @if (activeTab == "group_apply")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 animate-fade-in bg-white">
            <div class="card-header bg-success text-white py-2 px-3 d-flex align-items-center justify-content-between rounded-top-3" style="background-color: #2e6430 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill"></i>
                    <h6 class="mb-0 fw-bold">Group Leave Application (Department / Batch)</h6>
                </div>
                <button class="btn btn-sm btn-outline-light py-0 px-2 extra-small" @onclick='() => activeTab = null'>✕ Close</button>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label extra-small fw-semibold text-muted">Select Target Department / Team</label>
                        <select class="form-select form-select-sm" @bind="groupTargetDept">
                            <option value="ALL">Entire Organization</option>
                            <option value="IT">IT &amp; Systems Department</option>
                            <option value="HR">Human Resources</option>
                            <option value="OPS">Operations &amp; Plant</option>
                            <option value="FIN">Finance &amp; Accounts</option>
                            <option value="SALES">Sales &amp; Marketing</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label extra-small fw-semibold text-muted">Leave Classification</label>
                        <select class="form-select form-select-sm" @bind="groupLeaveCode">
                            <option value="AL">Company Annual Shutdown / Leave (AL)</option>
                            <option value="COL">Company Organized Event Leave (COL)</option>
                            <option value="PH">Public Holiday Replacement (PH)</option>
                            <option value="UL">Unpaid Group Leave (UL)</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Date From</label>
                        <input type="date" class="form-control form-control-sm" @bind="groupDateFrom" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Date To</label>
                        <input type="date" class="form-control form-control-sm" @bind="groupDateTo" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Approval Authority</label>
                        <input class="form-control form-control-sm bg-light" value="HR Director / Admin" readonly />
                    </div>
                    <div class="col-12">
                        <label class="form-label extra-small fw-semibold text-muted">Batch Reason &amp; Official Memorandum Note</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="groupReason" placeholder="e.g. Annual Company Factory Maintenance &amp; Plant Shutdown..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                    <button type="button" class="btn btn-light btn-sm extra-small px-3" @onclick='() => activeTab = null'>Cancel</button>
                    <button type="button" class="btn btn-success btn-sm extra-small px-4 fw-semibold" style="background-color: #2e6430;" @onclick="SubmitGroupLeaveAsync" disabled="@isSubmitting">
                        <i class="bi bi-check2-all me-1"></i> Submit Batch Group Leave
                    </button>
                </div>
            </div>
        </div>
    }


    <!-- 4. LEAVE SUPERVISOR APPROVAL QUEUE -->
    @if (activeTab == "supervisor")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 animate-fade-in bg-white">
            <div class="card-header text-white py-2 px-3 d-flex align-items-center justify-content-between rounded-top-3" style="background-color: #941818 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-check-fill"></i>
                    <h6 class="mb-0 fw-bold">Leave Supervisor Approval Queue</h6>
                    <span class="badge bg-light text-danger fw-bold ms-2">@(leaves?.Count(l => l.Leave_Status != "APPROVE" && l.Leave_Status != "REJECT") ?? 0) Pending</span>
                </div>
                <button class="btn btn-sm btn-outline-light py-0 px-2 extra-small" @onclick='() => activeTab = null'>✕ Close</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 extra-small">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Leave No</th>
                                <th>Employee</th>
                                <th>Leave Type</th>
                                <th>Date Range</th>
                                <th>Days</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th class="text-end">Supervisor Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var pendingLeaves = leaves?.Where(l => l.Leave_Status != "APPROVE" && l.Leave_Status != "REJECT").ToList();
                            }
                            @if (pendingLeaves?.Count > 0)
                            {
                                int sIdx = 1;
                                @foreach (var l in pendingLeaves)
                                {
                                    <tr>
                                        <td class="text-muted">@sIdx</td>
                                        <td><code>@l.LeaveNo</code></td>
                                        <td><span class="badge bg-light text-dark border">@l.Emp_ID</span> <strong>@l.EmpName</strong></td>
                                        <td><span class="badge bg-primary-subtle text-primary border">@l.Leave_Type</span></td>
                                        <td>@l.Leave_Date_From.ToString("yyyy-MM-dd") to @l.Leave_Date_To.ToString("yyyy-MM-dd")</td>
                                        <td><strong>@l.TotalDays</strong> day(s)</td>
                                        <td class="text-truncate" style="max-width: 150px;" title="@l.Leave_Reason">@(string.IsNullOrWhiteSpace(l.Leave_Reason) ? "-" : l.Leave_Reason)</td>
                                        <td><span class="badge bg-warning-subtle text-warning border border-warning">Pending Review</span></td>
                                        <td class="text-end text-nowrap">
                                            <button class="btn btn-success btn-xs px-2 me-1" @onclick='() => ProcessApprovalAsync(l.LeaveNo, l.Emp_ID, "APPROVE")' title="Approve Leave">
                                                <i class="bi bi-check-lg me-1"></i>Approve
                                            </button>
                                            <button class="btn btn-outline-danger btn-xs px-2" @onclick='() => ProcessApprovalAsync(l.LeaveNo, l.Emp_ID, "REJECT")' title="Reject Leave">
                                                <i class="bi bi-x-lg me-1"></i>Reject
                                            </button>
                                        </td>
                                    </tr>
                                    sIdx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4 text-muted">
                                        <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
                                        All supervisor leave approval queues are clear!
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- 5. CREATE USER ACCESS -->
    @if (activeTab == "create_access")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 animate-fade-in bg-white">
            <div class="card-header text-white py-2 px-3 d-flex align-items-center justify-content-between rounded-top-3" style="background-color: #df7b1f !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus-fill"></i>
                    <h6 class="mb-0 fw-bold">Create User Leave Access &amp; Group Mapping</h6>
                </div>
                <button class="btn btn-sm btn-outline-light py-0 px-2 extra-small" @onclick='() => activeTab = null'>✕ Close</button>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Target User Account</label>
                        <select class="form-select form-select-sm" @bind="accessUserId">
                            <option value="1001">1001 - Alex Wong</option>
                            <option value="1002">1002 - Siti Sarah</option>
                            <option value="1005">1005 - Michael Tan</option>
                            <option value="ADMIN">ADMIN - System Administrator</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Leave Group Role</label>
                        <select class="form-select form-select-sm" @bind="accessRole">
                            <option value="STAFF">STAFF - Standard Employee Apply</option>
                            <option value="SUPERVISOR">SUPERVISOR - Level 1 Leave Approver</option>
                            <option value="HOD">HOD - Departmental Head Approver</option>
                            <option value="HR_ADMIN">HR_ADMIN - Global Leave Controller</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label extra-small fw-semibold text-muted">Allowed Leave Policy</label>
                        <select class="form-select form-select-sm">
                            <option>Standard Permanent Full-Time (14d AL, 14d MC)</option>
                            <option>Probationary Staff (Pro-rated)</option>
                            <option>Contractual Employee (7d AL, 7d MC)</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                    <button type="button" class="btn btn-warning btn-sm extra-small px-3 fw-semibold text-dark" style="background-color: #df7b1f; color: white !important;" @onclick="SaveUserAccess">
                        <i class="bi bi-save me-1"></i> Save Access Permissions
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- 6. LEAVE APPROVAL LEVEL -->
    @if (activeTab == "approval_level")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 animate-fade-in bg-white">
            <div class="card-header text-white py-2 px-3 d-flex align-items-center justify-content-between rounded-top-3" style="background-color: #00a2b9 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-diagram-3-fill"></i>
                    <h6 class="mb-0 fw-bold">Leave Approval Level Hierarchy Matrix</h6>
                </div>
                <button class="btn btn-sm btn-outline-light py-0 px-2 extra-small" @onclick='() => activeTab = null'>✕ Close</button>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-bordered table-sm mb-0 extra-small">
                        <thead class="table-light">
                            <tr>
                                <th>Level</th>
                                <th>Role Title</th>
                                <th>Condition / Threshold</th>
                                <th>Action Authority</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="badge bg-primary">Level 1</span></td>
                                <td>Direct Supervisor / Line Manager</td>
                                <td>Leave Duration &le; 3 Days</td>
                                <td>Direct Approval (Final)</td>
                                <td><span class="badge bg-success">Active</span></td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-info text-dark">Level 2</span></td>
                                <td>Head of Department (HOD)</td>
                                <td>Leave Duration &gt; 3 Days &amp; Unpaid Leave</td>
                                <td>Secondary Endorsement</td>
                                <td><span class="badge bg-success">Active</span></td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-secondary">Level 3</span></td>
                                <td>HR Director</td>
                                <td>Maternity, Hospitalization, Carry-Forward &gt; Limit</td>
                                <td>Policy Compliance Validation</td>
                                <td><span class="badge bg-success">Active</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }


    <!-- 8. LEAVE DOC RULE -->
    @if (activeTab == "doc_rule")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 animate-fade-in bg-white">
            <div class="card-header text-white py-2 px-3 d-flex align-items-center justify-content-between rounded-top-3" style="background-color: #c83e1c !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-check-fill"></i>
                    <h6 class="mb-0 fw-bold">Leave Document Attachment Policies &amp; Rules</h6>
                </div>
                <button class="btn btn-sm btn-outline-light py-0 px-2 extra-small" @onclick='() => activeTab = null'>✕ Close</button>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold mb-1 text-dark"><i class="bi bi-hospital text-danger me-2"></i>Medical Certificate (MC) Policy</h6>
                            <p class="extra-small text-muted mb-2">Mandatory upload of scanned/photographed MC slip from recognized registered clinic or hospital. Submission window: Within 48 hours of return.</p>
                            <span class="badge bg-danger-subtle text-danger border border-danger">Mandatory Enforcement</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold mb-1 text-dark"><i class="bi bi-heart-fill text-danger me-2"></i>Marriage &amp; Maternity Rule</h6>
                            <p class="extra-small text-muted mb-2">Marriage cert copy required within 14 days. Maternity requires medical estimated date of delivery (EDD) endorsement prior to departure.</p>
                            <span class="badge bg-success-subtle text-success border border-success">Verified by HR</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- 9. LEAVE ADMINISTRATOR CONSOLE -->
    @if (activeTab == "administrator")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 animate-fade-in bg-white">
            <div class="card-header text-white py-2 px-3 d-flex align-items-center justify-content-between rounded-top-3" style="background-color: #c83e1c !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-shaded"></i>
                    <h6 class="mb-0 fw-bold">Leave Administrator Central Operations</h6>
                </div>
                <button class="btn btn-sm btn-outline-light py-0 px-2 extra-small" @onclick='() => activeTab = null'>✕ Close</button>
            </div>
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-calendar-event me-2 text-primary"></i>Year-End Carry Forward</h6>
                            <p class="extra-small text-muted mb-3">Execute automated calculation to carry forward eligible balances into the next calendar year.</p>
                            <button class="btn btn-primary btn-sm extra-small w-100" @onclick="ExecuteCarryForward">
