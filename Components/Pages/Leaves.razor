    <!-- 11. USER ACCESS REVIEW AUDIT -->
    @if (activeTab == "user_review")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 animate-fade-in bg-white">
            <div class="card-header text-white py-2 px-3 d-flex align-items-center justify-content-between rounded-top-3" style="background-color: #b53c15 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-fingerprint"></i>
