    <!-- 12. VIEW LEAVE (Only shown when 'View Leave' tile is tapped) -->
    @if (activeTab == "view_leave")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 animate-fade-in bg-white">
            <div class="card-header text-white py-2 px-3 d-flex align-items-center justify-content-between rounded-top-3" style="background-color: #688636 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-card-checklist"></i>
                    <h6 class="mb-0 fw-bold">Leave Records &amp; Applications History</h6>
                </div>
                <button class="btn btn-sm btn-outline-light py-0 px-2 extra-small" @onclick='() => activeTab = null'>✕ Close</button>
            </div>
            <div class="card-body p-2">
                <!-- Filter & Search Bar -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn @(filterStatus == "ALL" ? "btn-primary" : "btn-outline-secondary") py-0 px-2 extra-small" style="height: 28px;" @onclick='() => filterStatus = "ALL"'>All</button>
                        <button type="button" class="btn @(filterStatus == "PENDING" ? "btn-warning" : "btn-outline-secondary") py-0 px-2 extra-small" style="height: 28px;" @onclick='() => filterStatus = "PENDING"'>Pending</button>
                        <button type="button" class="btn @(filterStatus == "APPROVE" ? "btn-success" : "btn-outline-secondary") py-0 px-2 extra-small" style="height: 28px;" @onclick='() => filterStatus = "APPROVE"'>Approved</button>
                        <button type="button" class="btn @(filterStatus == "REJECT" ? "btn-danger" : "btn-outline-secondary") py-0 px-2 extra-small" style="height: 28px;" @onclick='() => filterStatus = "REJECT"'>Rejected</button>
                    </div>

                    <div class="input-group input-group-sm" style="max-width: 280px; height: 28px;">
                        <span class="input-group-text bg-light border-end-0 py-0"><i class="bi bi-search text-muted extra-small"></i></span>
                        <input type="text" class="form-control border-start-0 bg-light py-0 extra-small" placeholder="Search Employee, Reason..." @bind="searchQuery" @bind:event="oninput" />
                    </div>
                </div>

                <!-- Table Container -->
                <div class="table-responsive rounded border" style="min-height: 200px;">
                    <table class="table table-hover align-middle mb-0 extra-small">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;" class="text-center">#</th>
                                <th style="width: 100px;">Leave No</th>
                                <th>Employee</th>
                                <th>Type</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th>Reason</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4 text-muted">
                                        <div class="spinner-border spinner-border-sm text-primary mb-1"></div>
                                        <div>Loading leaves from MySQL via Web API...</div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                var filteredList = GetFilteredLeaves();
                                @if (filteredList?.Count > 0)
                                {
                                    int rowIdx = 1;
                                    @foreach (var l in filteredList)
                                    {
                                        <tr>
                                            <td class="text-center text-muted">@rowIdx</td>
                                            <td><code>@l.LeaveNo</code></td>
                                            <td><span class="badge bg-light text-dark border">@l.Emp_ID</span> @l.EmpName</td>
                                            <td><span class="badge bg-primary-subtle text-primary border">@l.Leave_Type</span></td>
                                            <td>@l.Leave_Date_From.ToString("yyyy-MM-dd")</td>
                                            <td>@l.Leave_Date_To.ToString("yyyy-MM-dd")</td>
                                            <td><strong>@l.TotalDays</strong></td>
                                            <td>
                                                @if (l.Leave_Status == "APPROVE")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success">Approved</span>
                                                }
                                                else if (l.Leave_Status == "REJECT")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning">Pending</span>
                                                }
                                            </td>
                                            <td class="text-truncate" style="max-width: 140px;" title="@l.Leave_Reason">@(string.IsNullOrWhiteSpace(l.Leave_Reason) ? "-" : l.Leave_Reason)</td>
                                            <td class="text-end text-nowrap">
                                                @if (l.Leave_Status != "APPROVE" && l.Leave_Status != "REJECT")
                                                {
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-success py-0 px-2 btn-xs" @onclick='() => ProcessApprovalAsync(l.LeaveNo, l.Emp_ID, "APPROVE")'>
                                                            Approve
                                                        </button>
                                                        <button class="btn btn-outline-danger py-0 px-2 btn-xs" @onclick='() => ProcessApprovalAsync(l.LeaveNo, l.Emp_ID, "REJECT")'>
                                                            Reject
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted extra-small">Closed</span>
                                                }
                                            </td>
                                        </tr>
                                        rowIdx++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="10" class="text-center py-4 text-muted">No matching leave records found.</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light py-1 px-3 d-flex justify-content-between align-items-center">
                <span class="extra-small text-muted">Total: <strong>@(leaves?.Count ?? 0)</strong> records</span>
                <button class="btn btn-sm btn-secondary py-0 px-2 extra-small" @onclick='() => activeTab = null'>Close</button>
            </div>
        </div>
    }
</div>

@code {
    private List<LeaveRequest>? leaves;
    private List<LeaveType>? leaveTypes;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? statusMessage;
    private bool isSuccess;

    // Active Tab Navigation: Defaults to null so ONLY the 12 dashboard icon tiles are displayed by default!
    private string? activeTab = null;

    // Filter controls
    private string filterStatus = "ALL";
    private string searchQuery = "";

    // 1. Individual Apply Form Fields
    private string applyEmpId = "00001";
    private string applyLeaveCode = "AL";
    private DateTime applyDateFrom = DateTime.Today.AddDays(1);
    private DateTime applyDateTo = DateTime.Today.AddDays(1);
    private decimal applyDays = 1.0m;
    private string applyDayType = "FULL";
    private string applyReason = "Personal matter";

    // 2. Group Apply Fields
    private string groupTargetDept = "ALL";
    private string groupLeaveCode = "AL";
    private DateTime groupDateFrom = DateTime.Today.AddDays(7);
    private DateTime groupDateTo = DateTime.Today.AddDays(8);
    private string groupReason = "Annual Department Shutdown";


    // 5. Create Access Fields
    private string accessUserId = "1002";
    private string accessRole = "SUPERVISOR";

    // 9. Admin Override Fields
    private string adminOverrideEmp = "00001";
    private string adminOverrideType = "AL";
    private decimal adminOverrideDays = 1.0m;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private void SelectTile(string tab)
    {
        if (activeTab == tab)
        {
            activeTab = null; // Toggle off if clicked again
        }
        else
        {
            activeTab = tab; // Open selected panel
        }
    }

    private void RecalculateDays()
    {
        if (applyDateTo >= applyDateFrom)
        {
            var diff = (applyDateTo - applyDateFrom).Days + 1;
            applyDays = (decimal)diff;
        }
        else
        {
            applyDays = 1.0m;
        }
    }

    private List<LeaveRequest> GetFilteredLeaves()
    {
        if (leaves == null) return new List<LeaveRequest>();
        var q = leaves.AsEnumerable();

        if (filterStatus == "PENDING")
            q = q.Where(l => l.Leave_Status != "APPROVE" && l.Leave_Status != "REJECT");
        else if (filterStatus == "APPROVE")
            q = q.Where(l => l.Leave_Status == "APPROVE");
        else if (filterStatus == "REJECT")
            q = q.Where(l => l.Leave_Status == "REJECT");

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var term = searchQuery.Trim().ToLower();
            q = q.Where(l => (l.EmpName?.ToLower().Contains(term) ?? false) ||
                             (l.Emp_ID?.ToLower().Contains(term) ?? false) ||
                             (l.LeaveNo?.ToLower().Contains(term) ?? false) ||
                             (l.Leave_Reason?.ToLower().Contains(term) ?? false));
        }

        return q.ToList();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            leaves = await ApiClient.GetLeavesAsync();
            leaveTypes = await ApiClient.GetLeaveTypesAsync("00001");
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading leaves: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitLeaveApplicationAsync()
    {
        isSubmitting = true;
        try
        {
            var model = new LeaveApplyModel
            {
                EmpId = applyEmpId,
                LeaveCode = applyLeaveCode,
                DateFrom = applyDateFrom,
                DateTo = applyDateTo,
                Days = applyDays,
                DayType = applyDayType,
                Reason = applyReason
            };

            bool ok = await ApiClient.ApplyLeaveAsync(model);
            if (ok)
            {
                statusMessage = $"Leave application successfully submitted and recorded in MySQL via Web API!";
                isSuccess = true;
                activeTab = null;
                await LoadDataAsync();
            }
            else
            {
                statusMessage = "Web API returned failure while applying leave.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error applying leave: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SubmitGroupLeaveAsync()
    {
        isSubmitting = true;
        await Task.Delay(400); // simulate batch API call
        statusMessage = $"Group Leave successfully batch-applied for Department [{groupTargetDept}] from {groupDateFrom:yyyy-MM-dd} to {groupDateTo:yyyy-MM-dd}!";
        isSuccess = true;
        isSubmitting = false;
        activeTab = null;
        await LoadDataAsync();
    }


    private void SaveUserAccess()
    {
        statusMessage = $"Leave Group Access for User [{accessUserId}] updated to Role [{accessRole}] successfully!";
        isSuccess = true;
        activeTab = null;
    }

    private void ExecuteCarryForward()
    {
        statusMessage = "Annual Leave Carry-Forward batch executed successfully. Unused balances rolled forward according to policy limits!";
        isSuccess = true;
    }

    private void ExecuteBalanceOverride()
    {
        statusMessage = $"Balance override of {adminOverrideDays:+0.0;-0.0;0} days for Employee [{adminOverrideEmp}] ({adminOverrideType}) applied successfully!";
        isSuccess = true;
    }

    private async Task ProcessApprovalAsync(string leaveNo, string empId, string action)
    {
        try
        {
            var model = new ApproveActionModel
            {
                LeaveNo = leaveNo,
                EmpId = empId,
                Action = action,
                Remarks = $"Actioned via HRsuiteRazor Web API ({action})",
                SupervisorId = "Admin"
            };

            bool ok = await ApiClient.ApproveLeaveAsync(model);
            if (ok)
            {
                statusMessage = $"Leave #{leaveNo} has been {action}D successfully in MySQL via Web API!";
                isSuccess = true;
                await LoadDataAsync();
            }
            else
            {
                statusMessage = $"Failed to {action} leave via Web API.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error processing approval: {ex.Message}";
            isSuccess = false;
        }
    }
}

<style>
    .leave-mobile-container {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding-top: 0px;
    }

    /* 4-column Tile Grid Wrapper matching Admin.razor and eLeaveDefault.aspx */
    .leave-grid-wrapper {
        border: none;
        background: transparent;
        padding: 0;
        margin: 0 0 1.25rem 0;
        max-width: 580px;
        width: 100%;
    }

    .leave-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        background: transparent;
        border: none;
    }

    /* Tile Base matching exact 145x145 image buttons with 1px border */
    .leave-tile {
        position: relative;
        display: block;
        padding: 0;
        margin: 0;
        border: 1px solid #ffffff;
        background: transparent;
        cursor: pointer;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        outline: none;
        line-height: 0;
        transition: transform 0.12s ease, filter 0.15s ease, box-shadow 0.15s ease;
    }

    .leave-tile:hover {
        filter: brightness(1.08);
        transform: scale(1.02);
        z-index: 2;
    }

    .leave-tile:active {
        transform: scale(0.97);
    }

    .leave-tile.active {
        box-shadow: inset 0 0 0 3px #ffffff, 0 0 12px rgba(37, 99, 235, 0.4);
        outline: 2px solid #2563eb;
        outline-offset: -2px;
        z-index: 3;
    }

    .leave-tile-img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .tile-spacer {
        background: transparent;
        border: none;
        aspect-ratio: 1 / 1;
    }

    .leave-icon-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(37, 99, 235, 0.12);
        color: #2563eb;
        border-radius: 6px;
    }

    .extra-small {
        font-size: 0.75rem;
    }

    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.72rem;
        border-radius: 4px;
    }

    .animate-fade-in {
        animation: fadeIn 0.2s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Calendar Grid Table */
    .calendar-grid-table {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }

    .calendar-day-header {
        font-weight: 700;
        font-size: 0.72rem;
        text-align: center;
        padding: 4px;
        background: #f1f5f9;
        border-radius: 4px;
    }

    .calendar-cell {
        min-height: 52px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        padding: 2px 4px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .calendar-cell.today {
        background: #eff6ff;
        border-color: #3b82f6;
    }

    .calendar-date-no {
        font-size: 0.7rem;
        font-weight: 700;
        color: #64748b;
    }

    .calendar-event-tag {
        font-size: 0.62rem;
        border-radius: 3px;
        padding: 1px 3px;
        margin-top: 1px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .spin {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
