                                <td>Siti Sarah</td>
                                <td><span class="badge bg-primary">Supervisor</span></td>
                                <td>&le; 5 Days</td>
                                <td>2026-10-22</td>
                                <td><span class="badge bg-success">Verified</span></td>
                            </tr>
                            <tr>
                                <td><code>1005</code></td>
                                <td>Michael Tan</td>
                                <td><span class="badge bg-info text-dark">Approver L2</span></td>
                                <td>&le; 14 Days</td>
                                <td>2026-10-18</td>
