@page "/"
@page "/default.aspx"
@page "/home"
@page "/dashboard"

@inject HrApiClient ApiClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>HRsuite Dashboard - Default.aspx</PageTitle>

<div class="hr-dashboard pb-5">
    <!-- Top Corporate Welcome & Status Header (Default.aspx) -->
    <div class="header-card mb-4 text-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <span class="badge bg-white text-primary fw-bold px-2.5 py-1">
                        <i class="bi bi-building-fill-gear me-1"></i>Myhrsuite Main Portal
                    </span>
                    <span class="badge bg-light text-dark font-monospace">Default.aspx</span>
                    @if (ApiClient.IsLoggedIn && ApiClient.CurrentUser != null)
                    {
                        <span class="badge bg-info text-dark fw-bold">
                            <i class="bi bi-person-check-fill me-1"></i>Welcome, @ApiClient.CurrentUser.Name (@ApiClient.CurrentUser.ID)
                        </span>
                    }
                </div>
                <h1 class="h3 mb-1 fw-bold text-white">Corporate Management Dashboard</h1>
                <p class="text-white-50 mb-0 extra-small">
                    Interactive enterprise dashboard with daily schedule, leave calendar, and day information.
                </p>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                @if (dbStatus?.IsConnected == true)
                {
                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6 rounded-pill shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Connected
                    </span>
                }
                else if (isLoading)
                {
                    <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-2 fs-6 rounded-pill shadow-sm">
                        <i class="bi bi-arrow-repeat spin me-1"></i> Connecting...
                    </span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 fs-6 rounded-pill shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Disconnected
                    </span>
                }
                <button class="btn btn-outline-light btn-sm px-3 shadow-sm" @onclick="RefreshDataAsync" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise me-1 @(isLoading ? "spin" : "")"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccessMessage ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi @(isSuccessMessage ? "bi-check-circle" : "bi-exclamation-octagon") me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick='() => statusMessage = null'></button>
        </div>
    }

    <!-- 1. Quick Module Portals Grid (matching HRsuite Default.aspx) -->
    <div class="row g-2 g-sm-3 mb-4">
        <!-- Leave Portal -->
        <div class="col-6 col-md-4 col-xl-2">
            <a href="leaves" class="text-decoration-none">
                <div class="card module-tile border-0 shadow-sm h-100 p-2.5 text-center" style="background: linear-gradient(135deg, #166534 0%, #15803d 100%); color: white;">
                    <div class="module-icon mb-1"><i class="bi bi-calendar2-check-fill fs-4"></i></div>
                    <div class="module-title fw-bold extra-small text-white">e@Leave</div>
                    <div class="extra-small text-white-50">Portal &amp; Apply</div>
                </div>
            </a>
        </div>

        <!-- Leave Supervisor -->
        <div class="col-6 col-md-4 col-xl-2">
            <a href="leaves/approval" class="text-decoration-none">
                <div class="card module-tile border-0 shadow-sm h-100 p-2.5 text-center position-relative" style="background: linear-gradient(135deg, #991b1b 0%, #b91c1c 100%); color: white;">
                    @if (PendingLeavesCount > 0)
                    {
                        <span class="position-absolute top-0 end-0 translate-middle badge rounded-pill bg-warning text-dark border border-white extra-small" style="font-size: 0.7rem; z-index: 2;">
                            @PendingLeavesCount
                        </span>
                    }
                    <div class="module-icon mb-1"><i class="bi bi-person-check-fill fs-4"></i></div>
                    <div class="module-title fw-bold extra-small text-white">Supervisor</div>
                    <div class="extra-small text-white-50">Approve &amp; Cancel</div>
                </div>
            </a>
        </div>

        <!-- Staff Management -->
        <div class="col-6 col-md-4 col-xl-2">
            <a href="staff" class="text-decoration-none">
                <div class="card module-tile border-0 shadow-sm h-100 p-2.5 text-center" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color: white;">
                    <div class="module-icon mb-1"><i class="bi bi-people-fill fs-4"></i></div>
                    <div class="module-title fw-bold extra-small text-white">e@Staff</div>
                    <div class="extra-small text-white-50">Staff Directory</div>
                </div>
            </a>
        </div>

        <!-- Overtime -->
        <div class="col-6 col-md-4 col-xl-2">
            <a href="overtime" class="text-decoration-none">
                <div class="card module-tile border-0 shadow-sm h-100 p-2.5 text-center" style="background: linear-gradient(135deg, #c2410c 0%, #ea580c 100%); color: white;">
                    <div class="module-icon mb-1"><i class="bi bi-clock-history fs-4"></i></div>
                    <div class="module-title fw-bold extra-small text-white">e@OT</div>
                    <div class="extra-small text-white-50">Overtime Activity</div>
                </div>
            </a>
        </div>

        <!-- Admin & Setup -->
        <div class="col-6 col-md-4 col-xl-2">
            <a href="admin" class="text-decoration-none">
                <div class="card module-tile border-0 shadow-sm h-100 p-2.5 text-center" style="background: linear-gradient(135deg, #475569 0%, #334155 100%); color: white;">
                    <div class="module-icon mb-1"><i class="bi bi-gear-wide-connected fs-4"></i></div>
                    <div class="module-title fw-bold extra-small text-white">Admin</div>
                    <div class="extra-small text-white-50">Setup &amp; Config</div>
                </div>
            </a>
        </div>

        <!-- User Profile & Account -->
        <div class="col-6 col-md-4 col-xl-2">
            <a href="user" class="text-decoration-none">
                <div class="card module-tile border-0 shadow-sm h-100 p-2.5 text-center" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: white;">
                    <div class="module-icon mb-1"><i class="bi bi-person-circle fs-4"></i></div>
                    <div class="module-title fw-bold extra-small text-white">User</div>
                    <div class="extra-small text-white-50">Profile &amp; Logout</div>
                </div>
            </a>
        </div>
    </div>

    <!-- 2. Interactive Calendar & Day Information (Refer to Default.aspx, LeaveCalendar.razor & LeaveApproval grid) -->
    <div class="row g-3 mb-4 align-items-stretch">
        <!-- Left: Interactive Monthly Calendar Grid -->
        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white h-100">
                <!-- Calendar Month Header Bar -->
                <div class="card-header py-2.5 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2 text-white" 
                     style="background-color: #688636 !important;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar3"></i>
                        <h6 class="mb-0 fw-bold">Leave Calendar Schedule - @displayMonth.ToString("MMMM yyyy")</h6>
                    </div>
                    <!-- Month Navigation Controls -->
                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="btn btn-sm btn-light py-0.5 px-2 extra-small fw-semibold shadow-sm" @onclick="PrevMonth" title="Previous Month">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-light py-0.5 px-2 extra-small fw-semibold shadow-sm" @onclick="TodayMonth" title="Go to Current / Sample Month">
                            Today
                        </button>
                        <button type="button" class="btn btn-sm btn-light py-0.5 px-2 extra-small fw-semibold shadow-sm" @onclick="NextMonth" title="Next Month">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <div class="card-body p-2 p-sm-3 d-flex flex-column">
                    <!-- Quick Legend & Instruction -->
                    <div class="d-flex align-items-center gap-1.5 flex-wrap mb-2 extra-small">
                        <span class="badge bg-success text-white">AL: Annual</span>
                        <span class="badge bg-warning text-dark">MC: Medical</span>
                        <span class="badge bg-info text-dark">HL: Hospital</span>
                        <span class="badge bg-danger text-white">EL: Emergency</span>
                        <span class="text-muted ms-auto fst-italic d-none d-sm-inline">
                            <i class="bi bi-hand-index-thumb me-1"></i>Click date to view Day Information
                        </span>
                    </div>

                    <!-- 7-column Calendar Table -->
                    <div class="dashboard-calendar-grid flex-grow-1">
                        <div class="calendar-day-header text-danger">Sun</div>
                        <div class="calendar-day-header">Mon</div>
                        <div class="calendar-day-header">Tue</div>
                        <div class="calendar-day-header">Wed</div>
                        <div class="calendar-day-header">Thu</div>
                        <div class="calendar-day-header">Fri</div>
                        <div class="calendar-day-header text-primary">Sat</div>

                        <!-- Empty slots before 1st of month -->
                        @for (int empty = 0; empty < StartDayOfWeek; empty++)
                        {
                            <div class="calendar-cell empty-cell"></div>
                        }

                        <!-- Month Days -->
                        @for (int day = 1; day <= DaysInMonth; day++)
                        {
                            var cellDate = new DateTime(displayMonth.Year, displayMonth.Month, day);
                            var isToday = cellDate.Date == DateTime.Today;
                            var isSelected = cellDate.Date == selectedDate.Date;
                            var dayEvents = GetLeavesForDay(cellDate);

                            <div class="calendar-cell @(isToday ? "today" : "") @(isSelected ? "selected-day" : "")" 
                                 @onclick="() => SelectDate(cellDate)" 
                                 title="Click to view day information for @cellDate.ToString("yyyy-MM-dd")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="calendar-date-no @(cellDate.DayOfWeek == DayOfWeek.Sunday ? "text-danger" : cellDate.DayOfWeek == DayOfWeek.Saturday ? "text-primary" : "")">
                                        @day
                                    </span>
                                    @if (isToday)
                                    {
                                        <span class="badge bg-primary text-white" style="font-size: 0.5rem; padding: 1px 2px;">TODAY</span>
                                    }
                                </div>

                                <div class="calendar-events-container mt-1">
                                    @foreach (var ev in dayEvents.Take(2))
                                    {
                                        <div class="calendar-event-tag @ev.CssClass" title="@ev.Tooltip">
                                            @ev.Label
                                        </div>
                                    }
                                    @if (dayEvents.Count > 2)
                                    {
                                        <span class="badge bg-secondary-subtle text-dark" style="font-size: 0.55rem; padding: 1px 2px;">
                                            +@(dayEvents.Count - 2) more
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="pt-2 mt-2 border-top text-center">
                        <a href="leaves/calendar" class="text-primary extra-small text-decoration-none fw-semibold">
                            <i class="bi bi-calendar-range me-1"></i>Open Full Leave Calendar Schedule &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Day Information - Leave Record Grid (Exact match to LeaveApproval grid) -->
        <div class="col-12 col-xl-7">
            <fieldset class="legacy-fieldset h-100 d-flex flex-column">
                <legend class="legacy-legend">Leave Record</legend>

                <!-- Action Buttons Toolbar (Exact Match to LeaveApproval.razor) -->
                <div class="legacy-toolbar">
                    <button type="button" class="legacy-btn @(showFilters ? "btn-highlight" : "")" @onclick="() => showFilters = !showFilters">
                        <i class="bi bi-funnel me-1"></i>Filter Leave Record
                    </button>
                    <button type="button" class="legacy-btn" @onclick="RefreshDataAsync">
                        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                    </button>
                    <button type="button" class="legacy-btn" @onclick="OpenDetailModal" disabled="@(selectedRecord == null)">
                        <i class="bi bi-card-text me-1"></i>Show Leave Detail
                    </button>
                    <button type="button" class="legacy-btn" @onclick='() => ExportToCsv(false)'>
                        <i class="bi bi-file-earmark-excel text-success me-1"></i>Export Excel(xls)..
                    </button>
                    <button type="button" class="legacy-btn" @onclick='() => ExportToCsv(true)'>
                        <i class="bi bi-file-earmark-excel text-success me-1"></i>Export Excel(xlsx)..
                    </button>
                    <button type="button" class="legacy-btn" @onclick="ExportToPdf">
                        <i class="bi bi-file-earmark-pdf text-danger me-1"></i>Export PDF..
                    </button>

                    <div class="ms-auto d-flex align-items-center gap-1 extra-small">
                        <span class="badge @(isDateFiltered ? "bg-primary" : "bg-secondary") text-white" style="font-size: 0.7rem;">
                            @(isDateFiltered ? $"Day: {selectedDate:dd MMM yyyy}" : "All Month")
                        </span>
                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 extra-small" @onclick="ToggleDateFilter" style="font-size: 0.68rem;">
                            @(isDateFiltered ? "Show All Month" : "Filter Day")
                        </button>
                    </div>
                </div>

                <!-- 20-Column Olive Green Grid Scroll & Table -->
                <div class="legacy-grid-scroll flex-grow-1">
                    <table class="legacy-grid-table">
                        <thead>
                            <!-- Header Row 1: Column Titles -->
                            <tr class="header-row">
                                <th class="col-num">#</th>
                                <th class="col-chk">
                                    <input type="checkbox" checked="@isAllSelected" @onchange="ToggleSelectAll" title="Select / Unselect All" />
                                </th>
                                <th class="col-file">File1</th>
                                <th class="col-file">File2</th>
                                <th class="col-file">File3</th>
                                <th class="col-id">ID</th>
                                <th class="col-name">NAME</th>
                                <th class="col-date">Date From</th>
                                <th class="col-date">Date To</th>
                                <th class="col-leaveid">Leave ID</th>
                                <th class="col-day">Leave Day</th>
                                <th class="col-time">Time In</th>
                                <th class="col-s">s1</th>
                                <th class="col-time">Time Out</th>
                                <th class="col-s">s2</th>
                                <th class="col-status">Status</th>
                                <th class="col-dept">Dept</th>
                                <th class="col-sec">Section</th>
                                <th class="col-shift">Shift Grp</th>
                                <th class="col-type">Type</th>
                            </tr>

                            <!-- Header Row 2: Inline Column Filters (Toggleable) -->
                            @if (showFilters)
                            {
                                <tr class="filter-row">
                                    <td class="col-num"></td>
                                    <td class="col-chk"></td>
                                    <td class="col-file"></td>
                                    <td class="col-file"></td>
                                    <td class="col-file"></td>
                                    <td class="col-id">
                                        <input type="text" class="filter-input" @bind="filterEmpId" @bind:event="oninput" placeholder="ID" />
                                    </td>
                                    <td class="col-name">
                                        <input type="text" class="filter-input" @bind="filterName" @bind:event="oninput" placeholder="Name" />
                                    </td>
                                    <td class="col-date">
                                        <input type="text" class="filter-input" @bind="filterDateFrom" @bind:event="oninput" placeholder="From" />
                                    </td>
                                    <td class="col-date">
                                        <input type="text" class="filter-input" @bind="filterDateTo" @bind:event="oninput" placeholder="To" />
                                    </td>
                                    <td class="col-leaveid">
                                        <input type="text" class="filter-input" @bind="filterLeaveId" @bind:event="oninput" placeholder="Type" />
                                    </td>
                                    <td class="col-day">
                                        <input type="text" class="filter-input" @bind="filterDays" @bind:event="oninput" placeholder="Days" />
                                    </td>
                                    <td class="col-time">
                                        <input type="text" class="filter-input" @bind="filterTimeIn" @bind:event="oninput" placeholder="In" />
                                    </td>
                                    <td class="col-s">
                                        <input type="text" class="filter-input" @bind="filterS1" @bind:event="oninput" />
                                    </td>
                                    <td class="col-time">
                                        <input type="text" class="filter-input" @bind="filterTimeOut" @bind:event="oninput" placeholder="Out" />
                                    </td>
                                    <td class="col-s">
                                        <input type="text" class="filter-input" @bind="filterS2" @bind:event="oninput" />
                                    </td>
                                    <td class="col-status">
                                        <input type="text" class="filter-input" @bind="filterStatusCol" @bind:event="oninput" placeholder="Status" />
                                    </td>
                                    <td class="col-dept">
                                        <input type="text" class="filter-input" @bind="filterDept" @bind:event="oninput" placeholder="Dept" />
                                    </td>
                                    <td class="col-sec">
                                        <input type="text" class="filter-input" @bind="filterSection" @bind:event="oninput" placeholder="Sec" />
                                    </td>
                                    <td class="col-shift">
                                        <input type="text" class="filter-input" @bind="filterShiftGrp" @bind:event="oninput" placeholder="Shift" />
                                    </td>
                                    <td class="col-type">
                                        <input type="text" class="filter-input" @bind="filterType" @bind:event="oninput" placeholder="Type" />
                                    </td>
                                </tr>
                            }
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="20" class="text-center py-4 text-muted">
                                        <div class="spinner-border spinner-border-sm text-secondary mb-1"></div>
                                        <div style="font-size: 0.75rem;">Loading leave records from database...</div>
                                    </td>
                                </tr>
                            }
                            else if (FilteredGridLeaves.Count == 0)
                            {
                                <tr class="empty-row">
                                    <td colspan="20" class="empty-cell">
                                        No data to display
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int rowIdx = 1;
                                @foreach (var r in FilteredGridLeaves)
                                {
                                    var isSelected = selectedRecord == r || selectedLeaveNos.Contains(r.LeaveNo);
                                    <tr class="data-row @(isSelected ? "selected-row" : "")" 
                                        @onclick="() => SelectRecord(r)" 
                                        @ondblclick="() => OpenDetailFor(r)">
                                        <td class="col-num">@(rowIdx++)</td>
                                        <td class="col-chk" @onclick:stopPropagation="true">
                                            <input type="checkbox" checked="@selectedLeaveNos.Contains(r.LeaveNo)" 
                                                   @onchange="(e) => ToggleRowSelected(r.LeaveNo, e)" />
                                        </td>
                                        <td class="col-file">
                                            @if (!string.IsNullOrEmpty(r.File1)) { <i class="bi bi-paperclip text-primary" title="File 1 Attached"></i> }
                                        </td>
                                        <td class="col-file">
                                            @if (!string.IsNullOrEmpty(r.File2)) { <i class="bi bi-paperclip text-primary" title="File 2 Attached"></i> }
                                        </td>
                                        <td class="col-file">
                                            @if (!string.IsNullOrEmpty(r.File3)) { <i class="bi bi-paperclip text-primary" title="File 3 Attached"></i> }
                                        </td>
                                        <td class="col-id font-monospace fw-bold">@r.Emp_ID</td>
                                        <td class="col-name fw-semibold">@r.EmpName</td>
                                        <td class="col-date">@r.Leave_Date_From.ToString("yyyy-MM-dd")</td>
                                        <td class="col-date">@r.Leave_Date_To.ToString("yyyy-MM-dd")</td>
                                        <td class="col-leaveid fw-bold">@r.Leave_Type</td>
                                        <td class="col-day">@r.TotalDays</td>
                                        <td class="col-time">@(string.IsNullOrEmpty(r.TimeIn) ? "08:00" : r.TimeIn)</td>
                                        <td class="col-s">@(string.IsNullOrEmpty(r.s1) ? "-" : r.s1)</td>
                                        <td class="col-time">@(string.IsNullOrEmpty(r.TimeOut) ? "17:00" : r.TimeOut)</td>
                                        <td class="col-s">@(string.IsNullOrEmpty(r.s2) ? "-" : r.s2)</td>
                                        <td class="col-status">
                                            <span class="status-tag @GetStatusClass(r.Leave_Status)">
                                                @r.Leave_Status
                                            </span>
                                        </td>
                                        <td class="col-dept">@(string.IsNullOrEmpty(r.Dept) ? "-" : r.Dept)</td>
                                        <td class="col-sec">@(string.IsNullOrEmpty(r.Section) ? "-" : r.Section)</td>
                                        <td class="col-shift">@(string.IsNullOrEmpty(r.ShiftGrp) ? "-" : r.ShiftGrp)</td>
                                        <td class="col-type">@(string.IsNullOrEmpty(r.Type) ? "Full Day" : r.Type)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer matching user screenshot: Total Records on Left, eLeave - Supervisor Module on Right -->
                <div class="d-flex justify-content-between align-items-center mt-1 px-1 extra-small text-muted">
                    <span>Total Records: <strong>@FilteredGridLeaves.Count</strong> (Selected: <strong>@selectedLeaveNos.Count</strong>)</span>
                    <span class="fst-italic">eLeave - Supervisor Module</span>
                </div>
            </fieldset>
        </div>
    </div>

    <!-- Detail Modal -->
    @if (detailModalRecord != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content shadow border-0">
                    <div class="modal-header py-2 text-white" style="background-color: #688636;">
                        <h6 class="modal-title fw-bold">
                            <i class="bi bi-card-text me-1"></i>Leave Application Detail: @detailModalRecord.LeaveNo
                        </h6>
                        <button type="button" class="btn-close btn-close-white py-0" @onclick="() => detailModalRecord = null"></button>
                    </div>
                    <div class="modal-body p-3 extra-small">
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Leave No:</label>
                                <div><code>@detailModalRecord.LeaveNo</code></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Employee ID:</label>
                                <div><strong>@detailModalRecord.Emp_ID</strong></div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="text-muted fw-bold">Employee Name:</label>
                                <div><strong>@detailModalRecord.EmpName</strong></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Leave Code:</label>
                                <div><span class="badge bg-primary">@detailModalRecord.Leave_Type</span></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Total Days:</label>
                                <div><strong>@detailModalRecord.TotalDays</strong> day(s)</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Date From:</label>
                                <div>@detailModalRecord.Leave_Date_From.ToString("yyyy-MM-dd")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Date To:</label>
                                <div>@detailModalRecord.Leave_Date_To.ToString("yyyy-MM-dd")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Day Type:</label>
                                <div>@detailModalRecord.Type</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Time Range:</label>
                                <div>@detailModalRecord.TimeIn - @detailModalRecord.TimeOut</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Status:</label>
                                <div><strong>@detailModalRecord.Leave_Status</strong></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="text-muted fw-bold">Approval Level:</label>
                                <div>@(string.IsNullOrEmpty(detailModalRecord.AppLevel) ? "Level 1" : detailModalRecord.AppLevel)</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted fw-bold">Leave Reason / Justification:</label>
                            <div class="p-2 border rounded bg-light" style="min-height: 48px;">
                                @(string.IsNullOrWhiteSpace(detailModalRecord.Leave_Reason) ? "No reason specified." : detailModalRecord.Leave_Reason)
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(detailModalRecord.File1) || !string.IsNullOrEmpty(detailModalRecord.File2))
                        {
                            <div class="mb-3">
                                <label class="text-muted fw-bold">Attachments:</label>
                                <div class="d-flex gap-2">
                                    @if (!string.IsNullOrEmpty(detailModalRecord.File1))
                                    {
                                        <a href="@detailModalRecord.File1" target="_blank" class="btn btn-sm btn-outline-primary extra-small">
                                            <i class="bi bi-paperclip me-1"></i>Attachment 1
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(detailModalRecord.File2))
                                    {
                                        <a href="@detailModalRecord.File2" target="_blank" class="btn btn-sm btn-outline-primary extra-small">
                                            <i class="bi bi-paperclip me-1"></i>Attachment 2
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer py-1 px-3 d-flex justify-content-between">
                        <a href="leaves/approval" class="btn btn-sm btn-outline-primary extra-small">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Open in Leave Supervisor
                        </a>
                        <button type="button" class="btn btn-sm btn-secondary extra-small px-3" @onclick="() => detailModalRecord = null">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


