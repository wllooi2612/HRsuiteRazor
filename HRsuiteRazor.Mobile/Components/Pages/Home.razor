            if (!string.IsNullOrWhiteSpace(filterSection))
                q = q.Where(l => l.Section?.Contains(filterSection, StringComparison.OrdinalIgnoreCase) ?? false);
            if (!string.IsNullOrWhiteSpace(filterShiftGrp))
                q = q.Where(l => l.ShiftGrp?.Contains(filterShiftGrp, StringComparison.OrdinalIgnoreCase) ?? false);
            if (!string.IsNullOrWhiteSpace(filterType))
                q = q.Where(l => l.Type?.Contains(filterType, StringComparison.OrdinalIgnoreCase) ?? false);

            return q.ToList();
        }
    }

