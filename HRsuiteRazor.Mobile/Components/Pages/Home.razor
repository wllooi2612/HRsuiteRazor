            }

            IEnumerable<LeaveRequest> q = all;

            // 1. Date filter: if active, show selected day only. If not active, show current display month.
            if (isDateFiltered)
            {
                q = q.Where(l => selectedDate.Date >= l.Leave_Date_From.Date && selectedDate.Date <= l.Leave_Date_To.Date);
            }
            else
            {
                q = q.Where(l => (l.Leave_Date_From.Year == displayMonth.Year && l.Leave_Date_From.Month == displayMonth.Month) ||
                                 (l.Leave_Date_To.Year == displayMonth.Year && l.Leave_Date_To.Month == displayMonth.Month) ||
                                 (l.Leave_Status == "PENDING")); // include pending if in sample set
            }

            // 2. Inline column filters
            if (!string.IsNullOrWhiteSpace(filterEmpId))
                q = q.Where(l => l.Emp_ID?.Contains(filterEmpId, StringComparison.OrdinalIgnoreCase) ?? false);
