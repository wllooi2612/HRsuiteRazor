        {
            selectedLeaveNos.Add(leaveNo);
        }
        else
        {
            selectedLeaveNos.Remove(leaveNo);
        }
    }

    private string GetStatusClass(string? status)
    {
        return (status?.ToUpperInvariant() ?? "") switch
        {
            "APPROVE" or "APPROVED" => "status-approved",
            "REJECT" or "REJECTED" => "status-rejected",
            "CANCEL" or "CANCELLED" => "status-cancelled",
            _ => "status-pending"
        };
    }

    private async Task ExportToCsv(bool xlsx)
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("No,ID,NAME,Date From,Date To,Leave ID,Leave Day,Time In,s1,Time Out,s2,Status,Dept,Section,Shift Grp,Type");
            int idx = 1;
            foreach (var r in FilteredGridLeaves)
            {
                sb.AppendLine($"{idx},\"{r.Emp_ID}\",\"{r.EmpName}\",{r.Leave_Date_From:yyyy-MM-dd},{r.Leave_Date_To:yyyy-MM-dd},\"{r.Leave_Type}\",{r.TotalDays},\"{r.TimeIn}\",\"{r.s1}\",\"{r.TimeOut}\",\"{r.s2}\",\"{r.Leave_Status}\",\"{r.Dept}\",\"{r.Section}\",\"{r.ShiftGrp}\",\"{r.Type}\"");
                idx++;
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            string filename = xlsx ? "LeaveRecordList.xlsx" : "LeaveRecordList.xls";

            await JS.InvokeVoidAsync("eval", $@"
                var a = document.createElement('a');
                a.href = 'data:application/vnd.ms-excel;base64,{base64}';
                a.download = '{filename}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            ");
        }
        catch (Exception ex)
        {
            statusMessage = $"Export failed: {ex.Message}";
            isSuccessMessage = false;
        }
    }

    private async Task ExportToPdf()
    {
        try
        {
            await JS.InvokeVoidAsync("print");
        }
        catch
        {
            statusMessage = "PDF export ready via browser Print Dialog (Ctrl+P).";
            isSuccessMessage = true;
        }
    }
}
