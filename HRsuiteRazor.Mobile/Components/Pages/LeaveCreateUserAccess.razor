    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
        // Load default master lists
        await LoadAccessDataAsync(selectedUserId);
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            usersList = await ApiClient.GetLeaveAccessUsersAsync();
            if (usersList.Any() && string.IsNullOrEmpty(selectedUserId))
            {
                selectedUserId = usersList.First().EmpId;
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Failed to load user list: " + ex.Message;
            isSuccess = false;
        }
    }

    private async Task OnUserChangedAsync(ChangeEventArgs e)
    {
        selectedUserId = e.Value?.ToString() ?? "";
        await LoadAccessDataAsync(selectedUserId);
    }

    private async Task RefreshUserAccessAsync()
    {
        await LoadAccessDataAsync(selectedUserId);
        statusMessage = "Access permissions refreshed successfully.";
        isSuccess = true;
    }

    private async Task LoadAccessDataAsync(string userId)
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            var res = await ApiClient.GetLeaveUserAccessAsync(userId);
            if (res != null)
            {
                accessData = res;
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Error loading user access data: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        searchText = string.Empty;
    }

    private void OnTabDropdownChanged(ChangeEventArgs e)
    {
        var tab = e.Value?.ToString();
        if (!string.IsNullOrEmpty(tab))
        {
            SetActiveTab(tab);
        }
    }

    private List<LeaveUserAccessItem> GetCurrentTabList() => activeTab switch
    {
        "dept" => accessData.Departments,
        "sec" => accessData.Sections,
        "cat" => accessData.Categories,
        "grade" => accessData.Grades,
        "sup" => accessData.Supervisors,
        "job" => accessData.JobTitles,
        "factory" => accessData.Factories,
        "grp" => accessData.Groups,
        "email" => accessData.Emails,
        _ => accessData.Departments
    };

    private IEnumerable<LeaveUserAccessItem> FilteredItems
    {
        get
        {
            var list = GetCurrentTabList();
            if (string.IsNullOrWhiteSpace(searchText))
            {
                return list;
            }

            var q = searchText.Trim();
            return list.Where(x => 
                (x.Id?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Remark?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Extra?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private int GetSelectedCount(List<LeaveUserAccessItem> list) => list.Count(x => x.IsSelected);

    private bool IsAllActiveSelected
    {
        get
        {
            var items = FilteredItems.ToList();
            return items.Any() && items.All(x => x.IsSelected);
        }
    }

    private void ToggleItem(LeaveUserAccessItem item)
    {
        item.IsSelected = !item.IsSelected;
    }

    private void SelectAllInActiveTab()
    {
        foreach (var item in FilteredItems)
        {
            item.IsSelected = true;
        }
    }

    private void UnselectAllInActiveTab()
    {
        foreach (var item in FilteredItems)
        {
            item.IsSelected = false;
        }
    }

    private void ToggleSelectAllOnPage(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        foreach (var item in FilteredItems)
        {
            item.IsSelected = isChecked;
        }
    }

    private async Task SaveUserAccessAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedUserId))
        {
            statusMessage = "Please select a user before saving.";
            isSuccess = false;
            return;
        }

        isSaving = true;
        statusMessage = null;

        try
        {
            var req = new SaveLeaveUserAccessRequest
            {
                UserId = selectedUserId,
                SelectedItems = new List<SelectedAccessItem>()
            };

            void AppendSelected(List<LeaveUserAccessItem> list)
            {
                foreach (var item in list.Where(x => x.IsSelected))
                {
                    req.SelectedItems.Add(new SelectedAccessItem
                    {
                        FormId = item.FormId,
                        Id = item.Id,
                        Remarks = item.Remark
                    });
                }
            }

            AppendSelected(accessData.Departments);
            AppendSelected(accessData.Sections);
            AppendSelected(accessData.Categories);
            AppendSelected(accessData.Grades);
            AppendSelected(accessData.Supervisors);
            AppendSelected(accessData.JobTitles);
            AppendSelected(accessData.Factories);
            AppendSelected(accessData.Groups);
            AppendSelected(accessData.Emails);

            var (ok, msg) = await ApiClient.SaveLeaveUserAccessAsync(req);
            isSuccess = ok;
            statusMessage = ok ? $"Successfully updated Leave access for user '{selectedUserId}' ({req.SelectedItems.Count} items assigned)." : msg;
        }
        catch (Exception ex)
        {
            statusMessage = "Save operation failed: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }
}
