@page "/login"
@page "/login.aspx"
@page "/eLeave/login.aspx"
@inject HrApiClient ApiClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Login - HRsuite</PageTitle>

<div class="login-page-container py-4 px-3">
    <div class="login-card card border-0 shadow rounded-4 mx-auto overflow-hidden">
        <!-- Brand Header -->
        <div class="login-header text-center text-white py-4 px-3">
            <div class="login-logo-circle bg-white text-primary rounded-circle mx-auto mb-2 shadow-sm d-flex align-items-center justify-content-center">
                <i class="bi bi-building-fill-gear fs-2 text-primary"></i>
            </div>
            <h4 class="fw-bold mb-1 text-white">Myhrsuite</h4>
            <p class="text-white-50 extra-small mb-0">Human Resource Management Suite</p>
        </div>

        <div class="card-body p-4 p-md-4">
            <div class="mb-3 text-center">
                <h6 class="fw-bold text-dark mb-1">Corporate Sign In</h6>
                <p class="text-muted extra-small">Please enter your user credentials to access HRsuite</p>
            </div>

            <!-- Error Notification -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 small rounded-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-6 flex-shrink-0"></i>
                    <div>@errorMessage</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 mb-3 small rounded-3" role="alert">
                    <i class="bi bi-check-circle-fill fs-6 flex-shrink-0"></i>
                    <div>@successMessage</div>
                </div>
            }

            <form @onsubmit="HandleLoginSubmit">
                <!-- User ID -->
                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary mb-1">User ID / Login Name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-person"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="e.g. Admin or 00018" @bind="username" required autofocus autocomplete="username" />
                    </div>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-bold text-secondary mb-0">Password <span class="text-danger">*</span></label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input type="@(showPassword ? "text" : "password")" class="form-control border-start-0 border-end-0 ps-0" placeholder="Enter your password" @bind="password" required autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary border-start-0" @onclick='() => showPassword = !showPassword' title="Toggle password visibility">
                            <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <!-- Sign In Button -->
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm rounded-3 mt-4" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Verifying credentials...</span>
                    }
                    else
                    {
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Sign In</span>
                    }
                </button>
            </form>

            <!-- Quick Demo Accounts -->
            <div class="mt-4 pt-3 border-top">
                <div class="extra-small text-muted fw-bold text-uppercase text-center mb-2">Quick Sign-In Accounts</div>
                <div class="d-flex flex-column gap-1.5">
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex align-items-center justify-content-between py-1.5 px-3 extra-small"
                            @onclick='() => SetDemoUser("Admin", "1234")'>
                        <span><i class="bi bi-shield-check text-primary me-1.5"></i><strong>Admin</strong> (System Administrator)</span>
                        <span class="badge bg-secondary-subtle text-dark">1234</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex align-items-center justify-content-between py-1.5 px-3 extra-small"
                            @onclick='() => SetDemoUser("00018", "1234")'>
                        <span><i class="bi bi-person text-success me-1.5"></i><strong>00018</strong> (CHONG WEI CHIN)</span>
                        <span class="badge bg-secondary-subtle text-dark">1234</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex align-items-center justify-content-between py-1.5 px-3 extra-small"
                            @onclick='() => SetDemoUser("00001", "1234")'>
                        <span><i class="bi bi-person text-secondary me-1.5"></i><strong>00001</strong> (TAN HOCK WAN)</span>
                        <span class="badge bg-secondary-subtle text-dark">1234</span>
                    </button>
                </div>
            </div>

            <div class="text-center mt-3 pt-2">
                <a href="" class="text-muted extra-small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Continue to Home Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .login-page-container {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        width: 100%;
        max-width: 440px;
    }

    .login-header {
        background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);
    }

    .login-logo-circle {
        width: 54px;
        height: 54px;
    }

    .extra-small {
        font-size: 0.75rem;
    }
</style>

@code {
    private string username = "";
    private string password = "";
    private bool showPassword = false;
    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private void SetDemoUser(string u, string p)
    {
        username = u;
        password = p;
        errorMessage = null;
    }

    private async Task HandleLoginSubmit()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter both User ID and password.";
            return;
        }

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var (ok, msg, user) = await ApiClient.LoginAsync(username, password);
            if (ok && user != null)
            {
                successMessage = $"Login successful! Welcome, {user.Name}.";
                await Task.Delay(400);

                if (!string.IsNullOrWhiteSpace(ReturnUrl))
                {
                    NavManager.NavigateTo(ReturnUrl);
                }
                else
                {
                    NavManager.NavigateTo("user");
                }
            }
            else
            {
                errorMessage = msg;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
